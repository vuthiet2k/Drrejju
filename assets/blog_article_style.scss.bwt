/* ==========================================================================
   DR.REJU CLINICAL BLOG & KNOWLEDGE MAGAZINE STYLESHEET (V2)
   Design System Parity: Canva Frame 991 & Figma Clinical Magazine Spec
   Warm Luxury Palette: Deep Emerald #0A2E24 + Sand Gold #DFBA73 + Cream #FAF6EF
   ========================================================================== */

:root {
  --dr-emerald: var(--emerald, #0A2E24);
  --dr-emerald-dark: var(--emerald-dk, #06201a);
  --dr-emerald-light: rgba(10, 46, 36, 0.08);
  --dr-emerald-hover: #124336;
  --dr-gold: var(--gold, #DFBA73);
  --dr-gold-light: rgba(223, 186, 115, 0.15);
  --dr-warm-dark: #2B1E16;
  --dr-warm-cream: #FAF6EF;
  --dr-warm-soft: #F1ECE3;
  --dr-text-primary: #17140F;
  --dr-text-muted: #5A4D41;
  --dr-text-light: #8C7355;
  --dr-border: #E7E0D6;
  --dr-surface: #FAF6EF;
  --dr-white: #FFFFFF;
  --dr-font-ui: var(--font-primary, 'Quicksand', sans-serif);
  --dr-font-display: var(--font-serif, 'Playfair Display', Georgia, serif);
}

/* 1. Global Reset & Container */
.dr-blog-page {
  font-family: var(--dr-font-ui);
  color: var(--dr-text-primary);
  background-color: var(--dr-surface);
  line-height: 1.6;
  padding-bottom: 70px;
}
.dr-mag-container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 16px;
}
.dr-mag-section {
  margin-bottom: 48px;
}

/* Common Section Heading */
.dr-mag-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid var(--dr-emerald);
  padding-bottom: 10px;
  margin-bottom: 24px;
}
.dr-mag-heading__title {
  font-family: var(--dr-font-display);
  font-size: 22px;
  font-weight: 700;
  color: var(--dr-warm-dark);
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.dr-mag-heading__sub {
  font-size: 12px;
  color: var(--dr-text-light);
  font-weight: 600;
}

/* 2. Top Magazine 3-Column Grid (Phân khu 1) */
.dr-mag-top-grid {
  display: flex;
  gap: 24px;
  align-items: stretch;
  margin-top: 30px;
}
.dr-mag-col-news {
  flex: 1 1 280px;
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 20px;
}
.dr-mag-col-featured {
  flex: 2 1 540px;
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}
.dr-mag-col-trending {
  flex: 1 1 280px;
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 20px;
}

/* Left Column: News text feed */
.dr-news-feed-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.dr-news-feed-item {
  padding: 12px 0;
  border-bottom: 1px dashed var(--dr-border);
}
.dr-news-feed-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.dr-news-feed-item a {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--dr-warm-dark);
  text-decoration: none;
  line-height: 1.5;
  display: block;
  transition: color 0.2s;
}
.dr-news-feed-item a:hover {
  color: var(--dr-emerald);
}

/* Center Column: Big Featured Spotlight + 3 Subcards */
.dr-spotlight-hero-card {
  margin-bottom: 20px;
}
.dr-spotlight-hero-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 12px;
  overflow: hidden;
  background: #E8EFEA;
  margin-bottom: 14px;
}
.dr-spotlight-hero-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.dr-spotlight-hero-thumb:hover img {
  transform: scale(1.03);
}
.dr-spotlight-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--dr-emerald);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.dr-spotlight-hero-title {
  font-family: var(--dr-font-display);
  font-size: 20px;
  font-weight: 700;
  line-height: 1.35;
  margin: 0 0 8px 0;
}
.dr-spotlight-hero-title a {
  color: var(--dr-warm-dark);
  text-decoration: none;
}
.dr-spotlight-hero-title a:hover {
  color: var(--dr-emerald);
}
.dr-spotlight-hero-meta {
  font-size: 12px;
  color: var(--dr-text-light);
  margin-bottom: 16px;
}

/* 3 Horizontal Subcards */
.dr-mag-subcards-row {
  display: flex;
  gap: 12px;
  margin-top: auto;
}
.dr-mag-subcard {
  flex: 1;
  background: var(--dr-warm-cream);
  border: 1px solid rgba(223, 186, 115, 0.4);
  border-radius: 10px;
  padding: 12px 10px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.2s, background-color 0.2s;
}
.dr-mag-subcard:hover {
  transform: translateY(-2px);
  background: #ffffff;
  border-color: var(--dr-gold);
}
.dr-subcard-tag {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 6px;
  width: fit-content;
}
.dr-tag-retinol { background: #E3EDE8; color: #0A2E24; }
.dr-tag-sun { background: #FCEBD9; color: #A85A1A; }
.dr-tag-peptide { background: #D9EBF0; color: #15627A; }
.dr-subcard-title {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--dr-warm-dark);
  line-height: 1.35;
  margin: 0;
}

/* Right Column: Trending Media List */
.dr-trending-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.dr-trending-item {
  display: flex;
  gap: 12px;
  align-items: center;
  text-decoration: none;
  padding-bottom: 12px;
  border-bottom: 1px dashed var(--dr-border);
}
.dr-trending-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.dr-trending-thumb {
  width: 68px;
  height: 52px;
  border-radius: 6px;
  overflow: hidden;
  background: #E8EFEA;
  flex-shrink: 0;
}
.dr-trending-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dr-trending-title {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--dr-warm-dark);
  line-height: 1.35;
  margin: 0 0 4px 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.dr-trending-date {
  font-size: 11px;
  color: var(--dr-text-light);
}

/* 3. Topic Matrix Grid (Phân khu 2) */
.dr-topic-matrix-section {
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 24px;
}
.dr-topic-matrix-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.dr-topic-box {
  background: var(--dr-warm-cream);
  border: 1px solid rgba(223, 186, 115, 0.3);
  border-radius: 10px;
  padding: 14px 18px;
  transition: all 0.2s;
}
.dr-topic-box:hover {
  background: #ffffff;
  border-color: var(--dr-gold);
  box-shadow: 0 4px 12px rgba(223, 186, 115, 0.15);
}
.dr-topic-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--dr-warm-dark);
  margin: 0 0 4px 0;
}
.dr-topic-author {
  font-size: 11.5px;
  color: var(--dr-text-light);
  margin: 0;
}

/* 4. Arbutin & Product Spotlight (Phân khu 3) */
.dr-spotlight-2col {
  display: flex;
  gap: 24px;
  align-items: stretch;
}
.dr-spotlight-main {
  flex: 3 1 660px;
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 24px;
}
.dr-spotlight-aside {
  flex: 2 1 420px;
  background: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 24px;
}
.dr-arbutin-banner-thumb {
  width: 100%;
  aspect-ratio: 16 / 8;
  border-radius: 12px;
  overflow: hidden;
  background: #E8EFEA;
  margin-bottom: 16px;
}
.dr-arbutin-banner-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dr-spotlight-subthumbs-row {
  display: flex;
  gap: 14px;
  margin-top: 16px;
}
.dr-spotlight-subthumb-item {
  flex: 1;
  display: flex;
  gap: 10px;
  align-items: center;
}
.dr-spotlight-subthumb-img {
  width: 60px;
  height: 50px;
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.dr-spotlight-subthumb-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 5. Video 2x2 Hub & Podcast Waveform (Phân khu 4) */
.dr-media-split-grid {
  display: flex;
  gap: 24px;
  align-items: stretch;
}
.dr-video-2x2-col {
  flex: 3 1 640px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.dr-video-card-item {
  background: #ffffff;
  border: 1px solid var(--dr-border);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.dr-video-thumb-box {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #06201a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  cursor: pointer;
}
.dr-video-thumb-box.bg-terracotta {
  background: #8F4C30;
}
.dr-play-circle-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(223, 186, 115, 0.9);
  color: #0A2E24;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  margin-bottom: 8px;
}
.dr-video-thumb-title {
  font-size: 15px;
  font-weight: 700;
}
.dr-video-card-body {
  padding: 14px 16px;
}
.dr-video-card-title {
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
  margin: 0;
  color: var(--dr-warm-dark);
}

/* Right Media: Quick Guides & Podcast Banner */
.dr-podcast-col {
  flex: 2 1 420px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.dr-quick-guides-card {
  background: #ffffff;
  border: 1px solid var(--dr-border);
  border-radius: 14px;
  padding: 20px;
  flex: 1;
}
.dr-guides-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.dr-guides-item {
  padding: 10px 0;
  border-bottom: 1px dashed var(--dr-border);
  font-size: 13px;
  font-weight: 600;
  color: var(--dr-warm-dark);
  display: flex;
  gap: 8px;
}
.dr-guides-item:last-child {
  border-bottom: none;
}
.dr-podcast-banner-card {
  background: linear-gradient(135deg, #A81E1E 0%, #7A0C0C 50%, #0A2E24 100%);
  border-radius: 14px;
  padding: 18px 20px;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border: 1px solid var(--dr-gold);
}
.dr-podcast-title {
  font-size: 13px;
  font-weight: 700;
  margin: 0 0 4px 0;
}
.dr-podcast-wave {
  display: flex;
  align-items: center;
  gap: 3px;
}
.dr-wave-bar {
  width: 3px;
  background: var(--dr-gold);
  border-radius: 2px;
  animation: pulseWave 1.2s infinite ease-in-out;
}
@keyframes pulseWave {
  0%, 100% { height: 8px; }
  50% { height: 24px; }
}

/* 6. Case Study Spotlight Banner (Phân khu 5) */
.dr-case-study-card {
  background: #ffffff;
  border: 1.5px solid rgba(223, 186, 115, 0.5);
  border-radius: 20px;
  padding: 30px;
  display: flex;
  gap: 36px;
  align-items: center;
  box-shadow: 0 10px 30px rgba(43, 30, 22, 0.05);
}
.dr-case-study-media {
  flex: 1 1 420px;
  aspect-ratio: 4 / 3;
  border-radius: 14px;
  overflow: hidden;
  background: #E8EFEA;
}
.dr-case-study-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dr-case-study-body {
  flex: 1 1 540px;
}
.dr-case-study-badge {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--dr-emerald);
  margin-bottom: 10px;
  display: block;
}
.dr-case-study-title {
  font-family: var(--dr-font-display);
  font-size: 26px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--dr-warm-dark);
  margin: 0 0 14px 0;
}
.dr-case-study-desc {
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--dr-text-muted);
  margin-bottom: 22px;
}
.dr-btn-primary-emerald {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 26px;
  background: var(--dr-emerald);
  color: #ffffff !important;
  font-weight: 700;
  font-size: 13px;
  border-radius: 999px;
  text-decoration: none !important;
  border: 1px solid var(--dr-gold);
  transition: all 0.2s;
}
.dr-btn-primary-emerald:hover {
  background: var(--dr-emerald-dark);
  transform: translateY(-2px);
}

/* 7. 3-Column Latest Articles Grid (Phân khu 6) */
.dr-articles-3col-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.dr-article-grid-card {
  background: #ffffff;
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, box-shadow 0.2s;
}
.dr-article-grid-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(223, 186, 115, 0.2);
  border-color: var(--dr-gold);
}
.dr-grid-card-thumb {
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: 10px;
  overflow: hidden;
  background: var(--dr-warm-cream);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dr-grid-card-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dr-grid-card-title {
  font-family: var(--dr-font-display);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.4;
  margin: 0 0 14px 0;
  min-height: 44px;
}
.dr-grid-card-title a {
  color: var(--dr-warm-dark);
  text-decoration: none;
}
.dr-grid-card-title a:hover {
  color: var(--dr-emerald);
}
.dr-btn-read-sm {
  margin-top: auto;
  align-self: flex-start;
  font-size: 12px;
  font-weight: 700;
  color: var(--dr-emerald);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--dr-emerald-light);
  padding: 6px 14px;
  border-radius: 999px;
  transition: all 0.2s;
}
.dr-btn-read-sm:hover {
  background: var(--dr-emerald);
  color: #ffffff;
}

/* Responsive Media Queries */
@media (max-width: 1024px) {
  .dr-mag-top-grid,
  .dr-spotlight-2col,
  .dr-media-split-grid,
  .dr-case-study-card {
    flex-direction: column;
  }
  .dr-topic-matrix-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .dr-articles-3col-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 767px) {
  .dr-mag-top-grid,
  .dr-topic-matrix-grid,
  .dr-video-2x2-col,
  .dr-articles-3col-grid {
    grid-template-columns: 1fr;
  }
  .dr-mag-subcards-row {
    flex-direction: column;
  }
  .dr-case-study-card {
    padding: 20px;
  }
  .dr-case-study-title {
    font-size: 20px;
  }
}
