/* ==========================================================================
   DR.REJU CLINICAL BLOG & ARTICLE STYLESHEET
   Design System Parity: Figma Node 41:12 (41:13 Desktop, 41:629 Tablet, 41:566 Mobile)
   DTCG Design Tokens: Emerald #0D5C46, #166B55, #073B2C, Surface #F8FAF7
   ========================================================================== */

:root {
  --dr-emerald: #0D5C46;
  --dr-emerald-dark: #073B2C;
  --dr-emerald-light: #E6F4EA;
  --dr-emerald-hover: #166B55;
  --dr-text-primary: #111827;
  --dr-text-muted: #4B5563;
  --dr-text-light: #94A3B8;
  --dr-border: #E5E7EB;
  --dr-surface: #F8FAF7;
  --dr-white: #FFFFFF;
  --dr-alert: #DC2626;
  --dr-alert-bg: #FEE2E2;
  --dr-font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --dr-font-display: 'Be Vietnam Pro', var(--dr-font-ui);
}

/* 1. Global Reset & Utilities */
.dr-blog-page, .dr-article-page {
  font-family: var(--dr-font-ui);
  color: var(--dr-text-primary);
  background-color: var(--dr-surface);
  line-height: 1.6;
}

/* 2. Badges & Micro-components */
.dr-badge-clinical {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--dr-emerald);
  background-color: var(--dr-emerald-light);
  border-radius: 9999px;
  margin-bottom: 12px;
}

.dr-badge-alert {
  display: inline-block;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
  color: var(--dr-alert);
  background-color: var(--dr-alert-bg);
  border-radius: 4px;
}

.dr-badge-emerald {
  display: inline-block;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
  color: var(--dr-emerald);
  background-color: var(--dr-emerald-light);
  border-radius: 4px;
}

.dr-badge-category {
  display: inline-block;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  color: var(--dr-emerald);
  background-color: var(--dr-emerald-light);
  border-radius: 6px;
}

.dr-badge-medical-check {
  display: inline-block;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 600;
  color: #059669;
  background-color: #ECFDF5;
  border-radius: 6px;
}

.dr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
  border: none;
}

.dr-btn--emerald {
  background-color: var(--dr-emerald);
  color: var(--dr-white) !important;
}
.dr-btn--emerald:hover {
  background-color: var(--dr-emerald-hover);
  color: var(--dr-white) !important;
}

.dr-btn--white-emerald {
  background-color: var(--dr-white);
  color: var(--dr-emerald) !important;
  font-weight: 700;
}
.dr-btn--white-emerald:hover {
  background-color: var(--dr-emerald-light);
}

.dr-btn--outline {
  background-color: transparent;
  color: var(--dr-emerald);
  border: 1px solid var(--dr-emerald);
}

.dr-btn--sm {
  padding: 6px 14px;
  font-size: 12px;
}

/* 3. Hero Category Banner */
.dr-blog-hero-banner {
  background: linear-gradient(180deg, var(--dr-emerald-light) 0%, rgba(230, 244, 234, 0.4) 100%);
  padding: 48px 0 32px;
  border-bottom: 1px solid var(--dr-border);
  text-align: center;
}

.dr-blog-hero-banner__title {
  font-family: var(--dr-font-display);
  font-size: 32px;
  font-weight: 800;
  color: var(--dr-emerald-dark);
  margin-bottom: 12px;
  line-height: 1.3;
}

.dr-blog-hero-banner__subtitle {
  max-width: 680px;
  margin: 0 auto 24px;
  font-size: 15px;
  color: var(--dr-text-muted);
}

.dr-blog-pills-list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.dr-blog-pill a {
  display: inline-block;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  color: var(--dr-text-muted);
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 9999px;
  text-decoration: none;
  transition: all 0.2s;
}

.dr-blog-pill.is-active a, .dr-blog-pill a:hover {
  color: var(--dr-white);
  background-color: var(--dr-emerald);
  border-color: var(--dr-emerald);
}

/* 4. Hero Featured Article Spotlight Card (Figma 41:284) */
.dr-featured-spotlight-card {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 36px;
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
}

.dr-featured-spotlight-card__thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background-color: #E2E8F0;
  overflow: hidden;
}

.dr-featured-spotlight-card__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.dr-featured-spotlight-card:hover .dr-featured-spotlight-card__thumb img {
  transform: scale(1.03);
}

.dr-featured-spotlight-card__badges {
  position: absolute;
  top: 16px;
  left: 16px;
  display: flex;
  gap: 8px;
}

.dr-featured-spotlight-card__body {
  padding: 24px;
}

.dr-featured-spotlight-card__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--dr-text-muted);
  margin-bottom: 10px;
}

.dr-featured-spotlight-card__title {
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 12px;
}

.dr-featured-spotlight-card__title a {
  color: var(--dr-text-primary);
  text-decoration: none;
}
.dr-featured-spotlight-card__title a:hover {
  color: var(--dr-emerald);
}

.dr-featured-spotlight-card__excerpt {
  font-size: 14px;
  color: var(--dr-text-muted);
  margin-bottom: 20px;
}

/* 5. Clinical Blog Card Item (Figma 41:299) */
.dr-blog-card {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24px;
  display: flex;
  flex-direction: column;
  height: calc(100% - 24px);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.dr-blog-card:hover {
  box-shadow: 0 10px 15px -3px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}

.dr-blog-card__thumb-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background-color: #E2E8F0;
  overflow: hidden;
}

.dr-blog-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.dr-blog-card:hover .dr-blog-card__img {
  transform: scale(1.04);
}

.dr-blog-card__tags {
  position: absolute;
  bottom: 10px;
  left: 10px;
  display: flex;
  gap: 6px;
}

.dr-blog-card__badge {
  padding: 3px 8px;
  font-size: 10px;
  font-weight: 700;
  color: var(--dr-white);
  background-color: rgba(13, 92, 70, 0.9);
  backdrop-filter: blur(4px);
  border-radius: 4px;
}

.dr-blog-card__content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.dr-blog-card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--dr-text-muted);
  margin-bottom: 8px;
}

.dr-blog-card__title {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8px;
}

.dr-blog-card__title a {
  color: var(--dr-text-primary);
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.dr-blog-card__title a:hover {
  color: var(--dr-emerald);
}

.dr-blog-card__summary {
  font-size: 13px;
  color: var(--dr-text-muted);
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex-grow: 1;
}

.dr-blog-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--dr-border);
  padding-top: 12px;
}

.dr-blog-card__readmore {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  color: var(--dr-emerald);
  text-decoration: none;
}
.dr-blog-card__readmore:hover {
  color: var(--dr-emerald-hover);
}

/* 6. Section Heading Bar */
.dr-section-heading-bar {
  margin-bottom: 24px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--dr-emerald);
}

.dr-section-heading-bar__title {
  font-size: 20px;
  font-weight: 700;
  color: var(--dr-text-primary);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* 7. Clinical Media & Video Hub (Figma 41:326) */
.dr-media-hub-section {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 24px;
  margin: 36px 0;
}

.dr-media-hub-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.dr-media-hub-section__head h3 {
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  color: var(--dr-emerald-dark);
}

.dr-badge-pill {
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  background-color: #FEF3C7;
  color: #D97706;
  border-radius: 9999px;
}

.dr-media-card {
  display: flex;
  gap: 14px;
  padding: 12px;
  background-color: var(--dr-surface);
  border-radius: 10px;
  border: 1px solid var(--dr-border);
  margin-bottom: 12px;
}

.dr-media-card__thumb {
  position: relative;
  width: 110px;
  height: 75px;
  background-color: #0F2318;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dr-media-card__play-btn {
  color: var(--dr-white);
  font-size: 18px;
}

.dr-media-card__duration {
  position: absolute;
  bottom: 4px;
  right: 4px;
  font-size: 9px;
  color: var(--dr-white);
  background: rgba(0,0,0,0.7);
  padding: 1px 4px;
  border-radius: 2px;
}

.dr-media-card__tag {
  font-size: 10px;
  font-weight: 700;
  color: var(--dr-emerald);
  display: block;
  margin-bottom: 4px;
}

.dr-media-card__title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.3;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 8. Consultation Banner (Figma 41:341) */
.dr-consultation-banner {
  background: linear-gradient(135deg, var(--dr-emerald-dark) 0%, var(--dr-emerald) 100%);
  border-radius: 16px;
  padding: 32px;
  color: var(--dr-white);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  margin: 36px 0;
}

.dr-consultation-banner__title {
  font-size: 22px;
  font-weight: 800;
  color: var(--dr-white);
  margin-bottom: 8px;
}

.dr-consultation-banner__desc {
  font-size: 14px;
  color: var(--dr-emerald-light);
  margin: 0;
  max-width: 500px;
}

/* 9. Sidebar Widgets */
.dr-blog-sidebar {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.dr-sidebar-widget {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 14px;
  padding: 20px;
}

.dr-sidebar-widget__title {
  font-size: 15px;
  font-weight: 700;
  color: var(--dr-text-primary);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--dr-border);
}

.dr-sidebar-search-form__wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.dr-sidebar-search-form__input {
  width: 100%;
  height: 44px;
  padding: 10px 44px 10px 14px;
  font-size: 13px;
  border: 1px solid var(--dr-border);
  border-radius: 8px;
  background-color: var(--dr-surface);
  outline: none;
}
.dr-sidebar-search-form__input:focus {
  border-color: var(--dr-emerald);
}

.dr-sidebar-search-form__submit {
  position: absolute;
  right: 6px;
  width: 32px;
  height: 32px;
  background-color: var(--dr-emerald);
  color: var(--dr-white);
  border: none;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

/* Doctor Consultation Sidebar Card */
.dr-doctor-cta-card {
  background: linear-gradient(145deg, var(--dr-emerald) 0%, var(--dr-emerald-dark) 100%);
  border-radius: 12px;
  padding: 20px;
  color: var(--dr-white);
  text-align: center;
}

.dr-doctor-cta-card__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 8px;
  background: rgba(255,255,255,0.15);
  border-radius: 9999px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.dr-dot-pulse {
  width: 6px;
  height: 6px;
  background-color: #34D399;
  border-radius: 50%;
}

.dr-doctor-cta-card__title {
  font-size: 16px;
  font-weight: 700;
  color: var(--dr-white);
  margin-bottom: 8px;
  line-height: 1.3;
}

.dr-doctor-cta-card__desc {
  font-size: 12px;
  color: var(--dr-emerald-light);
  margin-bottom: 16px;
  line-height: 1.5;
}

.dr-doctor-cta-card__btn {
  width: 100%;
}

.dr-doctor-cta-card__meta {
  margin-top: 10px;
  font-size: 11px;
  color: rgba(255,255,255,0.7);
}

/* Sidebar Articles List */
.dr-sidebar-article-item {
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
  padding-bottom: 14px;
  border-bottom: 1px dashed var(--dr-border);
}
.dr-sidebar-article-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.dr-sidebar-article-item__thumb {
  width: 72px;
  height: 54px;
  border-radius: 6px;
  overflow: hidden;
  background-color: #E2E8F0;
  flex-shrink: 0;
}
.dr-sidebar-article-item__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.dr-sidebar-article-item__date {
  font-size: 10px;
  color: var(--dr-text-light);
  display: block;
}

.dr-sidebar-article-item__title {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  margin: 2px 0 0;
}
.dr-sidebar-article-item__title a {
  color: var(--dr-text-primary);
  text-decoration: none;
}
.dr-sidebar-article-item__title a:hover {
  color: var(--dr-emerald);
}

/* Tag Cloud */
.dr-tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.dr-tag-pill {
  display: inline-block;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 500;
  color: var(--dr-text-muted);
  background-color: var(--dr-surface);
  border: 1px solid var(--dr-border);
  border-radius: 6px;
  text-decoration: none;
}
.dr-tag-pill:hover, .dr-tag-pill.is-active {
  color: var(--dr-white);
  background-color: var(--dr-emerald);
  border-color: var(--dr-emerald);
}

/* 10. Article Detail Specific Styles (Figma 41:353) */
.dr-article-header {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 32px;
  margin: 24px 0;
}

.dr-article-header__tags {
  display: flex;
  gap: 10px;
  margin-bottom: 14px;
}

.dr-article-header__title {
  font-family: var(--dr-font-display);
  font-size: 28px;
  font-weight: 800;
  color: var(--dr-text-primary);
  line-height: 1.3;
  margin-bottom: 20px;
}

.dr-article-author-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--dr-border);
}

.dr-article-author-bar__profile {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dr-article-author-bar__avatar img {
  border-radius: 50%;
  border: 2px solid var(--dr-emerald);
}

.dr-article-author-bar__name {
  display: block;
  font-size: 14px;
  color: var(--dr-emerald);
}

.dr-article-author-bar__role {
  display: block;
  font-size: 12px;
  color: var(--dr-text-muted);
}

.dr-article-author-bar__info {
  font-size: 13px;
  color: var(--dr-text-muted);
}

/* Sticky TOC */
.dr-sticky-toc {
  position: sticky;
  top: 90px;
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 12px;
  padding: 16px;
}

.dr-sticky-toc__title {
  font-size: 14px;
  font-weight: 700;
  color: var(--dr-text-primary);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.dr-toc-list ul {
  padding-left: 14px;
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
}
.dr-toc-list a {
  color: var(--dr-text-muted);
  text-decoration: none;
  display: block;
  padding: 4px 0;
}
.dr-toc-list a:hover, .dr-toc-list .is-active-link {
  color: var(--dr-emerald);
  font-weight: 700;
}

/* Article Content RTE */
.dr-article-content {
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 16px;
  padding: 32px;
  font-size: 16px;
  line-height: 1.75;
}
.dr-article-content h2 {
  font-size: 22px;
  font-weight: 700;
  color: var(--dr-emerald-dark);
  margin: 32px 0 16px;
}
.dr-article-content h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--dr-text-primary);
  margin: 24px 0 12px;
}
.dr-article-content img {
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  margin: 20px 0;
}

/* Prescription Widget (Right Col) */
.dr-prescription-widget {
  position: sticky;
  top: 90px;
  background-color: var(--dr-white);
  border: 1px solid var(--dr-border);
  border-radius: 14px;
  padding: 20px;
}

.dr-prescription-widget__title {
  font-size: 15px;
  font-weight: 700;
  margin: 8px 0 4px;
}
.dr-prescription-widget__sub {
  font-size: 12px;
  color: var(--dr-text-muted);
  margin-bottom: 14px;
}

.dr-prescription-item {
  display: flex;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid var(--dr-border);
}
.dr-prescription-item__thumb img {
  border-radius: 6px;
}
.dr-prescription-item__name a {
  font-size: 12px;
  font-weight: 600;
  color: var(--dr-text-primary);
  text-decoration: none;
}
.dr-prescription-item__price {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--dr-emerald);
  margin-top: 2px;
}
.dr-btn-quick-buy {
  background: var(--dr-emerald-light);
  color: var(--dr-emerald);
  border: none;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
  cursor: pointer;
  margin-top: 4px;
}

/* Responsive Media Queries */
@media (max-width: 1199px) {
  .dr-blog-hero-banner__title { font-size: 26px; }
  .dr-article-header__title { font-size: 24px; }
}

@media (max-width: 991px) {
  .dr-blog-sidebar-col, .dr-article-sidebar-col {
    margin-top: 36px;
  }
}

@media (max-width: 767px) {
  .dr-blog-hero-banner { padding: 32px 0 20px; }
  .dr-blog-hero-banner__title { font-size: 22px; }
  .dr-featured-spotlight-card__title { font-size: 18px; }
  .dr-article-header { padding: 20px; }
  .dr-article-header__title { font-size: 20px; }
  .dr-article-content { padding: 20px; }
  .dr-consultation-banner { padding: 20px; text-align: center; }
  .dr-consultation-banner__form { width: 100%; }
