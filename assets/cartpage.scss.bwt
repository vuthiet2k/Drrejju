$main-color: {{ settings.main_color }};
$hover: {{ settings.hover_color }};

// trang cart
h1 {
	font-size:22px;
	margin-bottom:20px;
}

.margin-bottom-40{
	margin-bottom: 40px;
}
.cart-mobile-page{
	padding: 10px;
	background: #fff;
	border-radius: 5px;
	margin-bottom: 20px;
}
.cart-page {
	padding: 10px;
	background: #fff;
	border-radius: 5px;
	.cart--empty-message {
		text-align:center;
		svg {
			width: 80px;
			height: 80px;
			margin: 15px;
			path{
				fill: #000;
			}
		}
	}
	.cart-header-info {
		display:flex;
		display: flex;
		padding: 7px 0;
		border: solid 1px #ebebeb;
		border-bottom: none;
		font-weight: bold;
		div {
			&:nth-child(1) {
				width: 51%;
				text-align: left;
				padding-left:10px;
			}
			&:nth-child(2) {
				width:16%;
				text-align: center;
			}
			&:nth-child(3) {
				width:16%;
				text-align: center;
			}
			&:nth-child(4) {
				width:16%;
				text-align: center;
			}
		}
	}
	.cart_body {
		border: solid 1px #ebebeb;
		.ajaxcart__row {
			padding: 10px 0;
			border-top: solid 1px #ebebeb;
			.cart_product  {
				width: 100%;
				height: 120px;
				display: flex;
				align-items: center;
			}
			&:first-child {
				border-top:none;
			}
		}

		.cart_image {
			width:110px;
			height: 110px;
			display: flex;
			align-items: center;
			justify-content: center;
			margin-left: 10px;
			img {
				max-width:100%;
				max-height:100%;
			}
		}
		.cart_info {
			padding-left: 15px;
			vertical-align: top;
			padding-right: 10px;
			display: flex;
			width: calc(100% - 110px);
			-webkit-width: calc(100% - 110px);
			-moz-width: calc(100% - 110px);
			-o-width: calc(100% - 110px);
			-os-width: calc(100% - 110px);
			.cart_name {
				width:50%;
				margin-bottom: 5px;
				a {
					margin-bottom: 4px;
					font-size: 13px;
					font-weight: 700;
					color: #000;
					line-height: 18px;
					display: block;
					&:hover {
						color:$hover;
					}
				}
				.remove-item-cart {
					display: block;
					color: $main-color;

				}
				p {
					margin: 0;
					font-style: italic;
					color: #9e9e9e;
				}
			}
			.variant-title {
				display: block;
				font-size:12px;
			}
		}

		.grid {
			width: 20%;
			display: flex;
			align-items: center;
			justify-content: center;
			.cart_prices {
				.cart-price {
					font-weight: bold;
					display: block;
					font-size: 14px;
					color: $main-color;
				}
			}

			.cart__btn-remove {
				font-size: 13px;
				color: $main-color;
			}
			.cart_quantity {
				font-size: 12px;
				margin-bottom: 5px;
				display: block;
				font-weight: normal;
				color: #333;
			}
		}
		.cart_select {
			display: block;
			width: 100%;
			min-height: 30px;
			font-size: 1em;
			line-height: 1.5;
			color: #55595c;
			background-color: #fff;
			background-image: none;
			margin: 0;
			width: auto;
			float: left;
			position: relative;
			padding: 0;
			border: none;
			box-shadow: none;
			background-color: transparent;
			border: 1px solid $main-color;
			border-radius: 5px;
			padding: 2px;
			button {
				font-size: 20px;
				line-height: 0px;
				border: 0;
				display: inline-block;
				width: 25px;
				height: 25px;
				background: $main-color;
				float: left;
				color: #fff;
				text-align: center;
				padding: 0px;
				border-radius: 5px;

				svg{
					width: 14px;
					height: 14px;
				}
				&:hover{
					background: $hover;
				}

			}
			input{
				padding: 0 2px;
				text-align: center;
				margin: 0px;
				display: block;
				float: left;
				height: 25px;
				border: 0;
				width: 30px;
				text-align: center;
				box-shadow: none;
				border-radius: 8px;
				font-size: 15px;
				background: transparent;
			}
		}


	}
	.ajaxcart__footer {
		margin-top:20px;
		.cart__subtotal {
			font-size: 15px;
			font-weight: 500;
			margin-bottom: 12px;
			display:flex;
			.cart__col-6 {
				width: 50%;
				float: left;
			}
			.cart__totle {
				width: 50%;
				float: left;
				text-align: right;
				.total-price {
					color: $main-color;
					font-weight:bold;
				}
			}
		}
		.cart__btn-proceed-checkout-dt {
			display: block;
			position: relative;
			button {
				width: 100%;
				background-color: $main-color;
				color: #fff;
				text-align: center;
				line-height: 40px;
				border: 1px solid $main-color;
				border-radius: 5px;
				&:hover {
					background-color: $hover;
					border: 1px solid $hover;
				}
			}
		}
	}
}

// header cart
.CartHeaderContainer {
	width: 340px;
	background-color: #fff;
	.cart--empty-message {
		text-align:center;
		svg {
			width: 80px;

			margin: 15px;

		}
	}
}
.cartheader {
	margin-bottom:0;
	.cart_body {
		padding: 15px;
		max-height: 360px;
		overflow-y: auto;
		&::-webkit-scrollbar-track {
			-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
			-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
			border-radius: 5px;
			background-color: #F5F5F5
		}
		&::-webkit-scrollbar {
			width: 5px;
			background-color: #F5F5F5
		}
		&::-webkit-scrollbar-thumb {
			border-radius: 5px;
			-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
			-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
			background-color: #e5e5e5
		}
		.cart_product  {
			margin-bottom: 15px;
			padding-bottom: 15px;
			display: table;
			width: 100%;
			border-bottom: solid 1px #ebebeb;
		}
		.cart_image {
			display: table-cell;
			width: 24%;
			vertical-align: top;
			position: relative;
		}
		.cart_info {
			padding-left: 15px;
			vertical-align: top;
			.cart_name {
				margin-bottom: 5px;
				a {
					margin-bottom: 4px;
					font-size: 13px;
					font-weight: 500;
					line-height:1.3;
					display:block;
					&:hover {
						color:$hover;
					}
				}
			}
			.variant-title {
				display: block;
				font-size:12px;
			}
		}
		.grid {
			display:flex;
			.cart_item_name {

				.cart_quantity {
					font-size: 12px;
					margin-bottom: 5px;
					display: block;
					font-weight: normal;
					color: #333;
				}
			}
			.cart_prices {
				width: 50%;
				text-align: right;
				.cart-price {
					font-weight: bold;
					display: block;
					font-size: 14px;
					color:$main-color;
				}
			}

			.cart__btn-remove {
				font-size: 13px;
				color: #30656b;
			}
		}
		.cart_select {
			.input-group-btn{
				display: block;
				width: 100%;
				min-height: 30px;
				font-size: 1em;
				line-height: 1.5;
				color: #55595c;
				background-color: #fff;
				background-image: none;
				margin: 0;
				width: auto;
				float: left;
				position: relative;
				padding: 0;
				border: none;
				box-shadow: none;
				background-color: transparent;
				border: 1px solid $main-color;
				border-radius: 5px;
				padding: 2px;
				button {
					font-size: 20px;
					line-height: 0px;
					border: 0;
					display: inline-block;
					width: 35px;
					height: 35px;
					background: $main-color;
					float: left;
					color: #fff;
					text-align: center;
					padding: 0px;
					border-radius: 5px;

					svg{
						width: 14px;
						height: 14px;
					}
					&:hover{
						background: $hover;
					}

				}
				input{
					padding: 0 2px;
					text-align: center;
					margin: 0px;
					display: block;
					float: left;
					height: 35px;
					border: 0;
					width: 60px;
					text-align: center;
					box-shadow: none;
					border-radius: 8px;
					font-size: 15px;
				}
			}
		}
	}
	.ajaxcart__footer {
		padding: 10px;
		.cart__subtotal {
			font-size: 15px;
			font-weight: 500;
			margin-bottom: 12px;
			display:flex;
			.cart__col-6 {
				width: 50%;
				float: left;
			}
			.cart__totle {
				width: 50%;
				float: left;
				text-align: right;
				.total-price {
					color: $main-color;
					font-weight:bold;
				}
			}
		}
		.cart__btn-proceed-checkout-dt {
			display: block;
			position: relative;
			button {
				width: 100%;
				background-color:#333;
				color: #fff;
				text-align: center;
				line-height: 40px;
				&:hover {
					background-color:$main-color;
				}
			}
		}
	}
}


