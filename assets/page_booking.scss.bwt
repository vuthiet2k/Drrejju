/* DR.REJU — Trang Đặt lịch / page.dat-lich. Uses global design tokens. */
.dr-booking-page{background:var(--bg);color:var(--text);overflow:hidden}.dr-booking-page .dr-h1,.dr-booking-page .dr-h2{margin:0;color:inherit;text-wrap:pretty}.dr-booking-page .dr-lead{margin:0;text-wrap:pretty}.dr-booking-page .dr-btn i{margin-left:5px}
.dr-booking-hero{background:var(--brand-bg);padding:88px 0 78px;color:#fff;position:relative}.dr-booking-hero:after{content:"";position:absolute;width:500px;height:500px;right:-150px;top:-270px;border:1px solid rgba(223,186,115,.3);border-radius:50%}.dr-booking-hero__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.58fr);align-items:end;gap:90px}.dr-booking-hero .dr-eyebrow{color:var(--gold-lt)}.dr-booking-hero h1{font-size:clamp(2.8rem,5.4vw,5.2rem);letter-spacing:-.045em;line-height:.98;margin-top:16px}.dr-booking-hero h1 em{font-style:normal;color:var(--gold);display:block}.dr-booking-hero .dr-lead{max-width:58ch;color:rgba(255,255,255,.78);margin-top:24px}.dr-booking-hero__note{display:flex;gap:16px;border-top:1px solid rgba(223,186,115,.5);padding-top:20px}.dr-booking-hero__note>i{font-size:1.3rem;color:var(--gold);margin-top:3px}.dr-booking-hero__note strong,.dr-booking-hero__note span{display:block}.dr-booking-hero__note strong{font:600 var(--fs-base) var(--font-primary)}.dr-booking-hero__note span{color:rgba(255,255,255,.72);font-size:var(--fs-sm);line-height:1.55;margin-top:7px}
.dr-booking-steps{background:var(--bg-soft)}.dr-booking-steps ol{display:grid;grid-template-columns:repeat(3,1fr);list-style:none;margin:0;padding:0}.dr-booking-steps li{display:grid;grid-template-columns:46px 1fr;gap:14px;padding:28px 28px 28px 0;align-items:center}.dr-booking-steps li+li{border-left:1px solid var(--line);padding-left:28px}.dr-booking-steps span{font:600 .75rem var(--font-primary);letter-spacing:.13em;color:var(--accent)}.dr-booking-steps p{color:var(--text-soft);font-size:var(--fs-sm);line-height:1.5;margin:0}
.dr-booking-main{background:var(--bg-alt)}.dr-booking-main__grid{display:grid;grid-template-columns:minmax(0,.72fr) minmax(520px,1.12fr);align-items:start;gap:72px}.dr-booking-aside{padding-top:26px}.dr-booking-aside .dr-h2{margin-top:12px}.dr-booking-aside .dr-lead{margin-top:18px}.dr-booking-aside__list{margin-top:34px;border-top:1px solid var(--line)}.dr-booking-aside__list>div{display:grid;grid-template-columns:28px 1fr;gap:13px;padding:16px 0;border-bottom:1px solid var(--line)}.dr-booking-aside__list i{color:var(--accent);margin-top:4px}.dr-booking-aside__list p{margin:0}.dr-booking-aside__list b,.dr-booking-aside__list span{display:block}.dr-booking-aside__list b{font:600 var(--fs-sm) var(--font-primary)}.dr-booking-aside__list span{color:var(--text-soft);font-size:var(--fs-xs);line-height:1.55;margin-top:4px}.dr-booking-aside__quiz{display:inline-flex;gap:8px;color:var(--accent);font:600 var(--fs-sm) var(--font-primary);text-decoration:none;margin-top:28px}.dr-booking-aside__quiz i{margin-top:3px}
.dr-booking-form-card{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);padding:42px 46px}.dr-booking-form-card__head{padding-bottom:28px;border-bottom:1px solid var(--line)}.dr-booking-form-card__head .dr-h2{margin-top:10px}.dr-booking-form-card__head p{color:var(--text-soft);font-size:var(--fs-sm);margin:10px 0 0}.dr-booking-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:28px}.dr-booking-form-grid fieldset{border:0;padding:0;margin:0}.dr-booking-form-grid__full{grid-column:1/-1}.dr-booking-form-card label{display:block;color:var(--text);font:600 var(--fs-sm) var(--font-primary);margin-bottom:8px}.dr-booking-form-card label em{color:var(--accent);font-style:normal}.dr-booking-form-card input:not([type=checkbox]),.dr-booking-form-card select,.dr-booking-form-card textarea{appearance:none;width:100%;border:1px solid var(--line);border-radius:0;background:var(--bg);color:var(--text);font:400 var(--fs-sm) var(--font-secondary);padding:13px 14px;outline:0;transition:border-color .2s,box-shadow .2s}.dr-booking-form-card select{padding-right:40px;background-image:linear-gradient(45deg,transparent 50%,var(--accent) 50%),linear-gradient(135deg,var(--accent) 50%,transparent 50%);background-position:calc(100% - 19px) 20px,calc(100% - 14px) 20px;background-size:5px 5px,5px 5px;background-repeat:no-repeat}.dr-booking-form-card textarea{resize:vertical;line-height:1.55}.dr-booking-form-card input:focus,.dr-booking-form-card select:focus,.dr-booking-form-card textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(21,107,84,.12)}.dr-booking-form-card ::placeholder{color:var(--text-soft);opacity:.78}.dr-booking-consent{display:flex!important;gap:10px;align-items:flex-start;color:var(--text-soft)!important;font:400 var(--fs-xs)/1.55 var(--font-secondary)!important;margin-top:22px!important}.dr-booking-consent input{appearance:auto;accent-color:var(--accent);margin-top:3px;min-width:14px;height:14px}.dr-booking-form-error{min-height:20px;color:#a22b22;font-size:var(--fs-xs);margin:10px 0 0}.dr-booking-submit{margin-top:6px}.dr-booking-alert{display:flex;gap:11px;padding:16px;margin-top:24px;font-size:var(--fs-sm);line-height:1.55}.dr-booking-alert p{margin:0}.dr-booking-alert--error{border-left:3px solid #a22b22;background:#fff4f2;color:#81261f}.dr-booking-alert--success{border-left:3px solid var(--accent);background:var(--bg-soft);color:var(--text-soft)}.dr-booking-alert--success i{color:var(--accent);margin-top:3px}
.dr-booking-options{background:var(--bg)}.dr-booking-options__head{display:flex;align-items:end;justify-content:space-between;gap:48px}.dr-booking-options__head .dr-h2{margin-top:12px}.dr-booking-options__head .dr-lead{max-width:450px}.dr-booking-options__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:38px}.dr-booking-options__grid>a{display:grid;grid-template-columns:30px 1fr 18px;gap:12px;align-items:center;padding:24px 22px 24px 0;color:var(--text);text-decoration:none}.dr-booking-options__grid>a+a{border-left:1px solid var(--line);padding-left:22px}.dr-booking-options__grid>a>i:first-child{color:var(--accent);font-size:1.15rem}.dr-booking-options__grid>b{}.dr-booking-options__grid b,.dr-booking-options__grid small{display:block}.dr-booking-options__grid b{font:600 var(--fs-sm) var(--font-primary)}.dr-booking-options__grid small{color:var(--text-soft);font-size:var(--fs-xs);line-height:1.45;margin-top:4px}.dr-booking-options__grid>a>i:last-child{color:var(--accent);font-size:.75rem}.dr-booking-closing{background:var(--brand-bg-dk);padding:42px 0;color:#fff}.dr-booking-closing .dr-container{display:flex;justify-content:space-between;gap:24px;align-items:center}.dr-booking-closing span{font:600 var(--fs-xs) var(--font-primary);letter-spacing:.13em;text-transform:uppercase;color:var(--gold)}.dr-booking-closing p{font:500 var(--fs-base) var(--font-primary);margin:0}
.ui-datepicker{z-index:9999!important;border:1px solid var(--line)!important;border-radius:0!important;background:var(--surface)!important;box-shadow:var(--shadow);font-family:var(--font-secondary)!important}.ui-datepicker .ui-datepicker-header{background:var(--brand-bg)!important;border:0!important;border-radius:0!important;color:#fff!important}.ui-datepicker .ui-datepicker-title{color:#fff!important}.ui-datepicker .ui-datepicker-calendar .ui-state-default{background:transparent!important;border:0!important;color:var(--text)!important;text-align:center}.ui-datepicker .ui-datepicker-calendar .ui-state-active,.ui-datepicker .ui-datepicker-calendar .ui-state-hover{background:var(--bg-soft)!important;color:var(--accent)!important}.ui-datepicker .ui-datepicker-calendar .ui-state-highlight{color:var(--accent)!important}
@media(max-width:991px){.dr-booking-hero{padding:68px 0}.dr-booking-hero__grid,.dr-booking-main__grid{grid-template-columns:1fr;gap:42px}.dr-booking-main__grid{max-width:760px}.dr-booking-aside{padding-top:0}.dr-booking-options__head{align-items:start;flex-direction:column;gap:18px}.dr-booking-options__head .dr-lead{max-width:620px}.dr-booking-options__grid{grid-template-columns:1fr}.dr-booking-options__grid>a,.dr-booking-options__grid>a+a{border-left:0;padding:20px 0}.dr-booking-options__grid>a+a{border-top:1px solid var(--line)}}
@media(max-width:575px){.dr-booking-page .dr-section{padding-top:56px;padding-bottom:56px}.dr-booking-hero{padding:54px 0}.dr-booking-hero h1{font-size:2.75rem}.dr-booking-steps ol{grid-template-columns:1fr}.dr-booking-steps li,.dr-booking-steps li+li{padding:18px 0;border-left:0}.dr-booking-steps li+li{border-top:1px solid var(--line)}.dr-booking-form-card{padding:28px 18px}.dr-booking-form-grid{grid-template-columns:1fr;gap:15px}.dr-booking-form-grid__full{grid-column:auto}.dr-booking-submit{width:100%;justify-content:center}.dr-booking-closing .dr-container{align-items:flex-start;flex-direction:column}.dr-booking-hero__note{max-width:420px}}
