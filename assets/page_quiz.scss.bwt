/* DR.REJU — Trang Hồ sơ da / page.quiz
   Uses global tokens defined in snippets/header_style.bwt. */
.dr-quiz-page{background:var(--bg);color:var(--text);overflow:hidden}
.dr-quiz-page .dr-h1,.dr-quiz-page .dr-h2,.dr-quiz-page .dr-h3{margin:0;color:inherit;text-wrap:pretty}
.dr-quiz-page .dr-lead{margin:0;text-wrap:pretty}
.dr-quiz-page .dr-btn i{margin-left:5px}

.dr-quiz-hero{background:var(--brand-bg);color:var(--brand-text);padding:92px 0 100px;position:relative}
.dr-quiz-hero:after{content:"";position:absolute;inset:auto -6% -140px 45%;height:270px;border:1px solid rgba(223,186,115,.22);border-radius:50%;pointer-events:none}
.dr-quiz-hero__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.75fr);align-items:center;gap:72px}
.dr-quiz-hero__copy{max-width:640px}.dr-quiz-hero .dr-eyebrow{color:var(--gold-lt)}
.dr-quiz-hero h1{font-size:clamp(2.7rem,5.3vw,5.25rem);letter-spacing:-.045em;line-height:.98;margin-top:16px}
.dr-quiz-hero h1 em{display:block;color:var(--gold);font-style:normal}.dr-quiz-hero .dr-lead{color:rgba(255,255,255,.79);max-width:54ch;margin-top:26px}
.dr-quiz-hero__actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:32px}.dr-quiz-hero .dr-btn--outline{border-color:rgba(255,255,255,.55);color:#fff}.dr-quiz-hero .dr-btn--outline:hover{background:#fff;color:var(--emerald)}
.dr-quiz-hero__note{display:flex;align-items:flex-start;gap:9px;color:rgba(255,255,255,.72);font-size:var(--fs-sm);line-height:1.55;margin:24px 0 0}.dr-quiz-hero__note i{color:var(--gold);margin-top:3px}
.dr-quiz-hero__visual{border:1px solid rgba(223,186,115,.34);padding:42px 36px 34px;min-height:412px;position:relative;background:rgba(6,32,26,.2)}
.dr-quiz-hero__stamp{width:148px;height:148px;display:flex;flex-direction:column;justify-content:center;align-items:center;border-radius:50%;border:1px solid var(--gold);background:var(--brand-bg-dk);color:var(--gold);margin:0 auto;position:relative;z-index:2;text-align:center}.dr-quiz-hero__stamp span{font-size:10px;font-family:var(--font-primary);letter-spacing:.18em}.dr-quiz-hero__stamp strong{font:600 1.7rem/1.03 var(--font-primary);margin-top:6px}
.dr-quiz-hero__route{position:absolute;left:calc(50% - 1px);top:168px;bottom:76px;border-left:1px solid rgba(223,186,115,.5)}.dr-quiz-hero__route span{display:block;width:7px;height:7px;background:var(--gold);border-radius:50%;margin:39px 0 0 -4px}
.dr-quiz-hero__steps{list-style:none;margin:32px 0 0;padding:0;position:relative;z-index:2}.dr-quiz-hero__steps li{display:grid;grid-template-columns:42px 1fr;gap:14px;align-items:center;min-height:58px}.dr-quiz-hero__steps b{font:600 .75rem var(--font-primary);color:var(--gold);letter-spacing:.12em}.dr-quiz-hero__steps span{font-size:var(--fs-sm);color:#fff}

.dr-quiz-intro{background:var(--bg)}.dr-quiz-section-head{display:flex;align-items:end;justify-content:space-between;gap:48px}.dr-quiz-section-head>div{max-width:620px}.dr-quiz-section-head .dr-h2{margin-top:12px}.dr-quiz-section-head>.dr-lead{max-width:480px}
.dr-quiz-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:48px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.dr-quiz-benefit{padding:30px 36px 30px 0}.dr-quiz-benefit+.dr-quiz-benefit{border-left:1px solid var(--line);padding-left:36px}.dr-quiz-benefit__number{font:600 .75rem var(--font-primary);color:var(--accent);letter-spacing:.16em}.dr-quiz-benefit h3{font-size:var(--fs-lg);margin-top:18px}.dr-quiz-benefit p{color:var(--text-soft);font-size:var(--fs-sm);line-height:1.65;margin:10px 0 0}

.dr-quiz-process{background:var(--bg-soft);padding:56px 0}.dr-quiz-process__head{display:flex;align-items:end;justify-content:space-between;gap:24px}.dr-quiz-process__head .dr-h2{margin-top:10px}.dr-quiz-process__list{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:34px}.dr-quiz-process__list div{display:grid;grid-template-columns:34px 1fr;gap:13px;align-items:start}.dr-quiz-process__list span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font:600 .75rem var(--font-primary)}.dr-quiz-process__list p{margin:4px 0 0;color:var(--text-soft);font-size:var(--fs-sm);line-height:1.6}

.dr-quiz-workspace{background:var(--bg-alt)}.dr-quiz-workspace__head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.dr-quiz-workspace__head .dr-h2{margin-top:10px}.dr-quiz-workspace__time{color:var(--text-soft);font-size:var(--fs-sm);margin:0}.dr-quiz-workspace__time i{color:var(--accent);margin-right:6px}.dr-quiz-shell{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);max-width:900px;margin:auto;padding:40px 48px 46px}.dr-quiz-progress{height:4px;background:var(--line);overflow:hidden}.dr-quiz-progress span{display:block;height:100%;width:20%;background:var(--accent);transition:width .28s ease}.dr-quiz-progress__meta{display:flex;justify-content:space-between;color:var(--text-soft);font-size:var(--fs-xs);letter-spacing:.08em;text-transform:uppercase;margin-top:12px}.dr-quiz-form{margin-top:38px}.dr-quiz-question{border:0;padding:0;margin:0}.dr-quiz-question legend{font:600 clamp(1.45rem,2vw,2rem)/1.25 var(--font-primary);color:var(--text);max-width:730px}.dr-quiz-question>p{color:var(--text-soft);font-size:var(--fs-sm);line-height:1.6;margin:12px 0 0}.dr-quiz-options{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:26px}.dr-quiz-options label{cursor:pointer;display:block}.dr-quiz-options input{position:absolute;opacity:0;pointer-events:none}.dr-quiz-options span{height:100%;min-height:98px;display:block;border:1px solid var(--line);padding:18px 20px;transition:border-color .2s,background .2s,box-shadow .2s}.dr-quiz-options b{display:block;font:600 var(--fs-base) var(--font-primary);color:var(--text)}.dr-quiz-options small{display:block;color:var(--text-soft);font-size:var(--fs-xs);line-height:1.45;margin-top:7px}.dr-quiz-options input:focus-visible+span{outline:3px solid rgba(21,107,84,.2);outline-offset:3px}.dr-quiz-options input:checked+span{border-color:var(--accent);background:var(--bg-soft);box-shadow:inset 4px 0 0 var(--accent)}.dr-quiz-options--compact span{min-height:68px;display:flex;align-items:center}.dr-quiz-error{color:#a22b22;font-size:var(--fs-sm);min-height:20px;margin:20px 0 0}.dr-quiz-controls{display:flex;justify-content:space-between;gap:16px;margin-top:14px}.dr-quiz-controls [data-quiz-next]{margin-left:auto}
.dr-quiz-result{margin-top:38px}.dr-quiz-result .dr-h2{margin-top:12px}.dr-quiz-result>.dr-lead{margin-top:12px;max-width:62ch}.dr-quiz-result__grid{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;margin-top:32px}.dr-quiz-result__grid>div,.dr-quiz-result__grid aside{border-top:1px solid var(--line);padding-top:20px}.dr-quiz-result__grid h4{font:600 var(--fs-base) var(--font-primary);margin:0}.dr-quiz-result__grid ul{padding-left:18px;color:var(--text-soft);font-size:var(--fs-sm);line-height:1.7;margin:12px 0 0}.dr-quiz-result__grid aside{background:var(--bg-soft);padding:20px}.dr-quiz-result__grid aside i{color:var(--accent);font-size:1.3rem}.dr-quiz-result__grid aside p{font-size:var(--fs-sm);line-height:1.65;color:var(--text-soft);margin:12px 0 0}.dr-quiz-result__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.dr-quiz-noscript{background:#fff4df;border-left:3px solid var(--gold);padding:14px 16px;color:var(--text);font-size:var(--fs-sm)}.dr-quiz-noscript a{color:var(--accent);font-weight:600}

.dr-quiz-related{background:var(--bg)}.dr-quiz-articles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:38px}.dr-quiz-article{border-top:1px solid var(--line)}.dr-quiz-article__media{display:block;aspect-ratio:16/10;overflow:hidden;background:var(--bg-soft);color:var(--accent);font:600 var(--fs-sm) var(--font-primary);text-decoration:none}.dr-quiz-article__media span{display:grid;place-items:center;height:100%;letter-spacing:.12em}.dr-quiz-article__media img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.dr-quiz-article:hover img{transform:scale(1.035)}.dr-quiz-article__body{padding:18px 0}.dr-quiz-article__body>span{color:var(--text-soft);font-size:var(--fs-xs)}.dr-quiz-article h3{font-size:var(--fs-lg);margin-top:9px}.dr-quiz-article h3 a{color:var(--text);text-decoration:none}.dr-quiz-article__body p{color:var(--text-soft);font-size:var(--fs-sm);line-height:1.6;margin:10px 0}.dr-quiz-article__body>a{color:var(--accent);font:600 var(--fs-sm) var(--font-primary);text-decoration:none}.dr-quiz-empty{color:var(--text-soft);margin-top:28px}.dr-quiz-empty a{color:var(--accent)}

.dr-quiz-closing{background:var(--brand-bg-dk);color:#fff;padding:60px 0}.dr-quiz-closing .dr-eyebrow{color:var(--gold)}.dr-quiz-closing__in{display:grid;grid-template-columns:1fr minmax(280px,.65fr);gap:72px;align-items:end}.dr-quiz-closing .dr-h2{margin-top:12px;max-width:560px}.dr-quiz-closing p{color:rgba(255,255,255,.75);font-size:var(--fs-sm);line-height:1.6;margin:0 0 20px}.dr-quiz-closing__phone{display:inline-flex;gap:8px;color:var(--gold-lt);font-size:var(--fs-sm);text-decoration:none;margin-left:16px}.dr-quiz-closing__phone i{margin-top:3px}

@media (max-width:991px){.dr-quiz-hero{padding:70px 0}.dr-quiz-hero__grid{grid-template-columns:1fr;gap:44px}.dr-quiz-hero__visual{max-width:590px;width:100%}.dr-quiz-benefits{grid-template-columns:1fr}.dr-quiz-benefit{padding:24px 0}.dr-quiz-benefit+.dr-quiz-benefit{border-left:0;border-top:1px solid var(--line);padding-left:0}.dr-quiz-process__list{grid-template-columns:1fr;gap:18px}.dr-quiz-section-head{align-items:start;flex-direction:column;gap:18px}.dr-quiz-section-head>.dr-lead{max-width:620px}.dr-quiz-articles{grid-template-columns:1fr 1fr}.dr-quiz-closing__in{grid-template-columns:1fr;gap:24px}.dr-quiz-workspace__head{align-items:start;flex-direction:column}.dr-quiz-shell{padding:32px}}
@media (max-width:575px){.dr-quiz-hero{padding:56px 0 64px}.dr-quiz-hero h1{font-size:2.75rem}.dr-quiz-hero__visual{padding:30px 22px 24px;min-height:370px}.dr-quiz-hero__steps li{grid-template-columns:35px 1fr}.dr-quiz-hero__route{left:39px}.dr-quiz-page .dr-section{padding-top:56px;padding-bottom:56px}.dr-quiz-process{padding:42px 0}.dr-quiz-shell{padding:24px 18px 28px}.dr-quiz-options{grid-template-columns:1fr}.dr-quiz-options span{min-height:76px}.dr-quiz-controls{flex-wrap:wrap}.dr-quiz-controls .dr-btn{width:100%;justify-content:center}.dr-quiz-controls [data-quiz-next]{margin-left:0}.dr-quiz-result__grid{grid-template-columns:1fr}.dr-quiz-articles{grid-template-columns:1fr}.dr-quiz-closing__phone{display:flex;margin:16px 0 0}.dr-quiz-hero__actions .dr-btn{width:100%;justify-content:center}}
@media (prefers-reduced-motion:reduce){.dr-quiz-progress span,.dr-quiz-options span,.dr-quiz-article__media img{transition:none}}
