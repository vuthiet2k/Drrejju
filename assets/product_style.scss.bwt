$main-color: {{ settings.main_color }};
$hover: {{ settings.hover_color }};
.title-product {
	font-size: 24px;
	font-weight: 700;
	margin: 0px 0px 15px;
	color: $main-color;
}
.gallery-top  {
	.swiper-slide{
		padding-bottom: 100%;
		display: block;
		height: 0;
		background: #fff;
		overflow: hidden;
		border-radius: 15px;
		img{
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			max-width: 99%;
			max-height: 100%;
			width: auto !important;
			height: auto !important;
			position: absolute;
			border-radius: 5px;
		}
	}
}
.product-image-block{
	@media(max-width: 991px){
		margin-bottom: 20px;
	}
	.btn-wishlist{
		position: absolute;
		right: 10px;
		top: 10px;
		z-index: 9;
		svg{
			width: 30px;
			height: 30px;
			path{
				fill: $main-color;
			}
		}
	}
	.thong-so{
		position: absolute;
		right: 10px;
		top: 10px;
		z-index: 9;
		padding: 5px 10px 5px 20px;

		background: linear-gradient(to right, transparent 0%,rgba(255,255,255,0.7) 30%, rgba(255,255,255,1) 100%);
		font-size: 12px;
		text-align: right;
		font-style: italic;
		ul{
			li{
				margin-bottom: 5px;
				span{
					display: block;
					font-weight: 700;
				}
			}
		}
	}
}
.gallery-thumbs{
	margin-top: 10px !important;
	padding: 10px;
	background: #fff;
	border-radius: 15px;
	.swiper-slide {
		border: 2px solid #ebebeb;
		cursor: pointer;
		background: #fff;
		border-radius: 5px;
		overflow: hidden;
		.p-100{
			padding-bottom: 100%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			img{
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				-o-object-fit: contain;
				object-fit: contain;
			}
		}
		&.swiper-slide-thumb-active{
			border-color: $main-color;

		}
		&:hover{
			border-color: $main-color;

		}
	}

}
.layout-product{
	padding-bottom: 30px;
	.details-pro{
		background: #fff;

		border-radius: 15px;
		padding: 10px;
		min-height: 100%;
		
		.price-box{
			margin-bottom: 20px;
			padding: 10px;
			border-radius: 5px;
			background: #ebf9ff;
			.special-price {
				font-size: 30px;
				font-weight: 600;
				color: $main-color;
				display: inline-block;
			}
			.old-price {
				color: #545454;
				font-size: 16px;
				display: inline-block;
				text-decoration: line-through;
				margin-left: 10px;
			}
			.save-price{
				display: block;
				.product-price-save{
					color: #ef1104;
				}
			}
		}
	}
	.inventory_quantity {
		font-size: 16px;
		margin-bottom: 10px;
		.thump-break{

			.a-stock, .a-vendor, .variant-sku {
				font-weight: 400;
				color: $main-color;
			}

		}
	}
	.product-summary {
		margin-top: 10px;
		font-size: 14px;
		background: #f0f0f0;
		padding: 10px;
		border-radius: 5px
			img{
				display: none;
				}
	}
	.select-swatch{
		margin-bottom: 20px;
	}
	.swatch{
		font-size: 14px;
		margin-bottom: 5px;
		.header{
			margin-bottom: 5px;
			font-weight: 600;
			.value-roperties{
				color: $main-color;
			}
		}
		.swatch-element {
			display: inline-block;
			margin: 0px 5px 5px 0;
			input{
				display: none;
			}
			label{
				min-width: 36px;
				height: 33px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #000;
				cursor: pointer;
				white-space: nowrap;
				padding: 0 5px;
				position: relative;
				margin-bottom: 0;
				border-radius: 5px;
				.crossed-out{
					display: none;
				}
			}

			input:checked+label {
				background: $main-color;
				border-color: $main-color;
				color: #fff;
			}
			.tooltip{
				display: none;
			}

			&.color{
				label{
					padding: 0 10px 0 0;
					img{
						max-height:31px;
						border-radius: 5px;
					}
					span{
						padding-left: 10px;
					}
				}
				input:checked+label{

				}

			}
		}
	}
	.selector-wrapper {
		display: none !important;
	}

	.button_actions{
		float: left;
		width: 100%;
		margin-top: 10px;
		display: flex;
		@media(max-width: 767px){
			display: block;
		}
		.add_to_cart {
			border: 2px solid $main-color;
			height: 50px;
			padding: 0 0px;
			color: #fff;
			text-transform: uppercase;
			border-radius: 5px;
			width: 100%;
			font-weight: 500;
			display: flex;
			align-items: center;
			background: #fff;
			.icon{
				min-width: 60px;
				svg{
					width: 30px;
					height: 30px;
					path{
						fill: $main-color;
					}
				}
			}
			.text{
				width: 100%;
				height: 100%;
				background: $main-color;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-direction: column;
			}
			.txt-main{
				font-weight: 600;
			}
			.text_2{
				display: block;
				font-size: 12px;
				text-transform: none;
			}

			@media(max-width: 767px){
				width: 100%;
				margin-right: 0px;
			}
			&:hover{
				border: 2px solid $hover;
				.text{
					background:$hover;
				}
			}


		}

		.btn-soldout{
			border: initial;
			height: 45px;
			padding: 0 20px;
			background: $main-color;
			color: #fff;
			text-transform: uppercase;
			border-radius: 5px;
			width: 100%;
			margin-right: 5px;
			justify-content: center;
    opacity: 0.8;
			@media(max-width: 991px){
				width: 100%;
				margin-right: 0px;
			}
			&:hover{
				opacity: 0.8;
			}
		}
	}

	.flex-quantity {
		display: block;
		font-size: 14px;
		margin-top: 10px;
		.sl {
			display: block;
			font-weight: 600;
		}
	}
	.input_number_product {
		display: block;
		width: 100%;
		min-height: 30px;
		font-size: 1em;
		line-height: 1.5;
		color: #55595c;
		background-color: #fff;
		background-image: none;
		margin: 0;
		width: auto;
		float: left;
		position: relative;
		padding: 0;
		border: none;
		box-shadow: none;
		background-color: transparent;
		border: 1px solid $main-color;
		border-radius: 5px;
		padding: 2px;
		.btn_num {
			font-size: 20px;
			line-height: 0px;
			border: 0;
			display: inline-block;
			width: 35px;
			height: 35px;
			background: $main-color;
			float: left;
			color: #fff;
			text-align: center;
			padding: 0px;
			border-radius: 5px;

			svg{
				width: 14px;
				height: 14px;
			}

		}
		input{
			padding: 0 2px;
			text-align: center;
			margin: 0px;
			display: block;
			float: left;
			height: 35px;
			border: 0;
			width: 60px;
			text-align: center;
			box-shadow: none;
			border-radius: 8px;
			font-size: 15px;
		}
	}
}



@media (max-width: 767px){


	.title-product{
		margin-top: 15px;
	}
	.layout-product {
		.flex-quantity{
			display: block;
		}

		.button_actions {
			.add_to_cart{
				margin-top: 15px;
				width: 100%;
			}
		}
	}
	.layout-product {
		.inventory_quantity{
			.line{
				display: none;
			}
			.mb-break {
				display: block;
			}
		}
	}
}
.khuyen-mai{
	margin-top: 20px;
	.title{
		width: auto;
		color: #fff;
		font-weight: 600;
		background: $main-color;
		border-radius: 5px 5px 0px 0px;
		font-size: 14px;
		display: inline-flex;
		padding: 5px 15px;
		align-items: center;
		border: 2px solid $main-color;
		img{
			width: 30px;
			height: auto;
			margin-right: 10px;
		}
	}
	.content{
		padding-bottom: 5px !important;
		padding: 25px 15px 15px 15px;
		border-radius: 0 5px 5px 5px;
		position: relative;
		border: 1px solid $main-color;
		ul{
			li{
				display: flex;
				margin-bottom: 10px;
				align-items: center;
				img{
					width: 20px;
					height: auto;
					margin-right: 5px;
				}
			}
		}
	}


}

.flashsale_product{
	background: rgba(239,255,207,0.7);
	padding: 10px;
	z-index: 999;
	width: 100%;
	border-radius: 5px;
	color: #fff;
	position: absolute;
	bottom: 0;
	.title-count-down{
		font-weight: 600;
		color: $main-color;
		img{
			height: 30px;
			width: auto;
			animation: 0.8s linear 0s infinite normal none running pulseSmall;
			margin-right: 10px;
		}
	}
	.count-down{
		display: inline-flex;
		position: relative;
		font-size: 14px;
		padding: 0;
		background: transparent;
		margin-bottom: 0;
		align-items: center;
		@media(max-width: 1199px){
			font-size: 12px;
		}
		@media(max-width: 375px){
			flex-direction: column;
			justify-content: center;
			display: flex;
		}
		.timer-view{
			display: inline-block;
			text-align: center;
			margin-bottom: 0;
			.block-timer {
				width: 30px;
				height: 25px;
				background: $main-color;
				border-radius: 5px;
				display: inline-block;
				color: #fff;
				margin: 5px 3px;

				p{
					padding-top: 2px;
					margin-bottom: 0;
					@media(max-width: 1199px){
						padding-top: 3px;
					}
				}

			}
		}
	}
	.elio-productcount{
		.title{
			font-weight: 600;
			span{
				color: #ef1104;
			}
		}
	}
}


.reviews_details_product {
	margin-bottom: 15px;
}


.content-pro{

	.chinh-sach-pro{
		padding: 10px;
		background: #fff;
		border-radius: 5px;
		margin-bottom: 20px;
		@media (max-width: 991px) and (min-width: 767px){
			margin-right: 10px;
		}
		.title{
			font-size: 20px;
			font-weight: 700;
			margin-bottom: 20px;
			position: relative;
			&:before {
				background: $main-color;
				content: '';
				right: 0;
				left: 0;
				position: absolute;
				bottom: -5px;
				height: 3px;
				display: block;
				z-index: 1;
				width: 40%;
			}
		}
		li{
			display: flex;
			margin-bottom: 10px;
			span{
				min-width: 20px;
				height: 20px;
				display: inline-block;
				background: $main-color;
				color: #fff;
				border-radius: 5px;
				text-align: center;
				margin-right: 10px;
				line-height: 21px;
				font-size: 16px;
				position: relative;
				top: 3px;
			}
		}
	}



}
.product-tab{

	padding: 10px;
	background: #fff;
	border-radius: 15px;
	min-height: 100%;
	.tabs-title {
		padding: 0;
		margin: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		margin-right: -5px;
		margin-left: -5px;
		margin-bottom: 20px;
	}
	.tab-link{
		cursor: pointer;
		padding-right: 5px;
		padding-left: 5px;
		@media(max-width: 767px){
			text-align: center;
			margin-bottom: 10px;
			width: 100%;
		}
		h3{
			color: $main-color;
			margin: 0;
			font-size: 14px;
			text-transform: uppercase;
			padding: 10px 40px;
			border: 1px solid $main-color;
			border-radius: 5px;

			@media(max-width: 1199px){
				padding: 10px 20px;
			}
			@media(max-width: 767px){
				border-radius: 10px;
			}
		}
		&.active, &:hover{
			h3{
				background: $main-color;
				color: #fff;
				border: 1px solid $main-color;
			}
		}
	}
	.tab-content{
		opacity: 0;
		visibility: hidden;
		height: 0;
		overflow: hidden;
		&.active{ 
			opacity: 1;
			visibility: visible;
			height: auto;
		}
	}
	.product_getcontent{
		position: relative;
		.ba-text-fpt.has-height {
			height: 340px;
			overflow: hidden;
			-webkit-transition: height 0.2s;
			-moz-transition: height 0.2s;
			transition: height 0.2s;

		}
		.show-more {
			position: relative;
			&::before {
				height: 100px;
				margin-top: -60px;
				content: "";
				display: block;
				background: transparent;
				background: -moz-linear-gradient(top, rgba(255,255,255,0) 0, rgba(255,255,255,0.91) 50%, #fff 55%);
				background: -webkit-gradient(left top, left bottom, color-stop(0, rgba(255,255,255,0)), color-stop(50%, rgba(255,255,255,0.91)), color-stop(55%, #fff));
				background: -webkit-linear-gradient(top, rgba(255,255,255,0) 0, rgba(255,255,255,0.91) 50%, #fff 55%);
				background: -o-linear-gradient(top, rgba(255,255,255,0) 0, rgba(255,255,255,0.91) 50%, #fff 55%);
				background: -ms-linear-gradient(top, rgba(255,255,255,0) 0, rgba(255,255,255,0.91) 50%, #fff 55%);
				background: linear-gradient(to bottom, rgba(255,255,255,0) 0, rgba(255,255,255,0.91) 50%, #fff 55%);
			}
			.btn--view-more {
				position: relative;
				text-align: center;
				background-color: #fff;
				color: #333;
				font-weight: normal;
				outline: none;
				box-shadow: none;
				font-size: 14px;
				border: 0;
				display: block;
				margin-bottom: 20px;
				.more-text {
					display: inline-block;
					cursor: pointer;
				}
				.less-text {
					display: none;
					cursor: pointer;
				}
				&.active{
					.more-text {
						display: none;
					}
					.less-text {
						display: inline-block;
					}
				}
			}
		}
		&.expanded{
			.ba-text-fpt.has-height {
				height: auto;

			}
			.show-more {
				&::before {
					display: none;
				}
			}
		}
	}
	.tab-float{
		border: 1px solid $main-color;
		padding: 10px;
		border-radius: 5px;
	}
}
.product-col{
	.swiper-slide{
		margin-top: 0 !important;
		margin-bottom: 10px !important;
	}
}
.motangan{
	margin-bottom: 20px;
	img, iframe, table{
		display: none;
	}
}

@media(max-width: 991px) and (min-width: 767px){
	.product-right{
		display: -ms-flexbox;
		display: flex;
		-ms-flex-wrap: wrap;
		flex-wrap: wrap;
		padding: 0;
		>div{
			position: relative;
			width: 100%;
			padding-right: 15px;
			padding-left: 15px;
			-ms-flex: 0 0 calc(50% - 10px);
			flex: 0 0 calc(50% - 10px);
			max-width: calc(50% - 10px);
			margin-top: 0;
			border: 0;
			border-radius: 0px;
			&.product-col{
				width: 100%;
				flex: 100%;
				max-width: 100%;
			}
		}
	}
}

@-webkit-keyframes pulseSmall {
	50% {
		opacity: 0.3;
		transform: scale(1.3);
	}
}
.thump-check{
	height: 10px;
	position: relative;
	font-size: 12px;
	text-align: center;
	background: #e7e7e7;
	margin-top: 10px;
	border-radius: 5px;
	overflow: hidden;

	.check-bar1{
		position: absolute;
		height: 8px;
		top: 0px;
		border-radius: 5px;
		background-color: $main-color;
		-webkit-animation: progress_bar_fill 2s linear infinite;
		animation: progress_bar_fill 2s linear infinite;
		background-image: linear-gradient(45deg, rgba(255,255,255,0.20) 25%, transparent 25%, transparent 50%, rgba(255,255,255,0.20) 50%, rgba(255,255,255,0.20) 75%, transparent 75%, transparent);
		background-size: 40px 40px;
		transition: width .6s ease;
		height: 100%;
	}

}
.check-bar{
	display: inline-block;
	width: 100%;
	height: 100%;
	z-index: 1;
	color: #000;
	position: relative;
	margin-top: 10px;
}
@keyframes progress_bar_fill{
	0% {
		background-position: 0 0;
	}
	100% {
		background-position: 40px 0;
	}
}
.chinhsach-pro{
	margin-bottom: 30px;
	background: #efffcf;
	padding: 10px;
	border-radius: 5px;
	.title-head{
		margin-bottom: 15px;
		position: relative;
		font-size: 24px;
		font-weight: 700;
		color: $main-color;
		display: inline-block;
		img{
			height: 25px;
			position: relative;
			top: -5px;
			@media(max-width: 1199px){
				display: none;
			}
		}


	}
	.col-12{
		margin-bottom: 15px;
	}
	.item{
		display: flex;
		align-items: center;
		img{
			max-height: 40px;
			width: auto;
		}
		.text{
			color: #000;
			padding-left: 10px;
			.title{
				display: block;
				color: $main-color;
				font-size: 16px;
				font-weight: 600;
			}
		}

	}
}
.section_coupon{
	.item{
		width: 100%;
		margin-right: 30px;
		display: flex;
		align-items: center;
		border: 2px solid $main-color;
		border-radius: 5px;
		margin-bottom: 10px;

		.content_wrap{
			display: flex;
			flex-direction: column;
			padding: 5px;
			position: relative;
			width: 100%;
			.content-top{
				font-size: 16px;
				span{
					display: block;
					font-size: 12px;
					color: #000;
				}
				@media(max-width: 350px){
					font-size: 14px;
					span{
						font-size: 10px;
					}
				}
			}
			.content-bottom{
				display: flex;
				align-items: center;
				justify-content: space-between;

				span{
					color: $main-color;
					font-size: 12px;

				}
				.coupon-code{
					display: inline-block;
					color: #fff;
					background: $hover;
					padding: 5px 10px;
					border-radius: 8px;
					margin-top: 5px;
					margin-left: 0px;
					min-width: 90px;
					text-align: center;
					cursor: pointer;
				}
			}
			.info-button{
				display: flex;
				justify-content: center;
				align-items: center;
				width: 25px;
				height: 25px;
				font-size: 14px;
				border: 1px solid $main-color;
				border-radius: 99px;
				position: absolute;
				right: 10px;
				top: 5px;
				svg{
					width: 10px;
					height: 10px;
					fill: $main-color;
				}
				&:hover{
					svg{
						fill: $hover;
					}
				}
			}
		}
	}

}
.popup-coupon{
	padding: 0 8px;
	box-sizing: border-box;
	width: 450px;
	max-height: 505px;
	height: auto;
	background: transparent;
	margin: 0 auto;
	position: relative;
	position: fixed;
	left: 50%;
	top: 10%;
	transition: transform 0.5s cubic-bezier(0.645, 0.045, 0.355, 1),visibility 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
	box-shadow: none;
	touch-action: manipulation;
	opacity: 0;
	transform: translateX(-50%);
	z-index: -1;
	min-height: 200px;

	@media(max-width: 767px){
		width: 100%;
	}
	&.active{
		opacity: 1;
		z-index: 99999;

	}

	.content{

		display: flex;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		border-radius: 5px;
		background-color: #fff;
		margin: 0 auto;
		-webkit-box-shadow: 3px 3px 20px 0 rgba(0,0,0,0.15);
		box-shadow: 3px 3px 20px 0 rgba(0,0,0,0.15);
		position: relative;
		overflow: hidden;
		.title{
			display: block;
			width: 100%;
			padding: 10px;
			background: $main-color;
			color: #fff;
		}
		.close-popup{
			position: absolute;
			top: 8px;
			right: 10px;

			svg{
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
				path{
					fill: #fff;
				}
			}
			&:hover{
				svg{
					transform: rotate(90deg);
				}
			}
		}
		ul{
			width: 100%;
			li{
				padding: 10px;
				display: flex;
				&:nth-child(2n + 1){
					background-color:#f9f9f9;

				}
				span:first-child{
					min-width: 126px;
					display: inline-block;
					color: $main-color;
				}
			}
		}
	}
}
@media(min-width: 991px){
	.product-right .group_title_index .title .title-name {
		font-size: 18px;
	}
}
.productRelate{
	margin-top: 30px;
	padding: 10px;
	background: #fff;
	border-radius: 15px;
	.title{
		font-size: 48px;
		line-height: 56px;
		z-index: 9;
		padding: 0;
		margin: 0 0;
		position: relative;
		display: block;
		color: $main-color;
		font-weight: 700;
		text-align: center;
		margin-bottom: 20px;
		@media(max-width: 767px){
			font-size: 30px;
			line-height: inherit;
		}
		a{
			color: $main-color;
			&:hover{
				color: $hover;
			}
		}
	}
}
.support-product{
	width: 100%;
	padding: 10px;
	border-radius: 5px;
	background: #fff;
	min-height: 100%;
	@media(max-width: 767px){
		margin-top: 20px
	}
	.title{
		width: 100%;
		text-align: center;
		font-size: 14px;
		margin: 0;
		font-weight: 700;
	}
	.image {
		height: 150px;
		display: block;
		position: relative;
		img {
			width: auto !important;
			max-height: 100%;
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0;
			right: 0;
			margin: auto;
		}
	}
	.title2 {
		width: 100%;
		text-align: center;
		font-size: 14px;
		line-height: 23px;
		margin: 0;
		font-weight: normal;
	}
	.phone {
		width: 100%;
		margin-top: 10px;
		display: block;
		text-align: center;
		line-height: 1.1;
		a {
			font-size: 29px;
			font-weight: 600;
			color: $main-color;
			text-decoration: none;
			&:hover{
				color: $hover;
			}
		}
	}
	.or {
		width: 100%;
		margin: 10px 0;
		color: #7a7d8d;
		text-align: center;
		line-height: 1.1;
		span {
			display: inline-block;
			background: #fff;
			padding: 0 10px;
			transform: translateY(50%);
			font-size: 13px;
		}
		&:after {
			display: block;
			content: "";
			width: 100%;
			height: 1px;
			background: #ededed;
		}
	}
	.title3 {
		width: 100%;
		text-align: center;
		font-size: 14px;
		margin: 0;
		font-weight: 700;
	}
	.chat {
		text-align: center;
		margin-top: 20px;
		font-size: 16px;
		position: relative;
		font-weight: 600;
		padding: 10px 20px;
		border-radius: 15px;
		display: inline-block;
		width: 100%;
		background: $main-color;
		color: #fff;
		&:hover {
			
			background: $hover;
		}
	}
}
.block-blog{

	padding: 10px;
	background: #fff;
	border-radius: 15px;
	position: sticky;
	top: 10px;
	@media(max-width: 1199px){
		margin-top: 20px;
	}
	.title{
		font-size: 35px;
		line-height: 56px;
		z-index: 9;
		padding: 0;
		margin: 0 0;
		position: relative;
		display: block;
		color: $main-color;
		font-weight: 700;
		text-align: left;
		margin-bottom: 20px;
		@media(max-width: 767px){
			font-size: 30px;
			line-height: inherit;
			text-align: center;
		}
		a{
			color: $main-color;
			&:hover{
				color: $hover;
			}
		}
	}
	.see-more{
		width: 100%;
	}
}
.thump-swatch{
	display: -ms-flexbox;
	display: flex;
	-ms-flex-wrap: wrap;
	flex-wrap: wrap;
}