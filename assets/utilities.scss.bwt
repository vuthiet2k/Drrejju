/* ============================================================================
   DR.REJU — UTILITIES + COMPONENTS (class dùng chung, prefix `dr-`)
   Đọc token từ :root (header_style.bwt). KHÔNG hardcode màu/size ở đây.
   Nguyên tắc: dựng section = GHÉP class có sẵn, không đẻ class mới.
   Không dùng clamp()/dvh/ch/&::before (giữ tương thích compiler Sapo).
   ============================================================================ */

/* ---------- LAYOUT ---------- */
.dr-container{ max-width: var(--container); margin: 0 auto; padding: 0 40px; }
.dr-section{ padding-top: var(--sp-80); padding-bottom: var(--sp-80); }
.dr-section--sm{ padding-top: var(--sp-48); padding-bottom: var(--sp-48); }

.dr-flex{ display: flex; }
.dr-flex-col{ display: flex; flex-direction: column; }
.dr-flex-center{ display: flex; align-items: center; justify-content: center; }
.dr-flex-between{ display: flex; align-items: center; justify-content: space-between; }
.dr-items-center{ align-items: center; }
.dr-items-end{ align-items: flex-end; }
.dr-wrap{ flex-wrap: wrap; }
.dr-full{ width: 100%; }
.dr-rel{ position: relative; }

.dr-grid{ display: grid; }
.dr-grid-2{ display: grid; grid-template-columns: repeat(2, 1fr); }
.dr-grid-3{ display: grid; grid-template-columns: repeat(3, 1fr); }
.dr-grid-4{ display: grid; grid-template-columns: repeat(4, 1fr); }

.dr-gap-8{ gap: var(--sp-8); }
.dr-gap-16{ gap: var(--sp-16); }
.dr-gap-24{ gap: var(--sp-24); }
.dr-gap-32{ gap: var(--sp-32); }

/* ---------- SPACING ---------- */
.dr-mt-8{ margin-top: var(--sp-8); }
.dr-mt-16{ margin-top: var(--sp-16); }
.dr-mt-24{ margin-top: var(--sp-24); }
.dr-mt-32{ margin-top: var(--sp-32); }
.dr-mb-8{ margin-bottom: var(--sp-8); }
.dr-mb-16{ margin-bottom: var(--sp-16); }
.dr-mb-24{ margin-bottom: var(--sp-24); }
.dr-mb-32{ margin-bottom: var(--sp-32); }
.dr-mb-48{ margin-bottom: var(--sp-48); }
.dr-p-16{ padding: var(--sp-16); }
.dr-p-24{ padding: var(--sp-24); }
.dr-p-32{ padding: var(--sp-32); }

/* ---------- TYPOGRAPHY ---------- */
.dr-h1{ font-family: var(--font-primary); font-weight: 700; font-size: var(--fs-3xl); line-height: 1.12; letter-spacing: .01em; }
.dr-h2{ font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-2xl); line-height: 1.2; }
.dr-h3{ font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-xl); line-height: 1.25; }
.dr-h4{ font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-lg); line-height: 1.3; }
.dr-body{ font-family: var(--font-secondary); font-weight: 400; font-size: var(--fs-base); line-height: 1.65; }
.dr-lead{ font-family: var(--font-secondary); font-weight: 400; font-size: var(--fs-md); line-height: 1.6; color: var(--text-soft); }
.dr-small{ font-size: var(--fs-sm); }
.dr-eyebrow{ font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-xs); letter-spacing: .2em; text-transform: uppercase; color: var(--accent); display: inline-block; }

.dr-bold{ font-weight: 700; }
.dr-medium{ font-weight: 500; }
.dr-light{ font-weight: 300; }
.dr-up{ text-transform: uppercase; }
.dr-center{ text-align: center; }
.dr-italic{ font-style: italic; }

/* ---------- COLOR / SURFACE ---------- */
.dr-c-text{ color: var(--text); }
.dr-c-soft{ color: var(--text-soft); }
.dr-c-accent{ color: var(--accent); }
.dr-c-ink{ color: var(--accent-ink); }

.dr-bg{ background: var(--bg); color: var(--text); }
.dr-bg-alt{ background: var(--bg-alt); color: var(--text); }
.dr-bg-soft{ background: var(--bg-soft); color: var(--text); }
.dr-bg-card{ background: var(--bg-card); color: var(--text); }
.dr-surface{ background: var(--surface); color: var(--text-on-surface); }

/* ---------- MEDIA / ẢNH (image-first) ---------- */
.dr-media{ position: relative; overflow: hidden; border-radius: var(--radius); }
.dr-media img{ display: block; width: 100%; height: 100%; object-fit: cover; }
.dr-img-cover{ display: block; width: 100%; height: 100%; object-fit: cover; }

.dr-ratio-1x1{ aspect-ratio: 1 / 1; }
.dr-ratio-4x5{ aspect-ratio: 4 / 5; }
.dr-ratio-16x9{ aspect-ratio: 16 / 9; }
.dr-ratio-16x10{ aspect-ratio: 16 / 10; }

/* overlay tối để chữ nổi trên ảnh (thêm <div class="dr-overlay"></div>) */
.dr-overlay{ position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,40,30,.15), rgba(10,40,30,.62)); }
.dr-overlay--left{ background: linear-gradient(90deg, rgba(10,40,30,.72), rgba(10,40,30,.15)); }

/* ---------- COMPONENT: NÚT ---------- */
.dr-btn{
  display: inline-flex; align-items: center; gap: var(--sp-8);
  font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-sm);
  letter-spacing: .06em; text-transform: uppercase;
  padding: 14px 30px; border-radius: var(--radius-pill);
  cursor: pointer; transition: all .25s ease; border: 2px solid transparent; text-align: center;
}
.dr-btn--primary{ background: var(--btn-bg); color: var(--btn-text); border-color: var(--btn-bg); }
.dr-btn--primary:hover{ background: var(--gold-lt); color: var(--btn-text); border-color: var(--gold-lt); transform: translateY(-2px); }
.dr-btn--outline{ background: transparent; color: var(--accent); border-color: var(--accent); }
.dr-btn--outline:hover{ background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

/* Ngữ cảnh NỀN TỐI (emerald): dùng cho hero/quiz/contact/section tối */
.dr-emerald{ background: var(--emerald); color: #fff; }
.dr-emerald .dr-h1, .dr-emerald .dr-h2, .dr-emerald .dr-h3, .dr-emerald .dr-h4{ color: #fff; }
.dr-emerald .dr-eyebrow, .dr-emerald .dr-c-accent{ color: var(--gold); }
.dr-emerald .dr-lead, .dr-emerald .dr-body{ color: rgba(255,255,255,.9); }
.dr-emerald .dr-c-soft{ color: rgba(255,255,255,.66); }
.dr-emerald .dr-btn--outline{ color: var(--gold); border-color: var(--gold); }
.dr-emerald .dr-btn--outline:hover{ background: var(--gold); color: var(--emerald); border-color: var(--gold); }
/* Hero (ảnh + overlay tối): eyebrow gold, chữ trắng */
.dr-hero .dr-eyebrow{ color: var(--gold); }
.dr-hero .dr-lead{ color: rgba(255,255,255,.92); }
.dr-hero .dr-btn--outline{ color: #fff; border-color: rgba(255,255,255,.7); }
.dr-hero .dr-btn--outline:hover{ background: #fff; color: var(--emerald); border-color: #fff; }
/* Thẻ nền trắng luôn giữ chữ tối, kể cả khi nằm trong section .dr-emerald */
.dr-card--surface, .dr-card--surface .dr-h1, .dr-card--surface .dr-h2, .dr-card--surface .dr-h3, .dr-card--surface .dr-h4{ color: var(--text-on-surface); }
.dr-card--surface .dr-body, .dr-card--surface .dr-small, .dr-card--surface .dr-lead, .dr-card--surface .dr-c-soft{ color: var(--text-soft); }
.dr-card--surface .dr-eyebrow, .dr-card--surface .dr-c-accent{ color: var(--accent); }
.dr-btn--ghost{ background: transparent; color: var(--text); border-color: transparent; padding-left: 0; padding-right: 0; }
.dr-btn--ghost:hover{ color: var(--accent); }

/* ---------- COMPONENT: THẺ / BADGE / TILE ---------- */
.dr-card{ background: var(--bg-card); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--sp-24); }
.dr-card--surface{ background: var(--surface); color: var(--text-on-surface); border-color: rgba(0,0,0,.06); }

.dr-badge{ display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .04em; padding: 5px 12px; border-radius: var(--radius-pill); background: var(--accent); color: var(--accent-ink); }

/* icon store (Font Awesome) — thay ảnh badge SVG */
.dr-appicon{ font-size: 30px; line-height: 1; color: inherit; transition: color .2s ease; }
.dr-appicon:hover{ color: var(--accent); }

/* ============================================================================
   HEADER + FOOTER — clone bố cục index.html, brand xanh #156b54 / vàng #fdf94e
   ============================================================================ */
/* ===== Sticky header 2 tầng (clone L'Oréal) — scroll: đậm & thu gọn ===== */
.dr-siteheader{ position: sticky; top: 0; z-index: 200; background: var(--brand-bg); color: var(--brand-text); transition: background .35s ease, box-shadow .35s ease; -webkit-backface-visibility: hidden; backface-visibility: hidden; transform: translate3d(0,0,0); }
.dr-siteheader.is-stuck{ background: var(--brand-bg-dk); box-shadow: 0 10px 30px rgba(0,0,0,.32); }

/* OVERLAY: đỉnh trang = trong suốt phủ lên hero (chữ trắng); cuộn = đặc emerald + thu gọn */
.dr-siteheader--overlay{ position: fixed; left: 0; right: 0; top: 0; background: linear-gradient(180deg, rgba(6,32,26,.55), rgba(6,32,26,0)); box-shadow: none; }
.dr-siteheader--overlay .dr-utilbar{ background: transparent; border-bottom: 1px solid rgba(255,255,255,.22); }
.dr-siteheader--overlay:not(.is-stuck) .dr-brand,
.dr-siteheader--overlay:not(.is-stuck) .dr-navmenu a,
.dr-siteheader--overlay:not(.is-stuck) .dr-navactions a,
.dr-siteheader--overlay:not(.is-stuck) .dr-util-left a,
.dr-siteheader--overlay:not(.is-stuck) .lang-btn{ color: #fff; }
.dr-siteheader--overlay:not(.is-stuck) .dr-navmenu a::after{ background: #fff; }
.dr-siteheader--overlay.is-stuck{ background: var(--brand-bg-dk); }
.dr-siteheader--overlay.is-stuck .dr-utilbar{ background: var(--brand-bg-dk); }

/* Utility bar (tầng trên — co lại khi scroll) */
.dr-utilbar{ background: var(--brand-bg-dk); border-bottom: 1px solid rgba(223,186,115,.16); max-height: 46px; opacity: 1; transition: max-height .35s ease, opacity .3s ease; }
.dr-utilbar-inner{ display: flex; align-items: center; justify-content: space-between; height: 40px; gap: 16px; font-family: var(--font-primary); font-size: var(--fs-xs); letter-spacing: .04em; }
.dr-util-left{ display: flex; gap: 24px; align-items: center; }
.dr-util-left a{ color: var(--brand-text); opacity: .85; display: inline-flex; align-items: center; gap: 6px; }
.dr-util-left a:hover{ opacity: 1; color: var(--gold); }
.dr-siteheader.is-stuck .dr-utilbar{ max-height: 0; opacity: 0; overflow: hidden; }

/* Main nav (tầng dưới — thấp xuống khi scroll) */
.dr-nav{ display: flex; align-items: center; justify-content: space-between; height: 84px; gap: var(--sp-24); transition: height .35s ease; }
.dr-siteheader.is-stuck .dr-nav{ height: 58px; }
/* Logo: ảnh admin (settings 'Đầu trang → Logo' = asset logo.png, nền trong suốt) — thu nhỏ khi scroll */
.dr-brand{ display: inline-flex; align-items: center; line-height: 0; }
.dr-brand-logo{ height: 46px; width: auto; max-width: 190px; object-fit: contain; transition: height .35s ease; }
.dr-siteheader.is-stuck .dr-brand-logo{ height: 34px; }
.dr-navmenu{ display: flex; gap: 28px; align-items: center; }
.dr-navmenu a{ font-family: var(--font-primary); font-weight: 500; font-size: var(--fs-sm); letter-spacing: .06em; text-transform: uppercase; color: var(--brand-text); opacity: .92; transition: color .2s, opacity .2s; white-space: nowrap; position: relative; padding: 4px 0; }
.dr-navmenu a:hover{ opacity: 1; color: var(--gold); }
.dr-navmenu a::after{ content: ""; position: absolute; left: 0; bottom: -2px; height: 2px; width: 0; background: var(--gold); transition: width .25s; }
.dr-navmenu a:hover::after{ width: 100%; }
.dr-navactions{ display: flex; align-items: center; gap: 20px; font-size: 1.05rem; color: var(--brand-text); }
.dr-navactions a{ color: var(--brand-text); position: relative; display: inline-flex; }
.dr-navactions a:hover{ color: var(--gold); }
.dr-cart-count{ position: absolute; top: -9px; right: -10px; background: var(--gold); color: var(--emerald); font-family: var(--font-primary); font-weight: 700; font-size: .58rem; min-width: 16px; height: 16px; border-radius: 999px; display: flex; align-items: center; justify-content: center; padding: 0 3px; }
.dr-burger{ display: none; background: none; border: 0; color: var(--brand-text); font-size: 1.3rem; cursor: pointer; }
.dr-navmenu-mobile{ display: none; flex-direction: column; background: var(--brand-bg-dk); border-top: 1px solid rgba(223,186,115,.16); }
.dr-navmenu-mobile a{ color: var(--brand-text); font-family: var(--font-primary); font-weight: 500; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: .05em; padding: 13px 40px; border-bottom: 1px solid rgba(255,255,255,.08); }
.dr-navmenu-mobile.is-open{ display: flex; }
/* Laptop nhỏ: bó gọn gap + cỡ chữ nav cho vừa 6 mục tiếng Việt dài, chưa cần hamburger */
@media (max-width: 1439px){
  .dr-nav{ gap: 16px; }
  .dr-navmenu{ gap: 13px; }
  .dr-navmenu a{ font-size: .8rem; letter-spacing: .015em; }
}
/* Dưới 1280px: 6 nhãn dài không còn đủ chỗ → thu về nút hamburger (mobile menu) */
@media (max-width: 1279px){
  .dr-navmenu{ display: none; }
  .dr-burger{ display: inline-flex; }
}
@media (max-width: 991px){
  .dr-util-left{ display: none; }
  .dr-nav{ height: 62px; }
  .dr-siteheader.is-stuck .dr-nav{ height: 54px; }
}

/* Footer */
.dr-footer{ background: var(--brand-bg); color: var(--brand-text); padding: 64px 0 0; }
.dr-footer a{ color: var(--brand-text); opacity: .9; }
.dr-footer a:hover{ opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
.dr-footer-grid{ display: grid; grid-template-columns: 1.6fr 1fr 1.2fr 1fr; gap: 40px; padding-bottom: 48px; }
.dr-footer-grid h4{ font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-sm); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 18px; color: var(--brand-text); }
.dr-footer-grid ul{ list-style: none; padding: 0; margin: 0; }
.dr-footer-grid li{ margin-bottom: 10px; opacity: .9; }
.dr-foot-brand .dr-brand{ margin-bottom: 14px; }
.dr-foot-social{ display: flex; gap: 14px; font-size: 1.1rem; margin-top: 16px; }
.dr-foot-social a{ width: 40px; height: 40px; border: 1px solid rgba(223,186,115,.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.dr-foot-social a:hover{ background: var(--gold); color: var(--emerald); border-color: var(--gold); }
.dr-foot-contact li{ display: flex; gap: 10px; align-items: flex-start; }
.dr-foot-contact i{ margin-top: 5px; }
.dr-foot-apps{ display: flex; gap: 14px; margin-top: 14px; }
.dr-foot-bottom{ border-top: 1px solid rgba(223,186,115,.22); padding: 20px 0; font-size: var(--fs-xs); opacity: .85; }
.dr-foot-bottom-inner{ display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.dr-foot-legal{ display: flex; flex-wrap: wrap; gap: 20px; }
.dr-foot-legal span{ display: inline-flex; align-items: center; gap: 7px; }
@media (max-width: 767px){ .dr-foot-bottom-inner{ flex-direction: column; align-items: flex-start; } }
@media (max-width: 991px){ .dr-footer-grid{ grid-template-columns: 1fr 1fr; gap: 32px; } }
@media (max-width: 560px){ .dr-footer-grid{ grid-template-columns: 1fr; } }

/* ===== Language switcher (Google Translate) ===== */
.dr-topbar-inner{ display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.dr-topbar-inner .dr-topbar-msg{ flex: 1; text-align: center; }
.lang-switcher{ position: relative; flex: none; }
.lang-btn{ display: inline-flex; align-items: center; gap: 7px; background: none; border: 0; color: var(--brand-text); font-family: var(--font-primary); font-size: var(--fs-xs); letter-spacing: .04em; cursor: pointer; padding: 0; text-transform: none; }
.lang-flag-img{ width: 20px; height: 14px; border-radius: 2px; object-fit: cover; display: block; }
.lang-caret{ font-size: 9px; opacity: .8; }
.lang-list{ position: absolute; top: calc(100% + 10px); right: 0; min-width: 160px; background: var(--surface); color: var(--text); border-radius: var(--radius-sm); box-shadow: var(--shadow); list-style: none; margin: 0; padding: 6px; z-index: 300; display: none; }
.lang-list.open{ display: block; }
.lang-list li{ display: flex; align-items: center; gap: 9px; padding: 9px 11px; border-radius: 6px; cursor: pointer; font-size: var(--fs-sm); color: var(--text); font-family: var(--font-secondary); text-transform: none; letter-spacing: 0; }
.lang-list li:hover{ background: var(--bg-soft); }
.lang-list li.active{ background: var(--bg-soft); font-weight: 600; }

/* Ẩn giao diện mặc định của Google Translate (banner/tooltip/highlight/iframe mới) */
.skiptranslate,
iframe.skiptranslate,
.VIpgJd-ZVi9od-ORHb-OEVmcd,
.goog-te-banner-frame.skiptranslate, .goog-te-gadget-icon, #goog-gt-tt, .goog-te-balloon-frame{ display: none !important; }
.goog-tooltip, .goog-tooltip:hover{ display: none !important; }
.goog-text-highlight{ background: none !important; box-shadow: none !important; }
/* GT chèn iframe/banner đẩy body xuống 40px và có thể gây scroll ngang → khóa lại */
body{ top: 0 !important; position: static !important; }
html{ overflow-x: clip; }
body{ top: 0 !important; }

/* nội dung nổi trên ảnh */
.dr-z2{ position: relative; z-index: 2; }
/* placeholder ảnh (chờ banner của team) — nền brand + icon */
.dr-ph{ background: linear-gradient(135deg, var(--bg-card), var(--bg-soft)); display: flex; align-items: center; justify-content: center; color: var(--text-soft); }
.dr-ph i{ font-size: 2.4rem; opacity: .5; }

/* tile ảnh có chữ đè (dùng cho grid vấn đề da / location) */
.dr-tile{ position: relative; overflow: hidden; border-radius: var(--radius); display: flex; align-items: flex-end; color: var(--surface); min-height: 320px; }
.dr-tile img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.dr-tile:hover img{ transform: scale(1.05); }
.dr-tile__in{ position: relative; z-index: 2; padding: var(--sp-24); width: 100%; }

/* ---------- COMPONENT: BANNER full-bleed (ảnh + 1 câu dẫn + CTA) ---------- */
.dr-banner{ position: relative; overflow: hidden; display: flex; align-items: center; min-height: 460px; color: var(--surface); }
.dr-banner > img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.dr-banner__in{ position: relative; z-index: 2; width: 100%; }

/* ---------- COMPONENT: HERO ---------- */
.dr-hero{ position: relative; overflow: hidden; display: flex; align-items: end; min-height: 100vh; color: var(--surface); }
.dr-hero > img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.dr-hero__in{ position: relative; z-index: 2; margin-bottom: var(--sp-48); }

/* ---------- CAROUSEL cuộn ngang ---------- */
.dr-scroll-x{ display: flex; gap: var(--sp-24); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; padding-bottom: 6px; }
.dr-scroll-x::-webkit-scrollbar{ display: none; }
.dr-scroll-x > *{ flex: 0 0 auto; scroll-snap-align: start; }

/* ---------- PRODUCT CARD (ảnh dạng swiper, KHÔNG viền, KHÔNG bo góc) ---------- */
.dr-pcard-grid{ display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 20px; }
.dr-pcard{ display: flex; flex-direction: column; }
.dr-pcard-media{ position: relative; overflow: hidden; background: #fff; border-radius: 0; }
.dr-pcard-single, .dr-pcard-swiper .swiper-slide > a{ display: block; position: relative; padding-bottom: 125%; }
.dr-pcard-media img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0; }
.dr-pcard-swiper{ width: 100%; }
.dr-pcard-swiper .swiper-slide{ width: 100%; flex-shrink: 0; background: #fff; }
.dr-pcard-nav{ position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.9); color: var(--text); cursor: pointer; opacity: 0; transition: opacity .2s ease; font-size: 12px; }
.dr-pcard-media:hover .dr-pcard-nav{ opacity: 1; }
.dr-pcard-nav:hover{ background: #fff; }
.dr-pcard-prev{ left: 10px; }
.dr-pcard-next{ right: 10px; }
.dr-pcard-dots{ position: absolute; bottom: 10px; left: 0; right: 0; z-index: 3; text-align: center; }
.dr-pcard-dots .swiper-pagination-bullet{ background: rgba(255,255,255,.7); opacity: 1; margin: 0 3px; }
.dr-pcard-dots .swiper-pagination-bullet-active{ background: var(--gold); }
.dr-pcard-body{ padding: 14px 2px 0; display: flex; flex-direction: column; gap: 6px; }
.dr-pcard-vendor{ font-family: var(--font-primary); font-size: var(--fs-xs); letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
.dr-pcard-name{ font-family: var(--font-primary); font-weight: 500; font-size: var(--fs-sm); line-height: 1.4; color: var(--text); transition: color .2s ease; }
.dr-pcard-name:hover{ color: var(--accent); }
.dr-pcard-price{ font-family: var(--font-primary); font-weight: 700; font-size: var(--fs-md); color: var(--text); }
/* Badge / tag góc trên phải (vuông, không bo góc) */
.dr-pcard-badge{ position: absolute; top: 12px; right: 12px; z-index: 4; padding: 5px 9px; background: var(--emerald); color: #fff; font-family: var(--font-primary); font-weight: 600; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; line-height: 1; max-width: calc(100% - 24px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dr-pcard-badge--soft{ background: rgba(255,255,255,.92); color: var(--text); }
/* Icon giỏ góc dưới trái */
.dr-pcard-add{ position: absolute; left: 12px; bottom: 12px; z-index: 4; margin: 0; }
.dr-pcard-addbtn{ width: 42px; height: 42px; flex: none; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 50%; background: #fff; color: var(--emerald); font-size: 15px; cursor: pointer; box-shadow: 0 6px 16px rgba(6,32,26,.18); transition: background .2s ease, color .2s ease, transform .2s ease; }
.dr-pcard-addbtn:hover{ background: var(--emerald); color: #fff; transform: translateY(-2px); }

/* ============================================================================
   RESPONSIVE (breakpoint theme: 991 / 767 / 480)
   ============================================================================ */
@media (max-width: 991px){
  .dr-grid-3, .dr-grid-4{ grid-template-columns: repeat(2, 1fr); }
  .dr-pcard-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dr-section{ padding-top: var(--sp-56); padding-bottom: var(--sp-56); }
}
@media (max-width: 767px){
  .dr-container{ padding: 0 22px; }
  .dr-grid-2, .dr-grid-3, .dr-grid-4{ grid-template-columns: 1fr; }
  /* Sản phẩm (Flash Sale / Khuyên dùng / TPCN): 1 hàng thẻ cuộn ngang edge-to-edge */
  .dr-pcard-grid{
    display: flex; grid-template-columns: none;
    gap: 12px;
    margin-left: -22px; margin-right: -22px;   /* bù padding container → full-bleed */
    padding: 0 22px 6px;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory; scroll-padding-left: 22px;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .dr-pcard-grid::-webkit-scrollbar{ display: none; }
  .dr-pcard-grid > .dr-pcard{ flex: 0 0 auto; width: 60%; max-width: 240px; scroll-snap-align: start; }
  .dr-section{ padding-top: var(--sp-48); padding-bottom: var(--sp-48); }
  .dr-h1{ font-size: var(--fs-2xl); }
  .dr-h2{ font-size: var(--fs-xl); }
  .dr-banner{ min-height: 420px; }
}

/* ============================================================================
   MOBILE SYSTEM (≤991px): drawer menu + search overlay + bottom nav
   ============================================================================ */
@media (max-width: 991px){
  .dr-utilbar{ display: none; }               /* ngôn ngữ chuyển vào drawer */
  .dr-nav{ height: 60px; }
  .dr-siteheader.is-stuck .dr-nav{ height: 54px; }
  .dr-hide-mobile{ display: none !important; }
  body{ padding-bottom: 58px; }               /* chừa chỗ cho bottom nav */
  .dr-bottomnav{ display: block; }
}
@media (min-width: 992px){
  .dr-drawer, .dr-backdrop, .dr-searchov, .dr-bottomnav{ display: none !important; }
}
body.dr-noscroll{ overflow: hidden; }

/* ---------- Drawer menu (trượt từ trái) ---------- */
.dr-drawer{ position: fixed; top: 0; bottom: 0; left: 0; width: 86%; max-width: 360px; background: var(--brand-bg-dk); color: var(--brand-text); z-index: 1200; transform: translateX(-100%); transition: transform .3s ease; display: flex; flex-direction: column; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.dr-drawer.is-open{ transform: translateX(0); }
.dr-drawer__head{ display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid rgba(223,186,115,.18); }
.dr-drawer__head img{ height: 38px; width: auto; }
.dr-drawer__close{ background: none; border: 0; color: var(--brand-text); font-size: 1.5rem; line-height: 1; cursor: pointer; padding: 4px 8px; }
.dr-drawer__nav{ display: flex; flex-direction: column; padding: 6px 0; }
.dr-drawer__nav a{ display: block; padding: 14px 20px; color: var(--brand-text); font-family: var(--font-primary); font-weight: 500; font-size: var(--fs-sm); letter-spacing: .05em; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,.06); }
.dr-drawer__nav a:hover{ color: var(--gold); }
.dr-drawer__section{ padding: 16px 20px; border-top: 1px solid rgba(223,186,115,.18); }
.dr-drawer__section-title{ font-family: var(--font-primary); font-size: var(--fs-xs); letter-spacing: .14em; text-transform: uppercase; opacity: .7; margin-bottom: 12px; }
.dr-drawer__util{ display: flex; flex-direction: column; gap: 12px; margin-bottom: 4px; }
.dr-drawer__util a{ color: var(--brand-text); display: inline-flex; align-items: center; gap: 10px; font-size: var(--fs-sm); }
.dr-drawer__util a:hover{ color: var(--gold); }
.dr-drawer__langs{ display: flex; flex-wrap: wrap; gap: 8px; }
.dr-drawer__lang{ display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; background: rgba(255,255,255,.06); border: 1px solid rgba(223,186,115,.2); border-radius: var(--radius-pill); color: var(--brand-text); font-family: var(--font-secondary); font-size: var(--fs-xs); cursor: pointer; }
.dr-drawer__lang img{ width: 18px; height: 13px; border-radius: 2px; object-fit: cover; }
.dr-drawer__lang.is-active{ background: var(--gold); color: var(--emerald); border-color: var(--gold); }

.dr-backdrop{ position: fixed; inset: 0; background: rgba(6,32,26,.55); z-index: 1150; opacity: 0; visibility: hidden; transition: opacity .3s ease; }
.dr-backdrop.is-open{ opacity: 1; visibility: visible; }

/* ---------- Search overlay (toàn màn hình) ---------- */
.dr-searchov{ position: fixed; inset: 0; z-index: 1300; background: var(--surface); color: var(--text); display: flex; flex-direction: column; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .22s ease; }
.dr-searchov.is-open{ opacity: 1; visibility: visible; pointer-events: auto; }
.dr-searchov__head{ display: flex; align-items: center; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
.dr-searchov__back{ display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 44px; background: none; border: 0; color: var(--text); cursor: pointer; flex: none; }
.dr-searchov__form{ flex: 1; display: flex; align-items: center; height: 44px; padding: 0 6px 0 14px; background: var(--bg-soft); border-radius: var(--radius-sm); min-width: 0; margin: 0; }
.dr-searchov__input{ flex: 1; width: 100%; height: 100%; border: 0; background: transparent; outline: none; font-family: var(--font-primary); font-size: var(--fs-base); color: var(--text); min-width: 0; }
.dr-searchov__input::placeholder{ color: var(--text-soft); }
.dr-searchov__submit{ display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 32px; flex: none; background: var(--emerald); color: #fff; border: 0; border-radius: 6px; cursor: pointer; }
.dr-searchov__body{ flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.dr-searchov__section{ padding: 18px 16px 4px; }
.dr-searchov__label{ margin: 0 0 12px; font-family: var(--font-primary); font-size: var(--fs-xs); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text-soft); }
.dr-searchov__tags{ display: flex; flex-wrap: wrap; gap: 8px; }
.dr-searchov__tag{ display: inline-flex; align-items: center; padding: 8px 16px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius-pill); font-size: var(--fs-sm); color: var(--text); transition: background .15s ease, color .15s ease; }
.dr-searchov__tag:hover{ background: var(--emerald); color: #fff; border-color: var(--emerald); }
.dr-searchov__recent{ list-style: none; margin: 0; padding: 0; }
.dr-searchov__recent li{ display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.dr-searchov__recent a{ flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 0; color: var(--text); font-size: var(--fs-base); min-width: 0; }
.dr-searchov__recent a span{ white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dr-searchov__recent-del{ width: 40px; height: 44px; background: none; border: 0; color: var(--text-soft); cursor: pointer; flex: none; }

/* ---------- Bottom nav (5 tab, cố định đáy) ---------- */
.dr-bottomnav{ position: fixed; left: 0; right: 0; bottom: 0; z-index: 1100; background: var(--brand-bg-dk); border-top: 1px solid rgba(223,186,115,.2); }
.dr-bottomnav__list{ display: flex; list-style: none; margin: 0; padding: 0; }
.dr-bottomnav__item{ flex: 1; }
.dr-bottomnav__item a, .dr-bottomnav__item button{ display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; width: 100%; min-height: 56px; padding: 8px 2px; background: none; border: 0; color: var(--brand-text); font-family: var(--font-primary); font-size: 10px; letter-spacing: .02em; cursor: pointer; position: relative; }
.dr-bottomnav__item i{ font-size: 18px; line-height: 1; }
.dr-bottomnav__item.is-active a, .dr-bottomnav__item.is-active button{ color: var(--gold); }
.dr-bottomnav__badge{ position: absolute; top: 6px; left: 50%; margin-left: 5px; min-width: 15px; height: 15px; padding: 0 3px; border-radius: 999px; background: var(--gold); color: var(--emerald); font-size: 9px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

/* ============================================================================
   MOBILE POLISH (≤991 / ≤767 / ≤480) — nền tảng "gọn + sang" cho màn nhỏ
   ----------------------------------------------------------------------------
   Nguyên tắc: mobile KHÔNG phải desktop co nhỏ. Ba đòn tác động lớn nhất:
     1) Thang chữ riêng — lead 18px trên màn 360px là nguồn "tường chữ" số 1
     2) Nhịp section thấp hơn + khoảng cách tiêu đề→nội dung ngắn hơn
     3) Nút nhỏ hơn về chữ/padding nhưng vẫn ≥44px chiều cao chạm
   Đặt Ở ĐÂY (không rải trong từng snippet) để mọi section cùng một nhịp.
   Khối này CỐ TÌNH nằm cuối file: cùng độ đặc hiệu thì rule sau thắng, nên nó
   đè được các @media phía trên mà không cần !important.
   ⚠️ Phạm vi: toàn theme (utilities dùng chung), không chỉ trang chủ.
   ============================================================================ */
@media (max-width: 991px){
  .dr-section{ padding-top: var(--sp-48); padding-bottom: var(--sp-48); }
  .dr-h1{ font-size: 2.25rem; }
  .dr-lead{ font-size: var(--fs-base); }
}
@media (max-width: 767px){
  .dr-section{ padding-top: 40px; padding-bottom: 40px; }

  /* Thang chữ mobile */
  .dr-h1{ font-size: 1.75rem; line-height: 1.18; }
  .dr-h2{ font-size: 1.375rem; line-height: 1.25; }
  .dr-h3{ font-size: var(--fs-md); }
  .dr-h4{ font-size: var(--fs-base); }
  .dr-lead{ font-size: .9375rem; line-height: 1.6; }
  .dr-body{ font-size: .9375rem; }
  .dr-eyebrow{ font-size: 11px; letter-spacing: .14em; }
  .dr-badge{ font-size: 10px; padding: 4px 10px; }

  /* Nút: chữ 12px + padding 13/22 → cao ~46px, vẫn đạt touch target */
  .dr-btn{ padding: 13px 22px; font-size: 12px; letter-spacing: .05em; }
  /* Cảm ứng không có hover thật → bỏ nhấc nút, tránh dính trạng thái sau khi tap */
  .dr-btn--primary:hover, .dr-btn--outline:hover{ transform: none; }

  /* Khoảng nghỉ desktop (48/32px) quá rộng khi bề ngang chỉ 360px */
  .dr-mb-48{ margin-bottom: var(--sp-24); }
  .dr-mb-32{ margin-bottom: 20px; }
  .dr-gap-32{ gap: var(--sp-24); }

  /* ── Đầu section "tiêu đề + Xem tất cả": prose bỏ, link về dạng chữ ──
     Chỉ nhắm .dr-lead TRONG khối head — đoạn .dr-lead báo "chưa có sản phẩm"
     nằm ngoài head và phải luôn hiện, nếu không admin mất chỉ dẫn cấu hình. */
  #products .dr-flex-between .dr-lead,
  #tpcn .dr-flex-between .dr-lead{ display: none; }
  /* Để tiêu đề xuống dòng tự nhiên rồi link nằm dòng dưới: nhồi cả h2 dài lẫn
     link vào 1 hàng ở bề ngang 360px sẽ bó h2 còn ~200px → 4 dòng chữ vụn. */
  #products .dr-flex-between,
  #tpcn .dr-flex-between,
  #blog .dr-flex-between{ gap: 10px; }
  #products .dr-flex-between .dr-btn--outline,
  #tpcn .dr-flex-between .dr-btn--outline{
    flex: none; min-height: 40px; padding: 0; border: 0; background: none;
    color: var(--accent); font-size: 11px; letter-spacing: .1em;
  }
  #products .dr-flex-between .dr-btn--outline::after,
  #tpcn .dr-flex-between .dr-btn--outline::after{ content: "→"; margin-left: 6px; }
  #blog .dr-flex-between .dr-eyebrow{ flex: none; font-size: 11px; }
}
@media (max-width: 480px){
  .dr-section{ padding-top: var(--sp-32); padding-bottom: var(--sp-32); }
  .dr-h1{ font-size: 1.625rem; }
}
