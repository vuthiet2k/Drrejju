{% comment %}
  DR.REJU — Bộ Vector SVG Icons Y Khoa Chuyên Biệt (dr_hue_icons_svg.bwt)
  Cách dùng: {% include 'dr_hue_icons_svg', icon: 'user_doctor' %}
{% endcomment %}

{% case icon %}
  {% when 'user_doctor' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
      <path d="M12 14v4"></path>
      <path d="M10 16h4"></path>
    </svg>

  {% when 'lightbulb' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M9 18h6"></path>
      <path d="M10 22h4"></path>
      <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"></path>
      <path d="M12 6v4"></path>
      <path d="M10 8h4"></path>
    </svg>

  {% when 'clinic_heart' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M12 2L3 9v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9l-9-7z"></path>
      <path d="M9 22V12h6v10"></path>
      <path d="M12 6v3"></path>
      <path d="M10.5 7.5h3"></path>
    </svg>

  {% when 'book_open' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
    </svg>

  {% when 'doctor_exam' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
      <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
      <path d="M9 12h6"></path>
      <path d="M9 16h4"></path>
      <circle cx="12" cy="12" r="1"></circle>
    </svg>

  {% when 'dermoscopy' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M21 21l-4.35-4.35"></path>
      <circle cx="11" cy="11" r="2.5"></circle>
      <path d="M11 6v1"></path>
      <path d="M11 15v1"></path>
      <path d="M6 11h1"></path>
      <path d="M15 11h1"></path>
    </svg>

  {% when 'prescription' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="12" y1="18" x2="12" y2="12"></line>
      <line x1="9" y1="15" x2="15" y2="15"></line>
    </svg>

  {% when 'shield_medical' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <line x1="12" y1="8" x2="12" y2="14"></line>
      <line x1="9" y1="11" x2="15" y2="11"></line>
    </svg>

  {% when 'chat_heart' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      <path d="M12 9.5c-.8-1-2.2-1-2.7 0a1.8 1.8 0 0 0 0 2.5l2.7 2.7 2.7-2.7a1.8 1.8 0 0 0 0-2.5c-.5-1-1.9-1-2.7 0z"></path>
    </svg>

  {% when 'cycle_leaf' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="dr-icon">
      <path d="M21.5 2v6h-6"></path>
      <path d="M2.5 22v-6h6"></path>
      <path d="M20.49 15a9 9 0 0 1-15.36 3.36L2.5 16"></path>
      <path d="M3.51 9a9 9 0 0 1 15.36-3.36L21.5 8"></path>
      <path d="M12 9c-1.7 0-3 1.3-3 3s1.3 3 3 3 3-1.3 3-3-1.3-3-3-3z"></path>
    </svg>
{% endcase %}
