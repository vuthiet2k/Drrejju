{% comment %} DR.REJU — Hệ thống mobile (≤991px): drawer menu + search overlay + bottom nav.
   Ngôn ngữ trong drawer trigger lại switcher gốc ở util bar (#langList). {% endcomment %}
{% assign menu_alias = settings.main_menu | default: 'main-menu' %}
{% assign navm = linklists[menu_alias] %}

{% comment %} Active tab cho bottom nav {% endcomment %}
{% assign mbnav = '' %}
{% if template contains 'index' %}{% assign mbnav = 'home' %}
{% elsif template contains 'collection' or template contains 'product' %}{% assign mbnav = 'products' %}
{% elsif template contains 'blog' or template contains 'article' %}{% assign mbnav = 'blog' %}
{% elsif template contains 'cart' %}{% assign mbnav = 'cart' %}
{% elsif template contains 'customer' or template contains 'account' or template contains 'login' or template contains 'register' or template contains 'order' or template contains 'address' %}{% assign mbnav = 'account' %}
{% endif %}

{% comment %} ============ DRAWER MENU ============ {% endcomment %}
<div class="dr-backdrop" id="drBackdrop"></div>
<aside class="dr-drawer" id="drDrawer" aria-label="Menu">
  <div class="dr-drawer__head">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ store.name | default: 'Dr.REJU' }}">
    <button class="dr-drawer__close" id="drDrawerClose" type="button" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
  </div>
  {% comment %} Nhánh có link con → <details> gập lại. {% endcomment %}
  <nav class="dr-drawer__nav">
    {% for link in navm.links %}
      {% if link.links.size > 0 %}
      <details class="dr-drawer__grp">
        <summary>
          <span>{{ link.title }}</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </summary>
        <span class="dr-drawer__subs">
          <a href="{{ link.url }}" class="dr-drawer__all">Tất cả {{ link.title | downcase }}</a>
          {% for sub in link.links %}<a href="{{ sub.url }}">{{ sub.title }}</a>{% endfor %}
        </span>
      </details>
      {% else %}
      <a href="{{ link.url }}">{{ link.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="dr-drawer__section">
    <div class="dr-drawer__util">
      <a href="/account"><i class="fa-regular fa-user"></i> Tài khoản</a>
      <a href="tel:{{ settings.phone | default: store.phone_number | remove: ' ' }}"><i class="fa-solid fa-phone"></i> {{ settings.phone | default: store.phone_number }}</a>
      <a href="/dat-lich"><i class="fa-regular fa-calendar-check"></i> Đặt lịch</a>
      <a href="{{ settings.social_zalo_link | default: 'https://zalo.me/' }}"><i class="fa-solid fa-comment-dots"></i> Tư vấn Zalo</a>
    </div>
  </div>
  <div class="dr-drawer__section">
    <p class="dr-drawer__section-title">Ngôn ngữ</p>
    <div class="dr-drawer__langs">
      <button class="dr-drawer__lang" data-drlang="vi" type="button"><img src="{{ 'flag-vn.svg' | asset_url }}" alt=""> Tiếng Việt</button>
      <button class="dr-drawer__lang" data-drlang="en" type="button"><img src="{{ 'flag-us.svg' | asset_url }}" alt=""> English</button>
      <button class="dr-drawer__lang" data-drlang="zh-CN" type="button"><img src="{{ 'flag-cn.svg' | asset_url }}" alt=""> 中文</button>
      <button class="dr-drawer__lang" data-drlang="ja" type="button"><img src="{{ 'flag-jp.svg' | asset_url }}" alt=""> 日本語</button>
      <button class="dr-drawer__lang" data-drlang="ko" type="button"><img src="{{ 'flag-kr.svg' | asset_url }}" alt=""> 한국어</button>
    </div>
  </div>
</aside>

{% comment %} ============ SEARCH OVERLAY ============ {% endcomment %}
<div class="dr-searchov" id="drSearchOv" aria-hidden="true">
  <div class="dr-searchov__head">
    <button class="dr-searchov__back" id="drSearchBack" type="button" aria-label="Quay lại"><i class="fa-solid fa-arrow-left"></i></button>
    <form class="dr-searchov__form" action="/search" method="get" id="drSearchForm" role="search">
      <input type="text" name="query" id="drSearchInput" class="dr-searchov__input" placeholder="Tìm sản phẩm, thành phần..." autocomplete="off" spellcheck="false" enterkeyhint="search">
      <input type="hidden" name="type" value="product">
    </form>
    <button type="submit" form="drSearchForm" class="dr-searchov__submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button>
  </div>
  <div class="dr-searchov__body">
    <div class="dr-searchov__section" id="drSearchResWrap" hidden>
      <p class="dr-searchov__label" id="drSearchResLb">Sản phẩm</p>
      <div id="drSearchRes"></div>
      <a class="dr-searchov__all" id="drSearchAll" href="/search">Xem tất cả kết quả <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="dr-searchov__section" id="drSearchRecent" style="display:none">
      <p class="dr-searchov__label">Tìm kiếm gần đây</p>
      <ul class="dr-searchov__recent" id="drSearchRecentList"></ul>
    </div>
    <div class="dr-searchov__section">
      <p class="dr-searchov__label">Đề xuất phổ biến</p>
      <div class="dr-searchov__tags">
        {% assign sugg = settings.header_search_suggest_list | default: 'Retinol,Chống lão hoá,Trị mụn,Kem chống nắng,Serum,Cấp ẩm' | split: ',' %}
        {% for kw in sugg %}{% assign kwc = kw | strip %}{% if kwc != blank %}<a class="dr-searchov__tag" href="/search?query={{ kwc | url_encode }}&type=product">{{ kwc }}</a>{% endif %}{% endfor %}
      </div>
    </div>
  </div>
</div>

{% comment %} ============ BOTTOM NAV (P0-02 Standard) ============ {% endcomment %}
<nav class="dr-bottomnav" aria-label="Điều hướng nhanh">
  <ul class="dr-bottomnav__list">
    <li class="dr-bottomnav__item{% if mbnav == 'home' %} is-active{% endif %}"><a href="/"><i class="fa-solid fa-house"></i>Trang chủ</a></li>
    <li class="dr-bottomnav__item{% if mbnav == 'products' %} is-active{% endif %}"><a href="/collections/all"><i class="fa-solid fa-spa"></i>Sản phẩm</a></li>
    <li class="dr-bottomnav__item{% if mbnav == 'blog' %} is-active{% endif %}"><a href="/blogs/all"><i class="fa-solid fa-newspaper"></i>Tin y khoa</a></li>
    <li class="dr-bottomnav__item{% if mbnav == 'cart' %} is-active{% endif %}"><a href="/cart"><i class="fa-solid fa-bag-shopping"></i>Giỏ hàng{% if cart.item_count > 0 %}<span class="dr-bottomnav__badge count_item_pr">{{ cart.item_count }}</span>{% endif %}</a></li>
    <li class="dr-bottomnav__item{% if mbnav == 'account' %} is-active{% endif %}"><a href="/account"><i class="fa-regular fa-user"></i>Tài khoản</a></li>
  </ul>
</nav>

<script>
(function(){
  var body = document.body;
  var drawer = document.getElementById('drDrawer'),
      backdrop = document.getElementById('drBackdrop'),
      burger = document.getElementById('drBurger'),
      closeBtn = document.getElementById('drDrawerClose');

  function openDrawer(){ if(!drawer) return; drawer.classList.add('is-open'); if(backdrop) backdrop.classList.add('is-open'); body.classList.add('dr-noscroll'); }
  function closeDrawer(){ if(!drawer) return; drawer.classList.remove('is-open'); if(backdrop) backdrop.classList.remove('is-open'); body.classList.remove('dr-noscroll'); }
  if(burger) burger.addEventListener('click', function(e){ e.preventDefault(); openDrawer(); });
  if(closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if(backdrop) backdrop.addEventListener('click', closeDrawer);

  if(drawer){
    drawer.querySelectorAll('[data-drlang]').forEach(function(b){
      b.addEventListener('click', function(){
        var li = document.querySelector('#langList li[data-lang="' + b.getAttribute('data-drlang') + '"]');
        if(li) li.click();
        closeDrawer();
      });
    });
  }

  /* Search overlay */
  var ov = document.getElementById('drSearchOv'),
      back = document.getElementById('drSearchBack'),
      input = document.getElementById('drSearchInput'),
      form = document.getElementById('drSearchForm'),
      recentBox = document.getElementById('drSearchRecent'),
      recentList = document.getElementById('drSearchRecentList');
  var RKEY = 'dr_recent_search', RMAX = 8;

  function getRecent(){ try{ return JSON.parse(localStorage.getItem(RKEY) || '[]'); }catch(e){ return []; } }
  function saveRecent(t){ t = (t||'').trim(); if(!t) return; var l = getRecent().filter(function(x){ return x.toLowerCase() !== t.toLowerCase(); }); l.unshift(t); try{ localStorage.setItem(RKEY, JSON.stringify(l.slice(0, RMAX))); }catch(e){} }
  function delRecent(i){ var l = getRecent(); l.splice(i, 1); try{ localStorage.setItem(RKEY, JSON.stringify(l)); }catch(e){} }
  function renderRecent(){
    if(!recentBox || !recentList) return;
    var items = getRecent();
    if(!items.length){ recentBox.style.display = 'none'; recentList.innerHTML = ''; return; }
    recentBox.style.display = '';
    recentList.innerHTML = items.map(function(kw, i){
      var enc = encodeURIComponent(kw), safe = kw.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      return '<li><a href="/search?query=' + enc + '&type=product"><i class="fa-solid fa-clock-rotate-left"></i><span>' + safe + '</span></a>'
           + '<button type="button" class="dr-searchov__recent-del" data-i="' + i + '" aria-label="Xoá"><i class="fa-solid fa-xmark"></i></button></li>';
    }).join('');
  }
  function openOv(){ if(!ov) return; ov.classList.add('is-open'); ov.setAttribute('aria-hidden','false'); body.classList.add('dr-noscroll'); renderRecent(); setTimeout(function(){ if(input) input.focus(); }, 80); }
  function closeOv(){ if(!ov) return; ov.classList.remove('is-open'); ov.setAttribute('aria-hidden','true'); body.classList.remove('dr-noscroll'); }

  document.querySelectorAll('[data-dr-search-open]').forEach(function(o){
    o.addEventListener('click', function(e){
      if(window.innerWidth > 991) return;
      e.preventDefault(); closeDrawer(); openOv();
    });
  });
  if(back) back.addEventListener('click', closeOv);
  if(form) form.addEventListener('submit', function(){ if(input && input.value.trim()) saveRecent(input.value.trim()); });
  if(recentList) recentList.addEventListener('click', function(e){
    var b = e.target.closest('.dr-searchov__recent-del'); if(!b) return;
    e.preventDefault(); var i = parseInt(b.getAttribute('data-i'), 10);
    if(!isNaN(i)){ delRecent(i); renderRecent(); }
  });

  document.addEventListener('keydown', function(e){ if(e.key === 'Escape'){ closeDrawer(); closeOv(); } });

  if(location.hash === '#dr-drawer') openDrawer();
  if(location.hash === '#dr-search') openOv();
})();
</script>
