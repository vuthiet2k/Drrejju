{% comment %} DR.REJU — Header (clone bố cục L'Oréal: utility bar + main nav; scroll → đậm & thu gọn) {% endcomment %}
{% assign menu_alias = settings.main_menu | default: 'main-menu' %}
{% assign nav = linklists[menu_alias] %}

<header class="dr-siteheader{% if template == 'index' %} dr-siteheader--overlay{% endif %}" id="drHeader">

  {% comment %} Tầng 1: utility bar — thu gọn khi scroll {% endcomment %}
  <div class="dr-utilbar">
    <div class="dr-container dr-utilbar-inner">
      <div class="dr-util-left">
        <a href="tel:{{ settings.phone | default: store.phone_number | remove: ' ' }}"><i class="fa-solid fa-phone"></i> {{ settings.phone | default: store.phone_number }}</a>
        <a href="/dat-lich"><i class="fa-regular fa-calendar-check"></i> Đặt lịch</a>
        <a href="{{ settings.social_zalo_link | default: '#' }}"><i class="fa-solid fa-comment-dots"></i> Tư vấn Zalo</a>
      </div>
      <div class="lang-switcher notranslate" id="langSwitcher" translate="no">
        <button class="lang-btn" id="langBtn" type="button">
          <img id="langFlag" src="{{ 'flag-vn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img">
          <span id="langLabel">Tiếng Việt</span>
          <i class="fa-solid fa-chevron-down lang-caret" aria-hidden="true"></i>
        </button>
        <ul class="lang-list" id="langList">
          <li data-lang="vi" data-flag="{{ 'flag-vn.svg' | asset_url }}" data-label="Tiếng Việt"><img src="{{ 'flag-vn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> Tiếng Việt</li>
          <li data-lang="en" data-flag="{{ 'flag-us.svg' | asset_url }}" data-label="English"><img src="{{ 'flag-us.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> English</li>
          <li data-lang="zh-CN" data-flag="{{ 'flag-cn.svg' | asset_url }}" data-label="中文"><img src="{{ 'flag-cn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 中文</li>
          <li data-lang="ja" data-flag="{{ 'flag-jp.svg' | asset_url }}" data-label="日本語"><img src="{{ 'flag-jp.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 日本語</li>
          <li data-lang="ko" data-flag="{{ 'flag-kr.svg' | asset_url }}" data-label="한국어"><img src="{{ 'flag-kr.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 한국어</li>
        </ul>
      </div>
    </div>
  </div>

  {% comment %} Tầng 2: main nav — thấp xuống khi scroll {% endcomment %}
  <div class="dr-container dr-nav">
    <button class="dr-burger" id="drBurger" aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
    <a href="/" class="dr-brand" title="{{ store.name }}" aria-label="{{ store.name | default: 'Dr.REJU' }}">
      <img src="{{ 'logo.png' | asset_url }}" alt="{{ store.name | default: 'Dr.REJU' }}" class="dr-brand-logo" width="150" height="46">
    </a>
    {% comment %} Mega menu (phương án H3): nhánh có link con → panel NỀN SÁNG tràn ngang,
       link chia cột + thẻ quảng bá bên phải. Nhánh không có con → link thường.
       Bản cũ render phẳng nên bỏ mất toàn bộ link con của main-menu. {% endcomment %}
    <nav class="dr-navmenu">
      {% for link in nav.links %}
        {% if link.links.size > 0 %}
        <div class="dr-navitem dr-navitem--mega">
          <a href="{{ link.url }}" class="dr-navlink" aria-haspopup="true">{{ link.title }} <i class="fa-solid fa-chevron-down dr-navcaret" aria-hidden="true"></i></a>
          <div class="dr-mega">
            <div class="dr-container dr-mega-in">
              <div class="dr-mega-links">
                {% for sub in link.links %}
                <a href="{{ sub.url }}">{{ sub.title }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                {% endfor %}
              </div>
              {%- assign mega_title = settings.mega_promo_title | default: 'Chưa rõ vấn đề? Làm hồ sơ da, bác sĩ đọc trực tiếp' -%}
              {% if mega_title != blank %}
              <a class="dr-mega-promo" href="{{ settings.mega_promo_url | default: '/dat-lich' }}">
                <em>{{ settings.mega_promo_eyebrow | default: 'Không biết bắt đầu từ đâu?' }}</em>
                <b>{{ mega_title }}</b>
                <span>{{ settings.mega_promo_cta | default: 'Bắt đầu' }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
              </a>
              {% endif %}
            </div>
          </div>
        </div>
        {% else %}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="dr-navactions">
      <a href="/search" data-dr-search-open aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></a>
      <a href="/account" class="dr-hide-mobile" aria-label="Tài khoản"><i class="fa-regular fa-user"></i></a>
      <a href="/cart" aria-label="Giỏ hàng"><i class="fa-solid fa-bag-shopping"></i><span class="dr-cart-count count_item_pr">{{ cart.item_count }}</span></a>
    </div>
  </div>

  {% comment %} ══ Panel tìm kiếm (phương án S2) — chỉ desktop (≥992px); ≤991px dùng overlay dr_mobile ══
     Kết quả tức thì lấy từ /search?view=smartjson (templates/search.smartjson.bwt đã có sẵn).
     Không JS thì icon kính lúp vẫn là link /search — không mất chức năng. {% endcomment %}
  {%- assign scat = linklists[settings.footer_cat_menu] -%}
  {%- unless scat.links.size > 0 -%}{%- assign scat = linklists['footer-categories'] -%}{%- endunless -%}

  <div class="dr-srch" id="drSrch" aria-hidden="true">
    <div class="dr-container dr-srch-top">
      <form class="dr-srch-form" action="/search" method="get" role="search" id="drSrchForm">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="text" name="query" id="drSrchInput" class="dr-srch-input" autocomplete="off" spellcheck="false"
               placeholder="{{ settings.header_search_placeholder | default: 'Tìm sản phẩm, hoạt chất, vấn đề da…' }}">
        <input type="hidden" name="type" value="product">
        <button type="button" class="dr-srch-clear" id="drSrchClear" aria-label="Xoá"><i class="fa-solid fa-xmark"></i></button>
      </form>
      <button type="button" class="dr-srch-close" id="drSrchClose" aria-label="Đóng tìm kiếm"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div class="dr-container dr-srch-in">
      <div class="dr-srch-main">
        <p class="dr-srch-lb" id="drSrchLb">Gõ để tìm sản phẩm</p>
        <div class="dr-srch-res" id="drSrchRes"></div>
      </div>

      <aside class="dr-srch-side">
        {%- assign sugg = settings.header_search_suggest_list | default: 'Retinol,Chống lão hoá,Trị mụn,Kem chống nắng,Serum,Cấp ẩm' | split: ',' -%}
        {% if sugg.size > 0 %}
        <div class="dr-srch-blk">
          <h6>Từ khoá phổ biến</h6>
          <div class="dr-srch-tags">
            {% for kw in sugg %}{%- assign kwc = kw | strip -%}{% if kwc != blank %}<a class="dr-srch-tag" href="/search?query={{ kwc | url_encode }}&type=product">{{ kwc }}</a>{% endif %}{% endfor %}
          </div>
        </div>
        {% endif %}
        {% if scat.links.size > 0 %}
        <div class="dr-srch-blk dr-srch-cats">
          <h6>Danh mục gợi ý</h6>
          {% for g in scat.links limit: 4 %}<a href="{{ g.url }}">{{ g.title }}</a>{% endfor %}
        </div>
        {% endif %}
      </aside>
    </div>

    <div class="dr-srch-bar" id="drSrchBar" hidden>
      <a href="/search" id="drSrchAll">Xem tất cả kết quả <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>
  </div>

</header>

<style>
/* ══ MEGA MENU (H3) — panel NỀN SÁNG tràn ngang ══
   .dr-navitem--mega phải là position:static để panel lấy mốc định vị là .dr-siteheader
   (sticky = đã là positioned). Để relative thì panel bó trong bề rộng mục menu. */
.dr-navitem{ display: flex; align-items: center; }
.dr-navitem--mega{ position: static; }
.dr-navlink{ display: inline-flex; align-items: center; gap: 6px; }
.dr-navcaret{ font-size: 9px; transition: transform .25s ease; }
.dr-navitem--mega:hover .dr-navcaret,
.dr-navitem--mega:focus-within .dr-navcaret{ transform: rotate(180deg); }

.dr-mega{ position: absolute; left: 0; right: 0; top: 100%; z-index: 190;
  background: var(--bg); border-top: 1px solid var(--line);
  box-shadow: 0 20px 44px rgba(6,32,26,.18);
  opacity: 0; visibility: hidden; transform: translateY(6px);
  transition: opacity .24s ease, transform .24s ease, visibility .24s ease; }
.dr-navitem--mega:hover .dr-mega,
.dr-navitem--mega:focus-within .dr-mega{ opacity: 1; visibility: visible; transform: none; }

.dr-mega-in{ display: grid; grid-template-columns: 1fr 300px; gap: 0 44px; padding: 30px 0 34px; }
.dr-mega-links{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 40px; align-content: start; }

/* ⚠️ Ghi đè rule .dr-navmenu a — nó áp uppercase + màu gold + gạch chân ::after +
   white-space:nowrap; và rule overlay ở trang chủ còn ép color:#fff.
   Không ghi đè đủ thì: chữ trắng trên nền trắng, và tiêu đề thẻ quảng bá KHÔNG xuống
   dòng được nên tràn ra ngoài thẻ. Phải reset cả white-space. */
.dr-siteheader .dr-mega a,
.dr-siteheader--overlay:not(.is-stuck) .dr-mega a{
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 10px 0; border-bottom: 1px solid var(--line);
  font-family: var(--font-primary); font-size: var(--fs-base); font-weight: 500;
  letter-spacing: normal; text-transform: none; white-space: normal;
  color: var(--text); opacity: 1;
  transition: color .2s ease, padding-left .2s ease; }
.dr-siteheader .dr-mega a::after,
.dr-siteheader--overlay:not(.is-stuck) .dr-mega a::after{ display: none; }
.dr-siteheader .dr-mega-links a:hover{ color: var(--accent); padding-left: 6px; }
.dr-mega-links a i{ font-size: 9px; color: var(--gold); opacity: 0; transition: opacity .2s ease; }
.dr-mega-links a:hover i{ opacity: 1; }

/* Thẻ quảng bá — emerald nổi trên panel sáng */
.dr-siteheader .dr-mega-promo,
.dr-siteheader--overlay:not(.is-stuck) .dr-mega-promo{
  display: flex; flex-direction: column; justify-content: flex-end; min-height: 150px;
  padding: 22px; border: 0; border-radius: 12px;
  background: linear-gradient(160deg, #14503F, var(--emerald));
  color: #fff; text-transform: none; letter-spacing: normal; white-space: normal; }
.dr-mega-promo em{ font-style: normal; font-size: var(--fs-xs); letter-spacing: .16em;
  text-transform: uppercase; color: var(--gold); }
.dr-mega-promo b{ display: block; margin: 7px 0 12px; font-family: var(--font-primary);
  font-size: var(--fs-md); font-weight: 600; line-height: 1.3; color: #fff; }
.dr-mega-promo span{ display: inline-flex; align-items: center; gap: 7px; width: -moz-fit-content; width: fit-content;
  padding: 9px 16px; border-radius: var(--radius-pill); background: var(--gold); color: var(--emerald);
  font-size: var(--fs-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
.dr-mega-promo:hover span{ background: var(--gold-lt); }

@media (max-width: 1200px){
  .dr-mega-in{ grid-template-columns: 1fr 260px; gap: 0 30px; }
  .dr-mega-links{ grid-template-columns: repeat(2, 1fr); }
}
/* ≤991px dùng drawer mobile (dr_mobile), không cần panel */
@media (max-width: 991px){ .dr-mega{ display: none; } }

/* ══ PANEL TÌM KIẾM (S2) — cùng ngôn ngữ nền sáng với mega menu ══ */
.dr-srch{ position: absolute; left: 0; right: 0; top: 100%; z-index: 195;
  background: var(--bg); border-top: 1px solid var(--line);
  box-shadow: 0 20px 44px rgba(6,32,26,.18);
  opacity: 0; visibility: hidden; transform: translateY(6px);
  transition: opacity .22s ease, transform .22s ease, visibility .22s ease; }
.dr-srch.is-open{ opacity: 1; visibility: visible; transform: none; }

.dr-srch-top{ display: flex; align-items: center; gap: 14px; padding: 18px 40px; }
.dr-srch-form{ flex: 1; display: flex; align-items: center; gap: 12px; margin: 0;
  height: 50px; padding: 0 8px 0 18px; background: var(--bg-soft); border-radius: var(--radius-pill); }
.dr-srch-form > i{ color: var(--text-soft); font-size: 14px; flex: none; }
.dr-srch-input{ flex: 1; min-width: 0; height: 100%; border: 0; background: none; outline: none;
  font-family: var(--font-primary); font-size: var(--fs-md); color: var(--text); }
.dr-srch-input::placeholder{ color: var(--text-soft); }
.dr-srch-clear, .dr-srch-close{ flex: none; border: 0; background: none; cursor: pointer;
  color: var(--text-soft); font-size: 15px; width: 38px; height: 38px; border-radius: 50%;
  transition: background .2s ease, color .2s ease; }
.dr-srch-clear{ visibility: hidden; }
.dr-srch-clear.is-on{ visibility: visible; }
.dr-srch-clear:hover, .dr-srch-close:hover{ background: var(--bg-soft); color: var(--text); }

.dr-srch-in{ display: grid; grid-template-columns: 1fr 300px; gap: 0 44px; padding: 4px 40px 28px; }
.dr-srch-lb{ margin: 0 0 10px; font-family: var(--font-primary); font-size: var(--fs-xs); font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase; color: var(--text-soft); }
.dr-srch-res{ display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px 20px; min-height: 40px; }

/* Hàng kết quả — cùng lưu ý ghi đè như .dr-mega a (rule .dr-navmenu a KHÔNG áp ở đây
   vì panel nằm ngoài .dr-navmenu, nhưng vẫn khai báo đủ để không phụ thuộc thứ tự CSS) */
.dr-srch-row{ display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 8px;
  text-transform: none; letter-spacing: normal; white-space: normal;
  transition: background .18s ease; }
.dr-srch-row:hover{ background: var(--bg-soft); }
.dr-srch-thumb{ width: 46px; height: 46px; flex: none; border-radius: 6px; overflow: hidden;
  background: var(--bg-soft); }
.dr-srch-thumb img{ width: 100%; height: 100%; object-fit: cover; display: block; }
.dr-srch-tx{ min-width: 0; flex: 1; }
.dr-srch-nm{ display: block; font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 500;
  line-height: 1.35; color: var(--text); overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.dr-srch-pr{ display: block; margin-top: 3px; font-family: var(--font-primary); font-size: var(--fs-sm);
  font-weight: 700; color: var(--accent); }
.dr-srch-pr del{ margin-left: 6px; font-weight: 500; font-size: var(--fs-xs); color: var(--text-soft); }
.dr-srch-empty{ grid-column: 1 / -1; padding: 8px 12px; font-size: var(--fs-sm); color: var(--text-soft); }

.dr-srch-blk + .dr-srch-blk{ margin-top: 22px; }
.dr-srch-blk h6{ margin: 0 0 12px; font-family: var(--font-primary); font-size: var(--fs-xs); font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase; color: var(--text-soft); }
.dr-srch-tags{ display: flex; flex-wrap: wrap; gap: 7px; }
.dr-srch-tag{ padding: 7px 13px; border-radius: var(--radius-pill); border: 1px solid var(--line);
  font-size: var(--fs-sm); color: var(--text-soft); transition: border-color .2s ease, color .2s ease; }
.dr-srch-tag:hover{ border-color: var(--emerald); color: var(--emerald); }
.dr-srch-cats a{ display: block; padding: 8px 0; font-size: var(--fs-sm); color: var(--text-soft);
  border-bottom: 1px solid var(--line); transition: color .2s ease; }
.dr-srch-cats a:hover{ color: var(--emerald); }

.dr-srch-bar{ border-top: 1px solid var(--line); }
.dr-srch-bar a{ display: flex; align-items: center; justify-content: center; gap: 8px; padding: 15px;
  font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; color: var(--emerald); transition: background .2s ease; }
.dr-srch-bar a:hover{ background: var(--bg-soft); }

@media (max-width: 1200px){
  .dr-srch-in{ grid-template-columns: 1fr 250px; gap: 0 30px; }
  .dr-srch-res{ grid-template-columns: 1fr; }
}
/* ≤991px dùng overlay toàn màn hình của dr_mobile */
@media (max-width: 991px){ .dr-srch{ display: none; } }

@media (prefers-reduced-motion: reduce){
  .dr-mega{ transition: none; }
  .dr-navcaret{ transition: none; }
  .dr-srch{ transition: none; }
}
</style>

<script>
(function(){
  /* ══ Tìm kiếm tức thì ══
     Nguồn: /search?view=smartjson  (templates/search.smartjson.bwt)
     Dạng trả về: { "searchResultCount": "7", "<id>": {name,url,image,price,compare_price}, ... }
     → phải bỏ qua khoá searchResultCount khi lặp, nó KHÔNG phải sản phẩm.
     Lưu ý: preview local không xử lý ?view= nên sẽ trả HTML → JSON.parse lỗi →
     rơi vào nhánh onFail, panel chỉ hiện thanh "Xem tất cả". Trên Sapo thì có kết quả thật. */
  var MIN_CHARS = 2, DEBOUNCE = 300, DESKTOP = 992;
  var seq = 0;   /* chống race: chỉ nhận phản hồi của yêu cầu mới nhất */

  function esc(s){
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /* Dùng chung cho panel desktop và overlay mobile */
  window.drSearchFetch = function(query, onData, onFail){
    var my = ++seq;
    var url = '/search?view=smartjson&type=product&query=' + encodeURIComponent(query);
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onreadystatechange = function(){
      if (xhr.readyState !== 4 || my !== seq) return;
      var data = null;
      try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
      if (!data || typeof data !== 'object'){ if (onFail) onFail(); return; }
      var items = [], total = 0, k;
      for (k in data){
        if (!Object.prototype.hasOwnProperty.call(data, k)) continue;
        if (k === 'searchResultCount'){ total = parseInt(data[k], 10) || 0; continue; }
        if (data[k] && data[k].name) items.push(data[k]);
      }
      onData(items, total || items.length);
    };
    xhr.onerror = function(){ if (my === seq && onFail) onFail(); };
    xhr.send();
  };

  window.drSearchRowHtml = function(p){
    var cmp = p.compare_price && p.compare_price !== '0' ? '<del>' + esc(p.compare_price) + '</del>' : '';
    var img = p.image ? '<img src="' + esc(p.image) + '" alt="" loading="lazy">' : '';
    return '<a class="dr-srch-row" href="' + esc(p.url) + '">' +
      '<span class="dr-srch-thumb">' + img + '</span>' +
      '<span class="dr-srch-tx"><span class="dr-srch-nm">' + esc(p.name) + '</span>' +
      '<span class="dr-srch-pr">' + esc(p.price) + cmp + '</span></span></a>';
  };

  function initSrch(){
    var panel = document.getElementById('drSrch');
    if (!panel) return;
    var input = document.getElementById('drSrchInput'),
        res   = document.getElementById('drSrchRes'),
        lb    = document.getElementById('drSrchLb'),
        bar   = document.getElementById('drSrchBar'),
        all   = document.getElementById('drSrchAll'),
        clear = document.getElementById('drSrchClear'),
        close = document.getElementById('drSrchClose'),
        form  = document.getElementById('drSrchForm');
    var timer = null;

    function open(){
      panel.className = 'dr-srch is-open';
      panel.setAttribute('aria-hidden', 'false');
      setTimeout(function(){ input.focus(); }, 60);
    }
    function shut(){
      panel.className = 'dr-srch';
      panel.setAttribute('aria-hidden', 'true');
    }
    function reset(){
      res.innerHTML = '';
      lb.textContent = 'Gõ để tìm sản phẩm';
      bar.hidden = true;
      clear.className = 'dr-srch-clear';
    }
    function render(items, total, q){
      if (!items.length){
        lb.textContent = 'Không có sản phẩm khớp';
        res.innerHTML = '<p class="dr-srch-empty">Thử từ khoá ngắn hơn, hoặc chọn một từ khoá phổ biến bên cạnh.</p>';
      } else {
        lb.textContent = 'Sản phẩm · ' + total + ' kết quả';
        var h = '', i;
        for (i = 0; i < items.length; i++){ h += window.drSearchRowHtml(items[i]); }
        res.innerHTML = h;
      }
      all.href = '/search?type=product&query=' + encodeURIComponent(q);
      all.innerHTML = 'Xem tất cả ' + (total ? total + ' ' : '') + 'kết quả cho “' + esc(q) +
                      '” <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>';
      bar.hidden = false;
    }

    input.addEventListener('input', function(){
      var q = input.value.replace(/^\s+|\s+$/g, '');
      clear.className = q ? 'dr-srch-clear is-on' : 'dr-srch-clear';
      if (timer) clearTimeout(timer);
      if (q.length < MIN_CHARS){ seq++; reset(); return; }
      lb.textContent = 'Đang tìm…';
      timer = setTimeout(function(){
        window.drSearchFetch(q, function(items, total){ render(items, total, q); },
          function(){
            /* Không đọc được JSON (vd môi trường preview) → vẫn cho khách sang trang kết quả */
            lb.textContent = 'Nhấn Enter để xem kết quả';
            res.innerHTML = '';
            all.href = '/search?type=product&query=' + encodeURIComponent(q);
            all.innerHTML = 'Xem tất cả kết quả cho “' + esc(q) + '” <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>';
            bar.hidden = false;
          });
      }, DEBOUNCE);
    });

    clear.addEventListener('click', function(){ input.value = ''; seq++; reset(); input.focus(); });
    close.addEventListener('click', shut);
    form.addEventListener('submit', function(e){
      if (!input.value.replace(/^\s+|\s+$/g, '')) e.preventDefault();
    });

    /* Icon kính lúp: ≥992px mở panel; nhỏ hơn để dr_mobile lo overlay */
    var opens = document.querySelectorAll('[data-dr-search-open]');
    for (var i = 0; i < opens.length; i++){
      opens[i].addEventListener('click', function(e){
        if (window.innerWidth < DESKTOP) return;
        e.preventDefault();
        if (/is-open/.test(panel.className)) shut(); else open();
      });
    }

    document.addEventListener('keydown', function(e){
      if (e.keyCode === 27 && /is-open/.test(panel.className)) shut();
    });
    document.addEventListener('click', function(e){
      if (!/is-open/.test(panel.className)) return;
      if (panel.contains(e.target)) return;
      if (e.target.closest && e.target.closest('[data-dr-search-open]')) return;
      shut();
    });
  }

  if (document.readyState !== 'loading') initSrch();
  else document.addEventListener('DOMContentLoaded', initSrch);
})();
</script>

{% include 'dr_mobile' %}
<div id="google_translate_element" style="display:none;visibility:hidden;"></div>

<script>
(function(){
  var h=document.getElementById('drHeader');
  if(!h) return;
  // Chống giật: hysteresis (2 mốc lệch nhau, không dao động bật/tắt quanh 1 ngưỡng)
  // + gom vào requestAnimationFrame + chỉ đụng DOM khi ĐỔI trạng thái.
  var ON = 80, OFF = 20;      // bật is-stuck khi cuộn quá 80px, tắt khi lên dưới 20px
  var stuck = false, ticking = false;
  function apply(){
    ticking = false;
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    if(!stuck && y > ON){ stuck = true; h.classList.add('is-stuck'); }
    else if(stuck && y < OFF){ stuck = false; h.classList.remove('is-stuck'); }
  }
  function onScroll(){ if(!ticking){ ticking = true; requestAnimationFrame(apply); } }
  window.addEventListener('scroll', onScroll, {passive:true});
  apply();
})();
</script>

{% comment %} ===== Language switcher (Google Translate) ===== {% endcomment %}
<script>
function googleTranslateElementInit(){
  new google.translate.TranslateElement({ pageLanguage:'vi', includedLanguages:'vi,en,zh-CN,ja,ko', autoDisplay:false }, 'google_translate_element');
}
</script>
<script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async></script>
<script>
(function(){
  var btn=document.getElementById('langBtn'), list=document.getElementById('langList'), labelEl=document.getElementById('langLabel');
  if(!btn||!list) return;
  var savedLang=localStorage.getItem('preferred_lang')||'vi', translateTimer=null;
  function setUI(lang){
    var activeLi=list.querySelector('li[data-lang="'+lang+'"]');
    if(activeLi){ labelEl.textContent=activeLi.dataset.label; var f=document.getElementById('langFlag'); if(f&&activeLi.dataset.flag) f.src=activeLi.dataset.flag; }
    list.querySelectorAll('li').forEach(function(li){ li.classList.toggle('active', li.dataset.lang===lang); });
  }
  function clearGoogtrans(){
    // Google set cookie googtrans ở nhiều scope domain (vd www.drreju.vn set ở .drreju.vn).
    // Xóa hết mọi biến thể domain + host-only, nếu không reload sẽ tự dịch lại → kẹt tiếng Anh.
    var host=location.hostname, parts=host.split('.'), domains=[''];
    for(var i=0;i<parts.length-1;i++){ var d=parts.slice(i).join('.'); domains.push(d, '.'+d); }
    domains.push(host, '.'+host);
    domains.forEach(function(dm){
      document.cookie='googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/'+(dm?';domain='+dm:'');
    });
  }
  function applyTranslate(lang){
    if(translateTimer){ clearInterval(translateTimer); translateTimer=null; }
    if(lang==='vi'){
      clearGoogtrans();
      location.reload(); return;
    }
    var attempts=0;
    translateTimer=setInterval(function(){
      var combo=document.querySelector('.goog-te-combo');
      if(combo){ clearInterval(translateTimer); translateTimer=null; combo.value=lang; combo.dispatchEvent(new Event('change')); }
      else if(++attempts>30){ clearInterval(translateTimer); translateTimer=null; }
    },200);
  }
  setUI(savedLang);
  if(savedLang!=='vi') applyTranslate(savedLang);
  btn.addEventListener('click', function(e){ e.stopPropagation(); list.classList.toggle('open'); });
  document.addEventListener('click', function(){ list.classList.remove('open'); });
  list.querySelectorAll('li').forEach(function(li){
    li.addEventListener('click', function(){
      var lang=this.dataset.lang; localStorage.setItem('preferred_lang', lang);
      setUI(lang); list.classList.remove('open'); applyTranslate(lang);
    });
  });
})();
</script>
