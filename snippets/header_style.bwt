		<style>
	@import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap');

	/* ============================================================
	   DR.REJU — DESIGN TOKENS (nguồn sự thật cho toàn bộ class dùng chung)
	   Đổi giá trị Ở ĐÂY là đổi cả theme. Utility/component đọc qua var().
	   ============================================================ */
	:root{
	  /* ============ ROYAL CLINICAL — Deep Emerald + Sand Gold ============
	     4 màu brand đọc từ admin (Thiết lập chung → Bảng màu thương hiệu).
	     Đổi ở đây chỉ là fallback cho preview/khi settings trống. */
	  --emerald:    {{ settings.main_color   | default: '#0A2E24' }};   /* xanh ngọc lục bảo sâu — nền tối / brand */
	  --emerald-dk: {{ settings.hover_color  | default: '#06201a' }};
	  --gold:       {{ settings.color_gold   | default: '#DFBA73' }};   /* vàng gold cát — nhấn / nút / icon */
	  --gold-lt:    {{ settings.color_gold_lt | default: '#E3C17E' }};

	  /* — BODY (nền sáng) — */
	  --bg:        #ffffff;   /* trắng — nền chính */
	  --bg-alt:    {{ settings.color_bg_alt  | default: '#FAF6EF' }};   /* kem ấm — section xen kẽ (sandwich), KHÔNG phải xám */
	  --bg-soft:   {{ settings.color_bg_soft | default: '#F1ECE3' }};   /* section sáng xen kẽ */
	  --bg-card:   #ffffff;   /* nền thẻ */
	  --surface:   #ffffff;
	  --text:      #17140F;   /* chữ chính trên nền sáng (ink ấm) */
	  --text-soft: #6E675C;   /* chữ phụ */
	  --text-on-surface: #17140F;
	  --line:      #E7E0D6;
	  --accent:    {{ settings.main_color  | default: '#0A2E24' }};    /* nhấn trên nền SÁNG = emerald */
	  --accent-dk: {{ settings.hover_color | default: '#06201a' }};
	  --accent-ink:#ffffff;   /* chữ trên nền accent (emerald) */

	  /* — Nút chính: nền GOLD, chữ EMERALD — */
	  --btn-bg:   {{ settings.color_gold | default: '#DFBA73' }};
	  --btn-text: {{ settings.main_color | default: '#0A2E24' }};

	  /* — HEADER/FOOTER + section nền tối: bám cùng cặp emerald/gold — */
	  --brand-bg:    {{ settings.main_color  | default: '#0A2E24' }};
	  --brand-bg-dk: {{ settings.hover_color | default: '#06201a' }};
	  --brand-text:  {{ settings.color_gold  | default: '#DFBA73' }};

	  /* — Font (đang cấu hình Quicksand — đổi 1 dòng nếu chốt font khác) — */
	  --font-primary:   'Quicksand', sans-serif;   /* heading / nav / nút */
	  --font-secondary: 'Quicksand', sans-serif;   /* body / mô tả */

	  /* — Thang cỡ chữ — */
	  --fs-xs: .75rem;  --fs-sm: .875rem; --fs-base: 1rem; --fs-md: 1.125rem;
	  --fs-lg: 1.25rem; --fs-xl: 1.5rem;  --fs-2xl: 2rem;  --fs-3xl: 2.75rem;

	  /* — Spacing 8pt — */
	  --sp-4:4px; --sp-8:8px; --sp-16:16px; --sp-24:24px; --sp-32:32px;
	  --sp-48:48px; --sp-56:56px; --sp-80:80px; --sp-110:110px;

	  /* — Khác — */
	  --container: 1320px;
	  --radius: 14px; --radius-sm: 8px; --radius-pill: 999px;
	  --shadow: 0 10px 40px rgba(0,0,0,.18);
	}
</style>