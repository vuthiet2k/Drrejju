{% if template contains 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ store.url }}/#organization",
      "name": "{{ store.name | escape }}",
      "url": "{{ store.url }}",
      "logo": "{{ 'logo.png' | asset_url }}",
      "description": "{{ store.description | escape }}"{% if store.phone_number != blank %},
      "telephone": "{{ store.phone_number | escape }}"{% endif %}{% if store.email != blank %},
      "email": "{{ store.email | escape }}"{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": "{{ store.url }}/#website",
      "name": "{{ store.name | escape }}",
      "url": "{{ store.url }}",
      "publisher": { "@id": "{{ store.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ store.url }}/search?query={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "WebPage",
      "@id": "{{ canonical_url }}#webpage",
      "url": "{{ canonical_url }}",
      "name": "{{ store.name | escape }} | Da liễu dựa trên bằng chứng & phác đồ cá nhân hóa 1:1",
      "description": "{{ page_description | escape }}",
      "isPartOf": { "@id": "{{ store.url }}/#website" },
      "about": { "@id": "{{ store.url }}/#organization" }
    }
  ]
}
</script>
{% else %}
{% unless template contains '404' %}
{% if template contains 'article' %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "mainEntityOfPage":{"@type":"WebPage","@id":"{{ canonical_url }}"},
  "headline":"{{ article.title | escape }}",
  "description":"{{ article.summary | strip_html | escape }}",
  "datePublished":"{{ article.published_on | date: '%Y-%m-%d' }}",
  "dateModified":"{{ article.created_on | date: '%Y-%m-%d' }}",
  "author":{"@type":"Person","name":"{{ article.author | default: store.name | escape }}"},
  "publisher":{"@id":"{{ store.url }}/#organization"}{% if article.image.src != blank %},
  "image":"{{ article.image.src }}"{% endif %}
}
</script>
{% endif %}
<script type="application/ld+json">
        {
        "@context": "http://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": 
        [
            {
                "@type": "ListItem",
                "position": 1,
                "item": 
                {
                  "@id": "{{ store.url }}",
                  "name": "Trang chủ"
                }
            },
      {% if template contains 'product' %}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ product.url }}",
                  "name": "{{ product.name }}"
                }
            }
      {%endif%}
        {% if template contains 'collection' and collection.alias %}
      {%if collection.alias == 'all'%}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ collection.url }}",
                  "name": "{{ collection.name }}"
                }
            }{% if current_tags %},{%endif%}
      {%else%}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ collection.url }}",
                  "name": "{{ collection.name }}"
                }
            }{% if current_tags %},{%endif%}
      {%endif%}
      {% if current_tags %}
        {%if collection.alias == 'all'%}
        {
          "@type": "ListItem",
          "position": 3,
          "item": 
          {
            "@id": "{{ store.url }}{{ collection.url }}/{{ current_tags.first | url_encode }}",
            "name": "{{ current_tags.first }}"
          }
        }
        {%else%}
        {
          "@type": "ListItem",
          "position": 3,
          "item": 
          {
            "@id": "{{ store.url }}{{ collection.url }}/{{ current_tags.first | url_encode }}",
            "name": "{{ current_tags.first }}"
          }
        }
        {%endif%}
      {%endif%}
      {%endif%}
      {% if template contains 'article' %}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ blog.url }}",
                  "name": "{{ blog.name }}"
                }
            },
      {
                "@type": "ListItem",
                "position": 3,
                "item": 
                {
                  "@id": "{{ store.url }}{{ article.url }}",
                  "name": "{{ article.title }}"
                }
            }
      {%endif%}
      {% if template == 'blog' %}
      {%if current_url contains 'blogs/all'%}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ blog.url }}",
                  "name": "{{ blog.name }}"
                }
            }
      {%else%}
        {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ blog.url }}",
                  "name": "{{ blog.name }}"
                }
            }
      {%if current_tags%}
      ,
      {
                "@type": "ListItem",
                "position": 3,
                "item": 
                {
                  "@id": "{{ store.url }}{{ blog.url }}/{{ current_tags.first | url_encode }}",
                  "name": "{{ current_tags.first }}"
                }
            }
      {%endif%}
      {%endif%}
      {%endif%}
      {% if template contains 'page' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}{{ page.url }}",
                  "name": "{{ page.title }}"
                }
            }
      {% endif %}
      {% if template contains 'cart' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}/cart",
                  "name": "Giỏ hàng"
                }
            }
      {% endif %}
    {% if template contains 'search' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "{{ store.url }}/search",
                  "name": "Tìm kiếm"
                }
            }
      {% endif %}
        ]
        }
</script>
{% endunless %}
{% endif %}
