<section class="section_3_banner">
	<div class="container">
		<div class="banner-slider swiper-container">
			<div class="swiper-wrapper">
				{%- for i in (1..3) -%}

				{%-capture naviimage-%}banner_three_{{i}}.jpg{%-endcapture-%}
				{%-capture alt-%}banner_three_{{i}}_alt{%-endcapture-%}
				{%-capture url-%}banner_three_{{i}}_url{%-endcapture-%}

				<div class="swiper-slide">
					<a class="image-effect" href="{{settings[url]}}" title="{{settings[alt]}}">
						<img width="428" height="212" class="lazyload" src="{{ 'lazy.png' | asset_url}}"  data-src="{{naviimage | asset_url}}" alt="{{settings[alt]}}">
					</a>
				</div>

				{%-endfor-%}
			</div>
		</div>
	</div>
</section>