{% comment %} DR.REJU — Vì sao chọn (phương án D1 "Thẻ hồ sơ bác sĩ" — bản NỀN ĐEN):
   Nền emerald tối; cột trái là thẻ hồ sơ (khung ảnh dọc 3:4 + 3 tag card + block chức danh),
   cột phải là 6 tiêu chí xếp 2×3 kẻ hairline vàng + pull-quote gold-tinted.
   Khác D2 (Infographic 6 trụ) trước đây: bỏ 3 trụ trái/phải + hairline nối về ảnh; layout
   đọc như thẻ hồ sơ y khoa (dossier). Nguồn nháp: _drafts/why-directions/why-D1-dossier.html.
   Bản gốc D1 nền kem — bản này giữ emerald tối theo yêu cầu.
   Cấu hình: Tùy chỉnh → Trang chủ - Vì sao chọn
   Bản ghi chọn phương án: _drafts/direction-approved.md {% endcomment %}

{%- assign why_speed = settings.why_slide_speed | default: 4 | times: 1000 -%}
{%- assign docAsset = 'bs_Hue-1.jpg,bs_Hue-2.jpg,bs_Hue-3.jpg' | split: ',' -%}
{%- assign cIcon = 'fa-user-doctor|fa-microscope|fa-shield-heart|fa-layer-group|fa-comment-medical|fa-hand-holding-heart' | split: '|' -%}
{%- assign cTi = 'Bác sĩ trực tiếp xây phác đồ|Chỉ thứ đã kiểm chứng lâm sàng|Không lạm dụng thuốc|Phân loại theo mức độ|Theo sát 1:1 qua Zalo|Đạo đức và cái tâm làm nghề' | split: '|' -%}
{%- assign cDe = 'Linh hoạt đổi hoạt chất theo diễn biến thật của da bạn.|Chỉ mã hàng đã theo dõi trên nhiều case thực tế, không theo trend.|Ưu tiên phục hồi hàng rào bảo vệ tự nhiên thay vì kháng sinh liều cao.|Xếp theo mức cấp thiết hoặc bổ trợ, ưu tiên đúng thứ cần trước.|Điều chỉnh phác đồ mỗi 2 tuần theo phản hồi thật của da.|Tư vấn đúng, đủ, minh bạch cho làn da và sức khỏe tinh thần.' | split: '|' -%}
{% comment %} Tag mặc định KHÔNG chứa con số (số năm/số ca) — số liệu về trình độ người thật
   phải do chủ cửa hàng điền sau khi xác minh. {% endcomment %}
{%- assign tagIcon = 'fa-user-doctor,fa-file-medical,fa-comment-medical' | split: ',' -%}
{%- assign tagLb = 'Chuyên gia da liễu,Phác đồ 1:1,Theo sát qua Zalo' | split: ',' -%}

<section id="why" class="dr-section dr-why3">
  <div class="dr-container dr-why3-in">

    <div class="dr-why3-head">
      <div class="dr-why3-head-t">
        <span class="dr-eyebrow">{{ settings.why_eyebrow | default: 'Vì sao chọn Dr.Reju' }}</span>
        <h2 class="dr-h2 dr-mt-8 dr-why3-h">{{ settings.why_headline | default: 'Chúng tôi từ chối trị mụn cấp tốc. <span>Da khỏe thật thì không thể vội vã.</span>' }}</h2>
      </div>
      {%- assign why_cta = settings.why_cta_label | default: 'Tìm hiểu Phác đồ 1:1' -%}
      {% if why_cta != blank %}<a href="{{ settings.why_cta_url | default: '/dat-lich' }}" class="dr-btn dr-btn--primary dr-why3-cta">{{ why_cta }} <i class="fa-solid fa-arrow-right"></i></a>{% endif %}
    </div>

    <div class="dr-why3-grid">

      {% comment %} ── Cột trái: Thẻ hồ sơ bác sĩ ── {% endcomment %}
      <div class="dr-why3-doc">

        <div class="dr-why3-frame" data-why-slider data-speed="{{ why_speed }}">
          {%- assign why_badge = settings.why_badge | default: 'Người sáng lập' -%}
          {% if why_badge != blank %}<span class="dr-why3-badge"><i class="fa-solid fa-certificate" aria-hidden="true"></i> {{ why_badge }}</span>{% endif %}

          {%- assign has_doc = false -%}
          {% for i in (1..3) %}
            {%- capture dimgk %}why_doc_{{ i }}_img{% endcapture -%}
            {% if settings[dimgk] != blank %}
              {%- assign has_doc = true -%}
              <div class="dr-why3-slide{% if forloop.first %} is-active{% endif %}"><img src="{{ settings[dimgk] | img_url: '1024x1024' }}" alt="{{ settings.why_doc_name | default: 'Bác sĩ Nguyễn Huệ' }}" loading="lazy"></div>
            {% endif %}
          {% endfor %}

          {% unless has_doc %}
            {% for i in (0..2) %}
            <div class="dr-why3-slide{% if forloop.first %} is-active{% endif %}"><img src="{{ docAsset[i] | asset_url }}" alt="{{ settings.why_doc_name | default: 'Bác sĩ Nguyễn Huệ' }}" loading="lazy" onerror="this.style.display='none'"></div>
            {% endfor %}
          {% endunless %}
        </div>

        {% comment %} ── 3 tag card kiểu thẻ hồ sơ ── {% endcomment %}
        <div class="dr-why3-tags">
          {% for i in (1..3) %}
            {%- assign idx = i | minus: 1 -%}
            {%- capture gk %}why_tag_{{ i }}{% endcapture -%}
            {%- capture gik %}why_tag_{{ i }}_icon{% endcapture -%}
            {%- assign glb = settings[gk] | default: tagLb[idx] -%}
            {% if glb != blank %}
              <div class="dr-why3-tag">
                <span class="dr-why3-tag-ic"><i class="fa-solid {{ settings[gik] | default: tagIcon[idx] }}" aria-hidden="true"></i></span>
                <b>{{ glb }}</b>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="dr-why3-name">
          <em>{{ settings.why_doc_role | default: 'Chuyên gia da liễu Lâm sàng · Người sáng lập' }}</em>
          <strong>{{ settings.why_doc_name | default: 'Bác sĩ Nguyễn Huệ' }}</strong>
        </div>
      </div>

      {% comment %} ── Cột phải: 6 tiêu chí + pull-quote ── {% endcomment %}
      <div class="dr-why3-right">
        <div class="dr-why3-crit">
          {% for i in (1..6) %}
            {%- assign idx = i | minus: 1 -%}
            {%- capture tk %}why_{{ i }}_title{% endcapture -%}
            {%- capture dk %}why_{{ i }}_desc{% endcapture -%}
            {%- capture ik %}why_{{ i }}_icon{% endcapture -%}
            {%- assign ctitle = settings[tk] | default: cTi[idx] -%}
            {% if ctitle != blank %}
              <article class="dr-why3-ci">
                <span class="dr-why3-ci-ic">
                  <i class="fa-solid {{ settings[ik] | default: cIcon[idx] }}" aria-hidden="true"></i>
                  <span class="dr-why3-ci-no">{{ i }}</span>
                </span>
                <div class="dr-why3-ci-t">
                  <h3>{{ ctitle }}</h3>
                  <p>{{ settings[dk] | default: cDe[idx] }}</p>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>

        {%- assign why_q = settings.why_doc_quote | default: '“Tôi sẽ không hứa kết quả sau 7 ngày. Tôi hứa đồng hành để da bạn khỏe thật, từ gốc.”' -%}
        {% if why_q != blank %}
          <blockquote class="dr-why3-pull">
            <p>{{ why_q }}</p>
            <cite>{{ settings.why_doc_name | default: 'Bác sĩ Nguyễn Huệ' }}</cite>
          </blockquote>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
/* ── Layout / Box ── */
.dr-why3{ position: relative; overflow: hidden; background: var(--emerald-dk); color: #fff; }
.dr-why3-in{ position: relative; z-index: 2; }
.dr-why3-head{ display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-24); flex-wrap: wrap; margin-bottom: 44px; }
.dr-why3-head-t{ max-width: 720px; }
.dr-why3-grid{ display: grid; grid-template-columns: 392px 1fr; gap: 56px; align-items: start; }
.dr-why3-doc{ position: relative; }
.dr-why3-right{ display: flex; flex-direction: column; gap: 34px; }

/* ── Typography ── */
.dr-why3 .dr-eyebrow{ color: var(--gold); }
.dr-why3-h{ color: #fff; }
/* nền tối → phần nhấn trong headline phải là VÀNG (var(--accent) là emerald, sẽ mất chữ) */
.dr-why3-h span{ color: var(--gold); }

/* ── Visual: nền lưới + quầng sáng ── */
.dr-why3::before{ content: ''; position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(rgba(223,186,115,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(223,186,115,.045) 1px, transparent 1px);
  background-size: 56px 56px; }
.dr-why3::after{ content: ''; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(720px 460px at 34% 44%, rgba(223,186,115,.13), transparent 70%); }

/* ── Khung ảnh dọc 3:4 (thẻ hồ sơ) ── */
.dr-why3-frame{ position: relative; height: 0; padding-top: 133.333%; border-radius: var(--radius);
  overflow: hidden; background: linear-gradient(160deg, var(--emerald), var(--emerald-dk));
  box-shadow: 0 30px 68px rgba(0,0,0,.42); }
/* viền vàng mảnh chạy quanh khung — signature D1 */
.dr-why3-frame::after{ content: ''; position: absolute; inset: 10px; border: 1px solid rgba(223,186,115,.55);
  border-radius: 6px; pointer-events: none; z-index: 3; }
.dr-why3-slide{ position: absolute; inset: 0; opacity: 0; transition: opacity 1s ease; }
.dr-why3-slide.is-active{ opacity: 1; }
.dr-why3-slide img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
  transition: transform 1.2s cubic-bezier(.2,.8,.2,1); }
.dr-why3-doc:hover .dr-why3-slide.is-active img{ transform: scale(1.035); }
.dr-why3-badge{ position: absolute; top: 22px; left: 22px; z-index: 4; display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 13px; border-radius: var(--radius-pill); background: rgba(6,32,26,.85); border: 1px solid rgba(223,186,115,.5);
  color: var(--gold); font-family: var(--font-primary); font-size: var(--fs-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

/* ── Tag card dưới ảnh (D1 style, adapt dark) ── */
.dr-why3-tags{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 12px; }
.dr-why3-tag{ display: flex; align-items: center; gap: 9px; padding: 11px 12px;
  background: rgba(255,255,255,.05); border: 1px solid rgba(223,186,115,.28); border-radius: 10px; min-width: 0; }
.dr-why3-tag-ic{ flex: none; width: 28px; height: 28px; border-radius: 7px; background: var(--gold); color: var(--emerald);
  display: grid; place-items: center; font-size: 12px; }
.dr-why3-tag b{ display: block; font-family: var(--font-primary); font-size: var(--fs-xs); font-weight: 700;
  line-height: 1.2; color: #fff; letter-spacing: .01em;
  overflow-wrap: anywhere; }

/* ── Block chức danh (border-top vàng đậm — signature D1) ── */
.dr-why3-name{ margin-top: 20px; padding-top: 18px; border-top: 2px solid var(--gold); }
.dr-why3-name em{ display: block; font-style: normal; font-family: var(--font-primary); font-size: var(--fs-xs);
  letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.55); }
.dr-why3-name strong{ display: block; margin-top: 5px; font-family: var(--font-primary); font-size: var(--fs-2xl);
  font-weight: 600; line-height: 1.2; color: #fff; }

/* ── 6 tiêu chí: grid 2×3 kẻ hairline vàng mảnh ── */
.dr-why3-crit{ display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; }
.dr-why3-ci{ position: relative; display: flex; gap: 16px; padding: 24px 0;
  border-top: 1px solid rgba(223,186,115,.18); }
.dr-why3-crit .dr-why3-ci:nth-child(1),
.dr-why3-crit .dr-why3-ci:nth-child(2){ border-top: 0; padding-top: 0; }
.dr-why3-ci-ic{ position: relative; flex: none; width: 46px; height: 46px; border-radius: 11px;
  background: rgba(223,186,115,.1); color: var(--gold); display: grid; place-items: center; font-size: 17px;
  border: 1px solid rgba(223,186,115,.22); transition: background .35s, color .35s, border-color .35s; }
.dr-why3-ci:hover .dr-why3-ci-ic{ background: var(--gold); color: var(--emerald); border-color: var(--gold); }
.dr-why3-ci-no{ position: absolute; top: -6px; right: -6px; width: 19px; height: 19px; border-radius: 50%;
  background: var(--gold); color: var(--emerald); font-family: var(--font-primary); font-size: .5625rem; font-weight: 700;
  display: grid; place-items: center; }
.dr-why3-ci-t h3{ margin: 0 0 5px; font-family: var(--font-primary); font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: #fff; }
.dr-why3-ci-t p{ margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: rgba(255,255,255,.68); }

/* ── Pull-quote gold-tinted (nổi trên nền emerald-dk) ── */
.dr-why3-pull{ position: relative; margin: 0; padding: 28px 32px 28px 40px; border-radius: var(--radius);
  background: linear-gradient(135deg, rgba(223,186,115,.09), rgba(223,186,115,.02));
  border: 1px solid rgba(223,186,115,.32); overflow: hidden; }
.dr-why3-pull::before{ content: '”'; position: absolute; top: -28px; right: 22px; font-family: Georgia, serif;
  font-size: 9rem; line-height: 1; color: rgba(223,186,115,.18); pointer-events: none; }
/* thanh nhấn vàng bên trái — thay cho "left border accent" slop bằng full-height rule */
.dr-why3-pull::after{ content: ''; position: absolute; left: 0; top: 20px; bottom: 20px; width: 3px;
  background: var(--gold); border-radius: 0 3px 3px 0; }
.dr-why3-pull p{ margin: 0; max-width: 640px; font-size: 1.125rem; font-style: italic; line-height: 1.6; color: #fff; }
.dr-why3-pull cite{ display: block; margin-top: 14px; font-style: normal; font-family: var(--font-primary);
  font-size: var(--fs-xs); font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); }

/* ── Animation (chỉ bật khi JS gắn .is-anim) ── */
.dr-why3.is-anim .dr-why3-ci,
.dr-why3.is-anim .dr-why3-tag,
.dr-why3.is-anim .dr-why3-pull{ opacity: 0; }
.dr-why3.is-anim .dr-why3-ci{ transform: translateY(14px); }
.dr-why3.is-anim .dr-why3-tag{ transform: translateY(8px) scale(.96); }
.dr-why3.is-anim .dr-why3-pull{ transform: translateY(12px); }
.dr-why3.is-anim .dr-why3-ci.is-in{ animation: drWhyRise .55s cubic-bezier(.2,.8,.2,1) forwards; }
.dr-why3.is-anim .dr-why3-tag.is-in{ animation: drWhyPop .45s cubic-bezier(.2,.9,.3,1.2) forwards; }
.dr-why3.is-anim .dr-why3-pull.is-in{ animation: drWhyRise .55s cubic-bezier(.2,.8,.2,1) forwards; }

@keyframes drWhyRise{ to{ opacity: 1; transform: none; } }
@keyframes drWhyPop{ to{ opacity: 1; transform: none; } }

/* ── Media queries ── */
@media (max-width: 1200px){
  .dr-why3-grid{ grid-template-columns: 340px 1fr; gap: 40px; }
}
@media (max-width: 991px){
  .dr-why3-grid{ grid-template-columns: 1fr; gap: 36px; }
  .dr-why3-doc{ max-width: 420px; margin: 0 auto; }
  .dr-why3-crit{ grid-template-columns: 1fr; column-gap: 0; }
  .dr-why3-crit .dr-why3-ci:nth-child(2){ border-top: 1px solid rgba(223,186,115,.18); padding-top: 24px; }
  .dr-why3-head{ margin-bottom: 36px; }
}
/* ── Mobile: gọn lại; bỏ mô tả tiêu chí để giảm chiều cao section ────────────
   Rationale (giữ từ D2): 6 tiêu chí có mô tả 2–3 dòng trên mobile đẩy section
   lên >1400px cuộn — tiêu đề trụ đã tự nói đủ. {% comment %} keep for maintainers {% endcomment %} */
@media (max-width: 767px){
  .dr-why3-head{ margin-bottom: var(--sp-24); }
  .dr-why3-head .dr-btn{ margin-top: var(--sp-16); }

  .dr-why3-doc{ max-width: 320px; }
  .dr-why3-tags{ grid-template-columns: 1fr 1fr; }
  .dr-why3-tags .dr-why3-tag:last-child:nth-child(odd){ grid-column: 1 / -1; }
  .dr-why3-tag{ padding: 10px 11px; }
  .dr-why3-tag b{ font-size: 11px; }

  .dr-why3-badge{ top: 14px; left: 14px; padding: 5px 10px; font-size: 10px; }
  .dr-why3-name{ text-align: center; }
  .dr-why3-name em{ font-size: 10px; letter-spacing: .12em; }
  .dr-why3-name strong{ font-size: var(--fs-xl); }

  .dr-why3-ci{ padding: 18px 0; gap: 14px; }
  .dr-why3-ci-ic{ width: 40px; height: 40px; font-size: 15px; }
  .dr-why3-ci-t p{ display: none; }
  .dr-why3-ci-t h3{ font-size: .9375rem; line-height: 1.35; }

  .dr-why3-pull{ padding: 22px 22px 22px 28px; }
  .dr-why3-pull p{ font-size: 1rem; }
  .dr-why3-pull::before{ font-size: 6rem; top: -18px; right: 14px; }
}
@media (max-width: 480px){
  .dr-why3-doc{ max-width: 260px; }
  .dr-why3-tags{ grid-template-columns: 1fr; }
}

/* ── Tôn trọng cài đặt giảm chuyển động ── */
@media (prefers-reduced-motion: reduce){
  .dr-why3.is-anim .dr-why3-ci,
  .dr-why3.is-anim .dr-why3-tag,
  .dr-why3.is-anim .dr-why3-pull{ opacity: 1; transform: none; animation: none; }
  .dr-why3-slide{ transition: none; }
  .dr-why3-slide img{ transition: none; }
}
</style>

<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Dải ảnh bác sĩ tự chạy */
  function initWhySlider(){
    var boxes = document.querySelectorAll('[data-why-slider]');
    for (var b = 0; b < boxes.length; b++){ (function(box){
      var slides = box.querySelectorAll('.dr-why3-slide');
      if (slides.length < 2 || reduce) return;
      var speed = parseInt(box.getAttribute('data-speed'), 10) || 4000;
      var idx = 0, timer = null;
      function go(n){ slides[idx].classList.remove('is-active'); idx = (n + slides.length) % slides.length; slides[idx].classList.add('is-active'); }
      function start(){ stop(); timer = setInterval(function(){ go(idx + 1); }, speed); }
      function stop(){ if (timer) { clearInterval(timer); timer = null; } }
      box.addEventListener('mouseenter', stop);
      box.addEventListener('mouseleave', start);
      document.addEventListener('visibilitychange', function(){ if (document.hidden) stop(); else start(); });
      start();
    })(boxes[b]); }
  }

  /* Tiêu chí + tag + pull-quote hiện dần khi cuộn tới */
  function initWhyReveal(){
    var secs = document.querySelectorAll('.dr-why3');
    for (var s = 0; s < secs.length; s++){ (function(sec){
      var items = sec.querySelectorAll('.dr-why3-ci, .dr-why3-tag, .dr-why3-pull');
      if (!items.length) return;
      if (reduce || !window.IntersectionObserver) return;

      sec.className += ' is-anim';
      var io = new IntersectionObserver(function(entries){
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        for (var i = 0; i < items.length; i++){
          items[i].style.animationDelay = (i * 0.075) + 's';
          items[i].className += ' is-in';
        }
      }, { threshold: 0.12 });
      io.observe(sec.querySelector('.dr-why3-grid') || sec);
    })(secs[s]); }
  }

  function init(){ initWhySlider(); initWhyReveal(); }
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
</script>
