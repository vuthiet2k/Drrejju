<section class="section_why">
	<img width="1920" height="390" class="lazyload" src="{{ 'lazy.png' | asset_url}}"  data-src="{{'taisao.jpg' | asset_url}}" alt="{{settings.title_why}}">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-12 col-xl-4">
				
				<span class="title">
					{{settings.title_why}}
				</span>
				<span class="content">
					{{settings.content_why}}
				</span>
			</div>
			<div class="col-12 col-xl-8">
				<ul>
					{%- for i in (1..6) -%}
					{%-capture image-%}lydo{{i}}.jpg{%-endcapture-%}
					{%-capture title-%}lydo_title_{{i}}{%-endcapture-%}
					{%-capture content-%}lydo_content_{{i}}{%-endcapture-%}
					
					<li>
						<div class="thumb">
							<div class="icon">
								<img width="64" height="64" class="lazyload" src="{{ 'lazy.png' | asset_url}}"  data-src="{{image | asset_url}}" alt="{{ settings[title]}}">
							</div>
							<h3 class="title-item">
								{{ settings[title]}}
							</h3>
							<span class="content-item">
								{{ settings[content]}}	
							</span>
						</div>
					</li>

					{%-endfor-%}
					
					
				</ul>
			</div>
		</div>
	</div>
</section>