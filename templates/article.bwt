{% comment %}
  DR.REJU — Clinical Article Detail & Case Study Template (Production-Ready)
  Design System Parity: Figma Node 41:12 (41:353 Desktop 1440px)
  Sapo Object: article (title, content, summary, author, published_on, tags, comments, image)
{% endcomment %}

{% include 'breadcrumb' %}

{% if article.content contains "<h2" or article.content contains "<h3" %}
  {% assign has_toc = true %}
{% endif %}

<section class="dr-article-page layout-article" itemscope itemtype="https://schema.org/Article">
  <meta itemprop="mainEntityOfPage" content="{{ article.url }}">
  <meta itemprop="description" content="{{ article.summary | default: article.content | strip_html | truncate: 160 }}">
  <meta itemprop="author" content="{{ article.author | default: 'Bs. Nguyễn Huệ' }}">
  <meta itemprop="headline" content="{{ article.title | escape }}">
  <meta itemprop="image" content="https:{% if article.image.src == null %}{{ 'logo.png' | asset_url }}{% else %}{{ article.image.src }}{% endif %}">
  <meta itemprop="datePublished" content="{{ article.published_on | date: '%Y-%m-%d' }}">
  <meta itemprop="dateModified" content="{{ article.created_on | default: article.published_on | date: '%Y-%m-%d' }}">

  <div class="container">
    
    {% comment %} 1. Article Header & Metadata Bar (Figma Node 41:367) {% endcomment %}
    <header class="dr-article-header">
      <div class="dr-article-header__tags">
        {% if article.tags.size > 0 %}
          <span class="dr-badge-category">{{ article.tags.first }}</span>
        {% else %}
          <span class="dr-badge-category">PHÁC ĐỒ ĐIỀU TRỊ 1:1</span>
        {% endif %}
        <span class="dr-badge-medical-check">✓ Đã Kiểm Duyệt Y Khoa</span>
      </div>

      <h1 class="dr-article-header__title" itemprop="headline">{{ article.title }}</h1>

      <div class="dr-article-author-bar">
        <div class="dr-article-author-bar__profile">
          <div class="dr-article-author-bar__avatar">
            <img src="{{ 'bs_Hue-1.jpg' | asset_url }}" alt="Bs. Nguyễn Huệ" width="44" height="44" loading="lazy">
          </div>
          <div class="dr-article-author-bar__meta">
            <strong class="dr-article-author-bar__name">{{ article.author | default: 'Bs. Nguyễn Huệ' }}</strong>
            <span class="dr-article-author-bar__role">Bác sĩ Chuyên khoa Da liễu & Phục hồi</span>
          </div>
        </div>
        <div class="dr-article-author-bar__info">
          <time datetime="{{ article.published_on | date: '%Y-%m-%d' }}">
            📅 {{ article.published_on | date: 'dd/MM/yyyy' }}
          </time>
          <span class="dr-article-author-bar__dot">•</span>
          <span>⏱️ 5 phút đọc</span>
          {% if article.comments_count > 0 %}
            <span class="dr-article-author-bar__dot">•</span>
            <span>💬 {{ article.comments_count }} bình luận</span>
          {% endif %}
        </div>
      </div>
    </header>

    {% comment %} 2. Editorial Reading Body 3-Column Layout (Figma Node 41:376) {% endcomment %}
    <div class="row dr-article-body-layout">
      
      {% comment %} 2.1 Left TOC Column (Sticky 220px on Desktop) {% endcomment %}
      {% if has_toc %}
        <aside class="col-xl-2 col-lg-3 d-none d-lg-block dr-article-toc-col">
          <div class="dr-sticky-toc">
            <h3 class="dr-sticky-toc__title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              <span>Mục Lục Bài Viết</span>
            </h3>
            <nav class="dola-toc dr-toc-list" aria-label="Mục lục bài viết"></nav>
          </div>
        </aside>
      {% endif %}

      {% comment %} 2.2 Middle RTE Content Body (740px) {% endcomment %}
      <article class="{% if has_toc %}col-xl-7 col-lg-6{% else %}col-xl-8 col-lg-8{% endif %} col-12 dr-article-content-col">
        <div class="dr-article-content rte" itemprop="articleBody">
          {% if article.content != null and article.content != blank %}
            {{ article.content }}
          {% else %}
            <div class="alert alert-warning">Nội dung bài viết đang được Bs. Nguyễn Huệ hoàn thiện...</div>
          {% endif %}
        </div>

        {% comment %} Social Sharing {% endcomment %}
        <div class="dr-social-share-box">
          <span>Chia sẻ phác đồ:</span>
          <div class="dr-social-share-links">
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | default: article.url }}" target="_blank" rel="noopener" class="dr-share-btn">Facebook</a>
            <a href="https://zalo.me/share" target="_blank" rel="noopener" class="dr-share-btn dr-share-btn--zalo">Zalo</a>
          </div>
        </div>

        {% comment %} Doctor Prescription / Author Bio Box {% endcomment %}
        <div class="dr-doctor-bio-box">
          <div class="dr-doctor-bio-box__avatar">
            <img src="{{ 'bs_Hue-2.jpg' | asset_url }}" alt="Bs. Nguyễn Huệ" width="72" height="72" loading="lazy">
          </div>
          <div class="dr-doctor-bio-box__info">
            <h4>Bs. Nguyễn Huệ — Chuyên Khoa Da Liễu</h4>
            <p>Trực tiếp chẩn đoán, lên phác đồ điều trị 1:1 và đồng hành cùng bệnh nhân trong suốt liệu trình phục hồi hàng rào bảo vệ da.</p>
            <a href="/pages/dat-lich" class="dr-btn dr-btn--sm dr-btn--emerald">Đặt lịch tư vấn trực tiếp ➔</a>
          </div>
        </div>

        {% comment %} Comments & Discussion (Figma Node 41:535) {% endcomment %}
        {% if blog.comments_enabled %}
          <section class="dr-comments-section" id="comments">
            <h3 class="dr-comments-section__title">Thảo Luận & Hỏi Đáp Y Khoa ({{ article.comments_count }})</h3>
            
            {% form "article_comments", article %}
              {% if comment and comment.created_on %}
                <div class="alert alert-success">
                  {% if blog.moderated %}
                    Cảm ơn bạn! Bình luận đã được gửi tới Bác sĩ và sẽ hiển thị sau khi duyệt chuyên môn.
                  {% else %}
                    Bình luận của bạn đã được đăng tải thành công.
                  {% endif %}
                </div>
              {% endif %}

              <div class="dr-comment-form">
                <div class="row">
                  <div class="col-md-6 col-12 form-group">
                    <input type="text" name="Author" required class="form-control" placeholder="Họ và tên của bạn *" value="{{ customer.name }}">
                  </div>
                  <div class="col-md-6 col-12 form-group">
                    <input type="email" name="Email" required class="form-control" placeholder="Email nhận phản hồi từ Bác sĩ *" value="{{ customer.email }}">
                  </div>
                  <div class="col-12 form-group">
                    <textarea name="Body" rows="4" required class="form-control" placeholder="Mô tả tình trạng da hoặc câu hỏi dành cho Bs. Nguyễn Huệ...">{{ form.body }}</textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="dr-btn dr-btn--emerald">Gửi Câu Hỏi Cho Bác Sĩ</button>
                  </div>
                </div>
              </div>
            {% endform %}

            {% if article.comments_count > 0 %}
              <div class="dr-comments-list">
                {% for cmt in article.comments %}
                  <div class="dr-comment-item">
                    <div class="dr-comment-item__head">
                      <strong>{{ cmt.author }}</strong>
                      <time>{{ cmt.created_on | date: 'dd/MM/yyyy' }}</time>
                    </div>
                    <div class="dr-comment-item__body">
                      {{ cmt.content }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </section>
        {% endif %}

      </article>

      {% comment %} 2.3 Right Prescription Widget Column (320px on Desktop — Figma Node 41:512) {% endcomment %}
      <aside class="col-xl-3 col-lg-3 col-12 dr-article-sidebar-col">
        <div class="dr-sticky-sidebar">
          <div class="dr-prescription-widget">
            <span class="dr-badge-emerald">🩺 ĐƠN KÊ TRONG BÀI</span>
            <h4 class="dr-prescription-widget__title">Sản Phẩm Phục Hồi Khuyên Dùng</h4>
            <p class="dr-prescription-widget__sub">Dược mỹ phẩm chính ngạch được Bs. Nguyễn Huệ chỉ định trong phác đồ trên:</p>
            
            {% comment %} Hiển thị sản phẩm liên quan từ settings hoặc mặc định {% endcomment %}
            <div class="dr-prescription-products">
              {% assign rel_col_handle = settings.relate_collection | default: 'all' %}
              {% for prod in collections[rel_col_handle].products limit: 2 %}
                <div class="dr-prescription-item">
                  <a href="{{ prod.url }}" class="dr-prescription-item__thumb">
                    <img class="lazyload" src="{{ 'lazy.png' | asset_url }}" data-src="{{ prod.featured_image.src | product_img_url: 'medium' }}" alt="{{ prod.title | escape }}" width="60" height="60">
                  </a>
                  <div class="dr-prescription-item__info">
                    <h5 class="dr-prescription-item__name">
                      <a href="{{ prod.url }}">{{ prod.title | truncate: 36 }}</a>
                    </h5>
                    <span class="dr-prescription-item__price">{{ prod.price | money }}</span>
                    <form action="/cart/add" method="post" class="dr-prescription-item__form">
                      <input type="hidden" name="variantId" value="{{ prod.variants.first.id }}">
                      <button type="submit" class="dr-btn-quick-buy">+ Thêm Đơn</button>
                    </form>
                  </div>
                </div>
              {% endfor %}
            </div>

            <div class="dr-prescription-widget__cta">
              <a href="{{ settings.social_zalo_link | default: 'https://zalo.me/' }}" target="_blank" rel="noopener" class="dr-btn dr-btn--emerald w-100">
                <span>Tư Vấn Đơn Kê Zalo 1:1</span>
              </a>
            </div>
          </div>
        </div>
      </aside>

    </div>

    {% comment %} 3. Related Clinical Articles Section (Figma Node 41:517) {% endcomment %}
    {% assign rel_blog = blog.alias | default: 'all' %}
    {% if blogs[rel_blog].articles.size > 1 %}
      <section class="dr-related-articles-section">
        <h3 class="dr-related-articles-section__title">Bài Viết Cùng Chuyên Mục Da Liễu Lâm Sàng</h3>
        <div class="row">
          {% assign count = 0 %}
          {% for r_art in blogs[rel_blog].articles %}
            {% if r_art.id != article.id and count < 3 %}
              {% assign count = count | plus: 1 %}
              <div class="col-lg-4 col-md-6 col-12">
                {% include 'blog_item', article: r_art %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

  </div>
</section>

{% if has_toc %}
  {{ 'https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.18.2/tocbot.min.js' | script_tag }}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof tocbot !== 'undefined') {
        tocbot.init({
          tocSelector: '.dola-toc',
          contentSelector: '.dr-article-content',
          headingSelector: 'h2, h3',
          hasInnerContainers: true,
          collapseDepth: 6,
          headingsOffset: 80,
          scrollSmoothOffset: -80
        });
      }
    });
  </script>
{% endif %}
