{% comment %}
  DR.REJU — Clinical Blog & Knowledge Magazine Template V2 (Production-Ready)
  Design System Parity: Canva Frame 991 & Figma Clinical Magazine Layout
  Warm Luxury: Deep Emerald #0A2E24 + Sand Gold #DFBA73 + Cream #FAF6EF
  Đã loại bỏ breadcrumb theo yêu cầu UI
{% endcomment %}

<div class="dr-blog-page layout-blog" itemscope itemtype="https://schema.org/Blog">
  <meta itemprop="name" content="{{ blog.title | default: blog.name | default: 'Tạp Chí Da Liễu DR.REJU' }}">
  <meta itemprop="description" content="{{ blog.description | default: store.description }}">

  <div class="dr-mag-container">

    <!-- ============================================================
         PHÂN KHU 1: KHỐI BÁO CHÍ ĐA CỘT (TOP MAGAZINE 3-COLUMN GRID)
         ============================================================ -->
    <section class="dr-mag-section dr-mag-top-grid">
      
      <!-- Cột 1: Tin mới nhất (Text Feed) -->
      <div class="dr-mag-col-news">
        <div class="dr-mag-heading">
          <h2 class="dr-mag-heading__title">Tin Mới Nhất</h2>
          <span class="dr-mag-heading__sub">Cập nhật 24h</span>
        </div>
        <ul class="dr-news-feed-list">
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/retinol-thanh-phan-vang">Retinol: Thành phần vàng trong chống lão hoá – Cách dùng đúng để không kích ứng</a></li>
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/vitamin-c-skincare">Vitamin C trong skincare: Phân biệt các dạng & chọn nồng độ phù hợp</a></li>
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/5-buoc-skincare-sang">5 bước xây dựng routine skincare buổi sáng chuẩn chuyên gia</a></li>
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/phuc-hoi-da-nhiem-corticoid">Phục hồi màng bảo vệ da sau peel & laser: Nguyên tắc vàng từ bác sĩ</a></li>
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/syn-ake-multi-peptide">Acid Hyaluronic đa phân tử: Cấp nước tầng sâu hay chỉ là chiêu trò?</a></li>
          <li class="dr-news-feed-item"><a href="/blogs/tin-tuc/can-bang-he-vi-sinh-da">Cân bằng hệ vi sinh da: Giải pháp kiểm soát dầu mụn dứt điểm</a></li>
        </ul>
      </div>

      <!-- Cột 2: Spotlight tâm điểm + 3 Subcards -->
      <div class="dr-mag-col-featured">
        <div class="dr-spotlight-hero-card">
          <div class="dr-spotlight-hero-thumb">
            <span class="dr-spotlight-badge">Trị Nám Laser</span>
            <a href="/blogs/tin-tuc/cap-nhat-phac-do-tri-nam-2026">
              <img src="{{ 'bstk_Hue-2.jpg' | asset_url }}" 
                   alt="Phác đồ trị nám chuẩn y khoa"
                   onerror="this.src='https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80'" />
            </a>
          </div>
          <h3 class="dr-spotlight-hero-title">
            <a href="/blogs/tin-tuc/cap-nhat-phac-do-tri-nam-2026">
              Cập Nhật Phác Đồ Trị Nám Chuẩn Y Khoa 2026: Kết Hợp Laser & Dưỡng Chất Đường Uống
            </a>
          </h3>
          <div class="dr-spotlight-hero-meta">
            <span>🩺 Cố vấn: Bs. Nguyễn Huệ</span> • <time>30/09/2026</time>
          </div>
        </div>

        <!-- 3 Horizontal Subcards (Retinol, Chống Nắng, Peptide) -->
        <div class="dr-mag-subcards-row">
          <a href="/blogs/tin-tuc/tagged/retinol" class="dr-mag-subcard">
            <span class="dr-subcard-tag dr-tag-retinol">Retinol</span>
            <p class="dr-subcard-title">Retinol 0.3%: Phác đồ phục hồi không bong tróc</p>
          </a>
          <a href="/blogs/tin-tuc/tagged/chong-nang" class="dr-mag-subcard">
            <span class="dr-subcard-tag dr-tag-sun">Chống Nắng</span>
            <p class="dr-subcard-title">Chống nắng vật lý & bảo vệ màng sinh học</p>
          </a>
          <a href="/blogs/tin-tuc/tagged/peptide" class="dr-mag-subcard">
            <span class="dr-subcard-tag dr-tag-peptide">Peptide</span>
            <p class="dr-subcard-title">Peptide sinh học trong phục hồi màng lipid</p>
          </a>
        </div>
      </div>

      <!-- Cột 3: Tin xem nhiều nhất (Trending Media List) -->
      <div class="dr-mag-col-trending">
        <div class="dr-mag-heading">
