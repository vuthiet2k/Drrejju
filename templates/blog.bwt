            <div>
              <small style="font-size:10px; font-weight:800; color:var(--dr-gold); text-transform:uppercase; letter-spacing:1px;">Audio Podcast Tập 08</small>
              <h4 class="dr-podcast-title">Phác Đồ Da Liễu Tiêu Chuẩn Quốc Tế</h4>
              <span style="font-size:11px; opacity:0.85;">Thời lượng: 18:40 • Bs. Nguyễn Huệ</span>
            </div>
            <div class="dr-podcast-wave">
              <span class="dr-wave-bar" style="height:12px; animation-delay:0.1s;"></span>
              <span class="dr-wave-bar" style="height:20px; animation-delay:0.3s;"></span>
              <span class="dr-wave-bar" style="height:14px; animation-delay:0.2s;"></span>
              <span class="dr-wave-bar" style="height:26px; animation-delay:0.5s;"></span>
              <span class="dr-wave-bar" style="height:16px; animation-delay:0.4s;"></span>
