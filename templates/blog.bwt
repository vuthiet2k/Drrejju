            </div>
          </a>
          <a href="/blogs/tin-tuc/5-buoc-skincare-sang" class="dr-trending-item">
            <div class="dr-trending-thumb">
              <img src="{{ 'bs_Hue-3.jpg' | asset_url }}" alt="Routine Skincare" onerror="this.src='https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=200&q=80'" />
