            </div>
          </div>

          <div class="dr-video-card-item">
            <div class="dr-video-thumb-box">
              <div class="text-center">
                <div class="dr-play-circle-btn">▶</div>
                <div class="dr-video-thumb-title">Chia Sẻ Bác Sĩ</div>
              </div>
            </div>
            <div class="dr-video-card-body">
