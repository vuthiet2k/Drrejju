    <!-- ============================================================
         PHÂN KHU 4: VIDEO 2X2 HUB & PODCAST WAVEFORM
         ============================================================ -->
    <section class="dr-mag-section">
      <div class="dr-mag-heading">
        <h2 class="dr-mag-heading__title">Góc Video & Audio Chuyên Sâu Từ Bác Sĩ</h2>
        <span class="dr-mag-heading__sub">Media Hub</span>
      </div>

      <div class="dr-media-split-grid">
        
        <!-- Cột trái: 4 Card Video 2x2 -->
        <div class="dr-video-2x2-col">
          
          <div class="dr-video-card-item">
