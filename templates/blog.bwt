    <!-- ============================================================
         PHÂN KHU 6: LƯỚI BÀI VIẾT MỚI NHẤT TỪ CHUYÊN GIA DA LIỄU
         ============================================================ -->
    <section class="dr-mag-section">
      <div class="dr-mag-heading">
        <h2 class="dr-mag-heading__title">BÀI VIẾT MỚI NHẤT TỪ CHUYÊN GIA DA LIỄU</h2>
        <span class="dr-mag-heading__sub">Chuyên Khoa</span>
      </div>

      <div class="dr-articles-3col-grid">
        
        <!-- Card 1 -->
        <article class="dr-article-grid-card">
          <div class="dr-grid-card-thumb">
            <img src="{{ 'bstk_Hue-1.jpg' | asset_url }}" alt="SYN-AKE Peptide" onerror="this.src='https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=400&q=80'" />
          </div>
          <h3 class="dr-grid-card-title">
