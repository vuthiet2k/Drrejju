{% layout none %}
{% assign module_product_count = collection.products_count %}
<div>
	{% if collection.products.size == 0 %}
	<p class="a-center margin-0 padding-0">Danh mục đang cập nhật</p>
	{% else%}
	<div class="row row-fix">
		{% for product in collection.products limit: 5 %}
		<div class="col-xl-20 col-lg-3 col-sm-4 col-6 col-fix">			

			{%include 'product_grid_office'%}
		</div>
		{%endfor%}


	</div>
	{%endif%}
	{% if collection.products.size > 0 %}
	<div class="text-center no-padding">
		<a class="see-more" title="Xem tất cả" href="{{collection.url}}">Xem tất cả</a>
	</div>
	{% endif %}
</div>