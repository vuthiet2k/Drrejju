{% comment %}
  DR.REJU — Template Trang Bác Sĩ Nguyễn Huệ (page.bac-si-hue.bwt)
  Brand Tokens: Emerald #0A2E24 + Gold #DFBA73 + Cream #FAF6EF
  Triết lý: "Đồng Hành Để Da Bạn Khỏe Thật, Từ Gốc — Chấm Dứt Điều Trị Da Theo Cảm Tính"
{% endcomment %}

<div class="page-bac-si-hue-wrapper" style="background-color: var(--bg-alt, #FAF6EF); color: var(--text, #17140F); font-family: var(--font-primary, 'Quicksand', sans-serif);">

  <!-- TOP ANNOUNCEMENT BAR -->
  <aside style="background-color: var(--emerald-dk, #06201a); color: var(--gold, #DFBA73); padding: 8px 16px; text-align: center; font-size: 11px; font-weight: 700; letter-spacing: 0.5px;">
    <span>✦ PHÁC ĐỒ ĐIỀU TRỊ DA CHUẨN Y KHOA — TRỰC TIẾP TƯ VẤN BỞI BÁC SĨ NGUYỄN HUỆ ✦</span>
  </aside>

  <!-- HERO SECTION -->
  <section style="padding: 60px 20px; max-width: 1280px; margin: 0 auto;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px;">
      
      <!-- Left Content -->
      <div style="flex: 1 1 600px; max-width: 680px;">
        <div style="display: inline-block; padding: 6px 14px; border-radius: 999px; background: rgba(10, 46, 36, 0.08); border: 1px solid rgba(10, 46, 36, 0.2); color: var(--emerald, #0A2E24); font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 16px;">
          ✦ Chuyên Gia Da Liễu Lâm Sàng & Dược Mỹ Phẩm
        </div>

        <h1 style="font-size: 42px; font-weight: 800; color: var(--emerald, #0A2E24); margin: 0 0 16px 0; line-height: 1.2;">
          Bác Sĩ NGUYỄN HUỆ
        </h1>

        <!-- Master Slogan Banner -->
        <div style="background: var(--emerald, #0A2E24); color: #fff; padding: 24px; border-radius: 16px; border: 1px solid rgba(223, 186, 115, 0.4); margin-bottom: 24px; box-shadow: 0 10px 25px rgba(10, 46, 36, 0.2);">
          <div style="font-size: 22px; font-weight: 800; color: var(--gold, #DFBA73); margin-bottom: 6px; letter-spacing: 0.5px;">
            "ĐỒNG HÀNH ĐỂ DA BẠN KHỎE THẬT, TỪ GỐC"
          </div>
          <div style="font-size: 13px; color: #f0f0f0; font-weight: 500;">
            ❝ Chấm dứt điều trị da theo cảm tính bằng phác đồ cá nhân hóa 1:1 ❞
          </div>
        </div>

        <p style="font-size: 14px; line-height: 1.7; color: var(--text-soft, #6E675C); margin-bottom: 28px;">
          Hơn 10 năm kinh nghiệm điều trị da liễu chuyên sâu. Phục hồi dứt điểm hơn 15.000 ca da nhiễm Corticoid, mụn viêm bọc và nám mảng bằng hoạt chất chuẩn y khoa Châu Âu.
        </p>

        <!-- CTA Buttons -->
        <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 36px;">
          <a href="#dat-lich" style="padding: 14px 28px; border-radius: 999px; background: var(--gold, #DFBA73); color: var(--emerald, #0A2E24); font-weight: 800; font-size: 13px; text-decoration: none; box-shadow: 0 4px 14px rgba(223, 186, 115, 0.4);">
            Đăng Ký Tư Vấn Cùng Bác Sĩ →
          </a>
          <a href="/page.quiz" style="padding: 14px 24px; border-radius: 999px; background: #fff; border: 2px solid var(--emerald, #0A2E24); color: var(--emerald, #0A2E24); font-weight: 700; font-size: 13px; text-decoration: none;">
            Làm Khảo Sát Hồ Sơ Da
          </a>
        </div>

        <!-- Metrics -->
        <div style="display: flex; gap: 32px; border-top: 1px solid var(--line, #E7E0D6); padding-top: 20px;">
          <div>
            <div style="font-size: 26px; font-weight: 800; color: var(--emerald, #0A2E24);">10+ Năm</div>
            <div style="font-size: 11px; color: var(--text-soft, #6E675C);">Kinh nghiệm lâm sàng</div>
          </div>
          <div>
            <div style="font-size: 26px; font-weight: 800; color: var(--emerald, #0A2E24);">15.000+</div>
            <div style="font-size: 11px; color: var(--text-soft, #6E675C);">Ca phục hồi thành công</div>
          </div>
          <div>
            <div style="font-size: 26px; font-weight: 800; color: var(--gold, #DFBA73);">100%</div>
            <div style="font-size: 11px; color: var(--text-soft, #6E675C);">Phác đồ chuẩn Y Khoa</div>
          </div>
        </div>
      </div>

      <!-- Right Doctor Frame -->
      <div style="flex: 1 1 400px; max-width: 480px;">
        <div style="background: #fff; padding: 16px; border-radius: 24px; border: 1px solid rgba(223, 186, 115, 0.5); box-shadow: 0 20px 40px rgba(0,0,0,0.08);">
          <div style="aspect-ratio: 3/4; border-radius: 16px; background: var(--bg-soft, #F1ECE3); overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center;">
            <img src="{{ 'bs_nguyen_hue_portrait.jpg' | asset_url }}" alt="Bác sĩ Nguyễn Huệ" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80'" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3 NGUYÊN TẮC ĐIỀU TRỊ -->
  <section style="background: var(--emerald, #0A2E24); color: #fff; padding: 70px 20px;">
    <div style="max-w: 1280px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 28px; font-weight: 800; color: var(--gold, #DFBA73); margin-bottom: 40px;">
        VÌ SAO CẦN "CHẤM DỨT ĐIỀU TRỊ DA THEO CẢM TÍNH"?
      </h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; text-align: left;">
        <div style="background: var(--emerald-dk, #06201a); padding: 28px; border-radius: 16px; border: 1px solid rgba(223, 186, 115, 0.3);">
          <div style="font-size: 24px; font-weight: 800; color: var(--gold, #DFBA73); margin-bottom: 10px;">01</div>
          <h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 8px;">Chẩn Đoán Đúng Tầng Tổn Thương</h3>
          <p style="font-size: 12px; color: #cbd5e1; line-height: 1.6;">Xác định rõ tổn thương ở màng Ceramide, biểu bì hay trung bì để điều trị trúng đích tận gốc.</p>
        </div>

        <div style="background: var(--emerald-dk, #06201a); padding: 28px; border-radius: 16px; border: 1px solid rgba(223, 186, 115, 0.3);">
          <div style="font-size: 24px; font-weight: 800; color: var(--gold, #DFBA73); margin-bottom: 10px;">02</div>
          <h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 8px;">Phục Hồi Trước — Treatment Sau</h3>
          <p style="font-size: 12px; color: #cbd5e1; line-height: 1.6;">Tuyệt đối không tấn công hoạt chất mạnh trên nền da yếu. Hàng rào khỏe mạnh là gốc của làn da đẹp.</p>
        </div>

        <div style="background: var(--emerald-dk, #06201a); padding: 28px; border-radius: 16px; border: 1px solid rgba(223, 186, 115, 0.3);">
          <div style="font-size: 24px; font-weight: 800; color: var(--gold, #DFBA73); margin-bottom: 10px;">03</div>
          <h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 8px;">Đồng Hành 1:1 Theo Chu Kỳ 14-28 Ngày</h3>
          <p style="font-size: 12px; color: #cbd5e1; line-height: 1.6;">Theo dõi sát sao phản ứng sinh học của da và tinh chỉnh liều lượng dược mỹ phẩm theo từng chu kỳ.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM ĐẶT HẸN TƯ VẤN 1:1 -->
  <section id="dat-lich" style="padding: 70px 20px; max-width: 800px; margin: 0 auto;">
    <div style="background: #fff; padding: 40px; border-radius: 24px; border: 1px solid rgba(223, 186, 115, 0.5); box-shadow: 0 15px 35px rgba(0,0,0,0.06);">
      <h2 style="font-size: 22px; font-weight: 800; color: var(--emerald, #0A2E24); text-align: center; margin-bottom: 8px;">
        ĐĂNG KÝ TƯ VẤN TRỰC TIẾP CÙNG BS. NGUYỄN HUỆ
      </h2>
      <p style="text-align: center; font-size: 12px; color: var(--text-soft, #6E675C); margin-bottom: 30px;">
        Bác sĩ sẽ liên hệ thăm khám và gửi phác đồ phục hồi da chi tiết cho bạn trong vòng 24h
      </p>

      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div style="background: #ecfdf5; border: 1px solid #059669; color: #047857; padding: 14px; border-radius: 12px; font-size: 13px; font-weight: 700; margin-bottom: 20px; text-align: center;">
            ✓ Đã gửi yêu cầu tư vấn thành công! Bác sĩ Nguyễn Huệ sẽ liên hệ bạn sớm nhất.
          </div>
        {% endif %}

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--emerald, #0A2E24); margin-bottom: 6px;">Họ và Tên của bạn *</label>
          <input type="text" required name="contact[name]" placeholder="Ví dụ: Nguyễn Thị Thuỳ Linh" style="width: 100%; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--line, #E7E0D6); background: var(--bg-alt, #FAF6EF); font-size: 13px;" />
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--emerald, #0A2E24); margin-bottom: 6px;">Số Điện Thoại (Zalo nhận phác đồ) *</label>
          <input type="tel" required name="contact[phone]" placeholder="Ví dụ: 0967 194 063" style="width: 100%; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--line, #E7E0D6); background: var(--bg-alt, #FAF6EF); font-size: 13px; font-family: monospace;" />
        </div>

        <div style="margin-bottom: 24px;">
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--emerald, #0A2E24); margin-bottom: 6px;">Tình trạng da bạn đang gặp phải *</label>
          <textarea rows="3" name="contact[body]" placeholder="Mô tả tình trạng: Da nhiễm Corticoid, Mụn viêm, Nám mảng, da mỏng đỏ..." style="width: 100%; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--line, #E7E0D6); background: var(--bg-alt, #FAF6EF); font-size: 13px;"></textarea>
        </div>

        <button type="submit" style="width: 100%; padding: 16px; border-radius: 999px; background: var(--gold, #DFBA73); color: var(--emerald, #0A2E24); font-weight: 800; font-size: 14px; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(223, 186, 115, 0.4);">
          GỬI YÊU CẦU TƯ VẤN CHO BÁC SĨ NGUYỄN HUỆ →
        </button>
      {% endform %}
    </div>
  </section>

</div>
