{% include 'breadcrumb' %} 
<h1 class="title-head-contact a-left d-none">{{ page_title }}</h1>
<div class="layout-contact">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 col-12">
				<div class="contact">
					<h4>
						{{settings.title_contact_1}}
						
					</h4>
					<div class="info-contact">
						
						<div class="group-address">
							<ul>
								<li>
									<div class="icon">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><!--! Font Awesome Pro 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><path d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 256c-35.3 0-64-28.7-64-64s28.7-64 64-64s64 28.7 64 64s-28.7 64-64 64z"/></svg>
									</div>
									<div class="info">
										<b>Địa chỉ</b>
										<span>
											{%if settings.diachi == "" or settings.diachi == null%}
											{%if store.address!='' %}{{ store.address }}, {%endif%}{%if store.province!='' %}{{store.province}}, {%endif%}{%if store.district!='' %}{{store.district}}, {%endif%}{%if store.country!='' %}{{store.country}}{%endif%}{%if store.zip!='' %} - Zipcode: {{store.zip}}{%endif%}
											{%else%}
											{{ settings.diachi}}
											{%endif%}
										</span>
									</div>
									
								</li>
								<li>
									<div class="icon">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Pro 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><path d="M256 512C114.6 512 0 397.4 0 256S114.6 0 256 0S512 114.6 512 256s-114.6 256-256 256zM232 120V256c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2V120c0-13.3-10.7-24-24-24s-24 10.7-24 24z"/></svg>
									</div>
									<div class="info">
										<b>Thời gian làm việc</b>
										<span>
											{{ settings.time}}
										</span>
									</div>

								</li>
								<li>
									<div class="icon">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Pro 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><path d="M280 0C408.1 0 512 103.9 512 232c0 13.3-10.7 24-24 24s-24-10.7-24-24c0-101.6-82.4-184-184-184c-13.3 0-24-10.7-24-24s10.7-24 24-24zm8 192a32 32 0 1 1 0 64 32 32 0 1 1 0-64zm-32-72c0-13.3 10.7-24 24-24c75.1 0 136 60.9 136 136c0 13.3-10.7 24-24 24s-24-10.7-24-24c0-48.6-39.4-88-88-88c-13.3 0-24-10.7-24-24zM117.5 1.4c19.4-5.3 39.7 4.6 47.4 23.2l40 96c6.8 16.3 2.1 35.2-11.6 46.3L144 207.3c33.3 70.4 90.3 127.4 160.7 160.7L345 318.7c11.2-13.7 30-18.4 46.3-11.6l96 40c18.6 7.7 28.5 28 23.2 47.4l-24 88C481.8 499.9 466 512 448 512C200.6 512 0 311.4 0 64C0 46 12.1 30.2 29.5 25.4l88-24z"></path></svg>
									</div>
									<div class="info">
										<b>Hotline</b>
										<a title="{{ settings.phone | default: store.phone_number}}" href="tel:{{ settings.phone | default: store.phone_number | remove: ' '}}">{{ settings.phone | default: store.phone_number}}</a>
									</div>
								</li>
								<li>
									<div class="icon">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Pro 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"></path></svg>
									</div>
									<div class="info">
										<b>Email</b>
										<a  title="{{ settings.email | default: store.email}}" href="mailto:{{ settings.email | default: store.email}}">{{ settings.email | default: store.email}}</a>
									</div>
								</li>

							</ul>
						</div>
					</div>
				</div>
				<div class="form-contact">
					<h4>
						{{settings.title_contact_2}}

					</h4>
					<span class="content-form">
						Nếu bạn có thắc mắc gì, có thể gửi yêu cầu cho chúng tôi, và chúng tôi sẽ liên lạc lại với bạn sớm nhất có thể .
					</span>
					<div id="pagelogin">
						{% form 'contact' %}
						{% if form.errors.size > 0 %}
						{% for field in form.errors %}
						<p style="color:red;">{{ form.errors.messages[field] }}<p/>
						{% endfor %}
						{% endif %}
						{% if form.posted_successfully %}
						<p style="    background: #83c54e;    color: #fff;    padding: 5px 10px;    border-radius: 6px;">Bạn đã gửi tin nhắn thành công</p>
						{% endif %}
						<div class="group_contact">
							<input placeholder="Họ và tên" type="text" class="form-control  form-control-lg" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.first_name }} {{ customer.last_name }}{% endif %}" name="contact[Name]">
							<input placeholder="Email" type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$" required id="email1" class="form-control form-control-lg" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" name="contact[email]">
							<input type="number" placeholder="Điện thoại*" name="contact[phone]"  class="form-control form-control-lg" required>
							<textarea placeholder="Nội dung" name="contact[body]" id="comment" class="form-control content-area form-control-lg" rows="5" Required></textarea>
							<button type="submit" class="btn-lienhe">Gửi thông tin</button>
						</div>
						{% endform %}
					</div>
				</div>
			</div>
			<div class="col-lg-6 col-12">
				<div id="contact_map" class="map">
					{{ settings.contactr_contact_maps }}
				</div>
			</div>
		</div>
	</div>
</div>