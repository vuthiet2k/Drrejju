{% layout none %}
<div class="category-products">

	{%include 'collection-sortby'%}

	
	{% paginate search.results by settings.collection_number_product %}	
	{% if search.results.size > 0 %}
	<section class="products-view products-view-grid list_hover_pro">
		<div class="row row-fix">
			{% for product in search.results %}
			<div class="col-6 col-md-4 col-xl-3 col-fix">
				<div class="item_product_main">
					{%include 'product_grid_office'%}	
				</div>
			</div>
			{% endfor %}
		</div>
	</section>
	{% else %}
	<div style="margin-top: 20px" class="alert alert-warning alert-warning2 alert-dismissible margin-top-15 section" role="alert">
		Không có sản phẩm nào trong danh mục này.
	</div>
	{% endif %}
	{% if paginate.pages > 1 %}
	<div class="section pagenav clearfix a-center">
		{% if paginate.pages > 1 %}
		{% include 'collection-paginate-pages' %}
		{% endif %}
	</div>
	{%endif%}
	{% endpaginate %}
</div>